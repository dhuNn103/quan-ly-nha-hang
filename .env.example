# Cấu hình máy chủ Nhà Hàng
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Mật khẩu quản trị viên mặc định (khởi tạo lần đầu)
ADMIN_PASSWORD=Admin@123

# Tệp lưu trữ dữ liệu
DATA_FILE=data.json

# Cấu hình sao lưu tự động
BACKUP_ENABLED=true
BACKUP_INTERVAL_MIN=60
MAX_BACKUPS=24

# Giới hạn kích thước tải lên (MB)
MAX_BODY_SIZE_MB=25

# Thời gian phiên đăng nhập nhân viên (giờ)
SESSION_TTL_HOURS=24

# Cấu hình CORS
CORS_ORIGIN=*
