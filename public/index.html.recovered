          <img src="https://images.unsplash.com/photo-1577219491135-ce391730fb2c?w=900&auto=format&fit=crop&q=80" alt="Đội ngũ đầu bếp ${esc(restNameDisplay)}" class="hp-aboutpage-chef-img">
        </div>
      </div>
    </section>

    <!-- Stats counter strip (4 Layout riêng & Bộ đếm số chạy từ 0) -->
    <section class="hp-aboutpage-stats-sec">
      <div class="hp-aboutpage-stats-inner">
