        <div class="hp-ed-field" style="margin-bottom:14px">
          <label>Ảnh nền banner trang Thực đơn (Menu Hero Background)</label>
          <div class="hp-img-upload-row">
            <img id="hp_ed_menu_hero_bg_prv" src="${esc(c.hpMenuHeroBg || 'https://images.unsplash.com/photo-1555396273-367ea4eb4db5?w=1600&auto=format&fit=crop&q=80')}" class="hp-img-thumb-preview" alt="Xem trước">
            <input id="hp_ed_menu_hero_bg" value="${esc(c.hpMenuHeroBg || 'https://images.unsplash.com/photo-1555396273-367ea4eb4db5?w=1600&auto=format&fit=crop&q=80')}" oninput="$('#hp_ed_menu_hero_bg_prv').src=this.value" placeholder="Nhập URL ảnh nền hoặc chọn từ máy">
            <button type="button" class="p" onclick="$('#hp_ed_menu_hero_bg_f').click()" style="white-space:nowrap"><i class="fa-solid fa-upload"></i> Chọn ảnh</button>
            <input id="hp_ed_menu_hero_bg_f" type="file" accept="image/*" style="display:none" onchange="hpPickLocalImg(this, 'hp_ed_menu_hero_bg', 'hp_ed_menu_hero_bg_prv')">
          </div>
        </div>

        <div style="display:flex;flex-direction:column;gap:14px">
          ${dishes.map((d, i) => `
            <div style="background:#fff;border:1px solid #ebd9c2;border-radius:10px;padding:14px">
              <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;flex-wrap:wrap;gap:8px">
                <b style="font-size:13.5px;color:#b8863b">Món nổi bật ${i + 1}</b>
                <select style="max-width:280px;font-size:12px;padding:4px 8px" onchange="hpPickMenuDish(this.value, ${i})">
                  <option value="">-- Chọn nhanh từ Menu nhà hàng --</option>
                  ${(S.menu || []).map(m => `<option value="${m.id}">${esc(m.name)} - ${money(m.price)}</option>`).join('')}
                </select>
              </div>
              <div class="hp-ed-grid-2">
                <div class="hp-ed-field">
                  <label>Tên món</label>
                  <input id="hp_ed_d_name_${i}" value="${esc(d.name)}" placeholder="VD: Phở Bò">
                </div>
                <div class="hp-ed-field">
                  <label>Giá hiển thị</label>
                  <input id="hp_ed_d_price_${i}" value="${esc(d.price)}" placeholder="VD: 89.000đ">
                </div>
              </div>
              <div class="hp-ed-grid-2" style="margin-bottom:10px">
                <div class="hp-ed-field">
                  <label>Số sao đánh giá (1-5)</label>
                  <input id="hp_ed_d_rate_${i}" value="${esc(d.rating || '4.8')}" placeholder="4.8">
                </div>
                <div class="hp-ed-field">
                  <label>Lượt đánh giá</label>
                  <input id="hp_ed_d_rev_${i}" value="${esc(d.reviews || '1.2k đánh giá')}" placeholder="1.2k đánh giá">
                </div>
              </div>
              <div class="hp-ed-field">
                <label>Hình ảnh món ăn</label>
                <div class="hp-img-upload-row">
                  <img id="hp_ed_d_prv_${i}" src="${esc(d.img)}" class="hp-img-thumb-preview" alt="Xem trước">
                  <input id="hp_ed_d_img_${i}" value="${esc(d.img)}" oninput="$('#hp_ed_d_prv_${i}').src=this.value" placeholder="URL hình ảnh món">
                  <button type="button" class="p" onclick="$('#hp_ed_d_f_${i}').click()" style="white-space:nowrap"><i class="fa-solid fa-upload"></i> Chọn ảnh</button>
                  <input id="hp_ed_d_f_${i}" type="file" accept="image/*" style="display:none" onchange="hpPickLocalImg(this, 'hp_ed_d_img_${i}', 'hp_ed_d_prv_${i}')">
                </div>
              </div>
            </div>
          `).join('')}
        </div>
      </div>
    `;
  }

  if (tab === 'booking') {
    return `
      <div class="hp-ed-card">
        <div class="hp-ed-card-head"><i class="fa-solid fa-calendar-check" style="color:#b8863b"></i> Khu vực Đặt bàn (Reservation Banner)</div>
        <div class="hp-ed-grid-2">
          <div class="hp-ed-field">
            <label>Huy hiệu</label>
            <input id="hp_ed_bk_badge" value="${esc(c.hpBookingBadge || 'ĐẶT BÀN NGAY')}">
          </div>
          <div class="hp-ed-field">
            <label>Chữ trên nút đặt bàn</label>
            <input id="hp_ed_bk_btn" value="${esc(c.hpBookingBtnText || 'Đặt bàn ngay')}">
          </div>
        </div>
        <div class="hp-ed-field" style="margin-bottom:12px">
          <label>Tiêu đề đặt bàn</label>
          <input id="hp_ed_bk_title" value="${esc((c.hpBookingTitle || 'Đặt bàn dễ dàng, thưởng thức trọn vẹn').replace(/\n/g, ' - '))}">
        </div>
        <div class="hp-ed-field" style="margin-bottom:12px">
          <label>Mô tả hướng dẫn đặt bàn</label>
          <textarea id="hp_ed_bk_desc" rows="3">${esc(c.hpBookingDesc || 'Chọn thời gian, số lượng khách và để chúng tôi chuẩn bị một trải nghiệm tuyệt vời nhất cho bạn.')}</textarea>
        </div>
        <div class="hp-ed-field">
          <label>Hình ảnh bàn tiệc (Bên phải khung đặt bàn)</label>
          <div class="hp-img-upload-row">
            <img id="hp_ed_bk_prv" src="${esc(c.hpBookingImg || 'https://images.unsplash.com/photo-1578474846511-04ba529f0b88?w=800&auto=format&fit=crop&q=80')}" class="hp-img-thumb-preview" alt="Xem trước">
            <input id="hp_ed_bk_img" value="${esc(c.hpBookingImg || 'https://images.unsplash.com/photo-1578474846511-04ba529f0b88?w=800&auto=format&fit=crop&q=80')}" oninput="$('#hp_ed_bk_prv').src=this.value" placeholder="URL hình ảnh">
            <button type="button" class="p" onclick="$('#hp_ed_bk_f').click()" style="white-space:nowrap"><i class="fa-solid fa-upload"></i> Chọn ảnh</button>
            <input id="hp_ed_bk_f" type="file" accept="image/*" style="display:none" onchange="hpPickLocalImg(this, 'hp_ed_bk_img', 'hp_ed_bk_prv')">
          </div>
        </div>
      </div>
    `;
  }

  if (tab === 'social') {
    return `
      <div class="hp-ed-card">
        <div class="hp-ed-card-head"><i class="fa-solid fa-share-nodes" style="color:#b8863b"></i> Liên kết mạng xã hội & Nội dung chân trang (Footer)</div>
        <div class="hp-ed-grid-2">
          <div class="hp-ed-field">
            <label><i class="fa-brands fa-facebook" style="color:#1877f2"></i> Link Facebook</label>
            <input id="hp_ed_soc_fb" value="${esc(c.socialFb || '')}" placeholder="https://facebook.com/nhahang">
          </div>
          <div class="hp-ed-field">
            <label><svg viewBox="0 0 24 24" style="width:14px;height:14px;fill:#0068ff;display:inline-block;vertical-align:-2px;margin-right:4px" xmlns="http://www.w3.org/2000/svg"><path d="M12.49 10.272v-.45h1.347v6.322h-.77a.576.576 0 0 1-.577-.573v.001a3.27 3.27 0 0 1-1.938.632a3.284 3.284 0 0 1-3.284-3.282a3.284 3.284 0 0 1 3.284-3.282a3.27 3.27 0 0 1 1.937.632zM6.919 7.79v.205c0 .382-.051.694-.3 1.06l-.03.034a8 8 0 0 0-.242.285L2.024 14.8h4.895v.768a.576.576 0 0 1-.577.576H0v-.362c0-.443.11-.641.25-.847L4.858 9.23H.192V7.79zm8.551 8.354a.48.48 0 0 1-.48-.48V7.79h1.441v8.354zM20.693 9.6a3.306 3.306 0 1 1 .002 6.612a3.306 3.306 0 0 1-.002-6.612m-10.14 5.253a1.932 1.932 0 1 0 0-3.863a1.932 1.932 0 0 0 0 3.863m10.14-.003a1.945 1.945 0 1 0 0-3.89a1.945 1.945 0 0 0 0 3.89"/></svg> Link / Số Zalo</label>
            <input id="hp_ed_soc_zalo" value="${esc(c.socialZalo || '')}" placeholder="https://zalo.me/0123456789">
          </div>
        </div>
        <div class="hp-ed-grid-2">
          <div class="hp-ed-field">
            <label><i class="fa-brands fa-youtube" style="color:#ff0000"></i> Link YouTube</label>
            <input id="hp_ed_soc_yt" value="${esc(c.socialYoutube || '')}" placeholder="https://youtube.com/@nhahang">
          </div>
          <div class="hp-ed-field">
            <label><i class="fa-brands fa-tiktok"></i> Link TikTok</label>
            <input id="hp_ed_soc_tt" value="${esc(c.socialTiktok || '')}" placeholder="https://tiktok.com/@nhahang">
          </div>
        </div>
        <div class="hp-ed-field" style="margin-top:10px">
          <label>Lời giới thiệu ngắn chân trang (Footer Bio)</label>
          <textarea id="hp_ed_footerBio" rows="2" placeholder="Mang đến những món ăn ngon và trải nghiệm tuyệt vời nhất cho bạn...">${esc(c.hpFooterBio || 'Mang đến những món ăn ngon và trải nghiệm tuyệt vời nhất cho bạn.')}</textarea>
        </div>
        <div class="hp-ed-field" style="margin-top:10px">
          <label>Dòng chữ bản quyền chân trang</label>
          <input id="hp_ed_copyright" value="${esc(c.hpCopyright || ('© 2025 ' + (c.name || 'Hương Vị Việt') + '. All rights reserved.'))}">
        </div>
      </div>
    `;
  }

  return '';
}

function saveHpEditor() {
  const v = id => {
    const el = document.getElementById(id);
    return el ? el.value.trim() : null;
  };

  // General (Homepage specific)
  if (v('hp_ed_slogan') !== null) S.cfg.slogan = v('hp_ed_slogan') || 'Tinh Hoa Ẩm Thực Việt';
  if (v('hp_ed_footerBio') !== null) S.cfg.hpFooterBio = v('hp_ed_footerBio');

  // Features
  const newFeats = [];
  for (let i = 0; i < 4; i++) {
    const t = v('hp_ed_feat_t_' + i);
    const d = v('hp_ed_feat_d_' + i);
    if (t !== null && d !== null) {
      newFeats.push({ title: t, desc: d });
    }
  }
  if (newFeats.length === 4) S.cfg.hpFeatures = newFeats;

  // About
  if (v('hp_ed_about_badge') !== null) S.cfg.hpAboutBadge = v('hp_ed_about_badge');
  if (v('hp_ed_about_btn') !== null) S.cfg.hpAboutBtnText = v('hp_ed_about_btn');
  if (v('hp_ed_about_title') !== null) S.cfg.hpAboutTitle = v('hp_ed_about_title');
  if (v('hp_ed_about_desc') !== null) {
    const d = v('hp_ed_about_desc');
    S.cfg.desc = d;
    S.cfg.heroDesc = d;
    S.cfg.storyDesc = d;
  }
  if (v('hp_ed_about_img') !== null) S.cfg.hpAboutImg = v('hp_ed_about_img');
  if (v('hp_ed_about_hero_bg') !== null) S.cfg.hpAboutHeroBg = v('hp_ed_about_hero_bg');

  // Services
  if (v('hp_ed_serv_sub') !== null) S.cfg.hpServicesSub = v('hp_ed_serv_sub');
  if (v('hp_ed_serv_title') !== null) S.cfg.hpServicesTitle = v('hp_ed_serv_title');
  const newServs = [];
  const curServs = getHpServices(true);
  for (let i = 0; i < 4; i++) {
    const t = v('hp_ed_s_title_' + i);
    const d = v('hp_ed_s_desc_' + i);
    const b = v('hp_ed_s_btn_' + i);
    const img = v('hp_ed_s_img_' + i);
    if (t !== null && d !== null) {
      newServs.push({
        title: t,
        desc: d,
        linkText: b || curServs[i].linkText,
        link: curServs[i].link,
        icon: curServs[i].icon,
        img: img || curServs[i].img
      });
    }
  }
  if (newServs.length === 4) S.cfg.hpServices = newServs;

  // Dishes
  if (v('hp_ed_dish_badge') !== null) S.cfg.hpDishesBadge = v('hp_ed_dish_badge');
  if (v('hp_ed_dish_title') !== null) S.cfg.hpDishesTitle = v('hp_ed_dish_title');
  if (v('hp_ed_menu_hero_bg') !== null) S.cfg.hpMenuHeroBg = v('hp_ed_menu_hero_bg');
  const newDishes = [];
  const curDishes = getHpDishes(true);
  for (let i = 0; i < 4; i++) {
    const n = v('hp_ed_d_name_' + i);
    const p = v('hp_ed_d_price_' + i);
    const r = v('hp_ed_d_rate_' + i);
    const rev = v('hp_ed_d_rev_' + i);
    const img = v('hp_ed_d_img_' + i);
    if (n !== null && p !== null) {
      newDishes.push({
        name: n,
        price: p,
        rating: r || '4.8',
        reviews: rev || '1k đánh giá',
        img: img || curDishes[i].img
      });
    }
  }
  if (newDishes.length === 4) S.cfg.hpDishes = newDishes;

  // Booking
  if (v('hp_ed_bk_badge') !== null) S.cfg.hpBookingBadge = v('hp_ed_bk_badge');
  if (v('hp_ed_bk_btn') !== null) S.cfg.hpBookingBtnText = v('hp_ed_bk_btn');
  if (v('hp_ed_bk_title') !== null) S.cfg.hpBookingTitle = v('hp_ed_bk_title');
  if (v('hp_ed_bk_desc') !== null) S.cfg.hpBookingDesc = v('hp_ed_bk_desc');
  if (v('hp_ed_bk_img') !== null) S.cfg.hpBookingImg = v('hp_ed_bk_img');

  // Social
  if (v('hp_ed_soc_fb') !== null) S.cfg.socialFb = v('hp_ed_soc_fb');
  if (v('hp_ed_soc_zalo') !== null) S.cfg.socialZalo = v('hp_ed_soc_zalo');
  if (v('hp_ed_soc_yt') !== null) S.cfg.socialYoutube = v('hp_ed_soc_yt');
  if (v('hp_ed_soc_tt') !== null) S.cfg.socialTiktok = v('hp_ed_soc_tt');
  if (v('hp_ed_copyright') !== null) S.cfg.hpCopyright = v('hp_ed_copyright');

  save();
  hpEditorOpen = false;
  const modal = document.getElementById('hp-editor-modal');
  if (modal) modal.classList.remove('on');
  render();
  toast('Đã lưu và cập nhật toàn bộ thông tin Trang chủ thành công!', 'ok');
}

function resetHpCfg() {
  if (!confirm('Khôi phục toàn bộ nội dung Trang chủ về mẫu thiết kế chuẩn ban đầu?')) return;
  delete S.cfg.hpFeatures;
  delete S.cfg.hpServices;
  delete S.cfg.hpDishes;
  delete S.cfg.hpAboutBadge;
  delete S.cfg.hpAboutTitle;
  delete S.cfg.hpAboutImg;
  delete S.cfg.hpAboutBtnText;
  delete S.cfg.hpServicesSub;
  delete S.cfg.hpServicesTitle;
  delete S.cfg.hpDishesBadge;
  delete S.cfg.hpDishesTitle;
  delete S.cfg.hpBookingBadge;
  delete S.cfg.hpBookingTitle;
  delete S.cfg.hpBookingDesc;
  delete S.cfg.hpBookingImg;
  delete S.cfg.hpBookingBtnText;
  delete S.cfg.hpFooterBio;
  delete S.cfg.hpCopyright;
  save();
  hpEditorOpen = false;
  const m = document.getElementById('hp-editor-modal');
  if (m) m.classList.remove('on');
  render();
  toast('Đã khôi phục nội dung trang chủ về mặc định.', 'ok');
}

function openHpEditModal(){
  page = 'set';
  render();
}

function isRestOpenNow(){
  try{
    const now = new Date();
    const cur = now.getHours() * 60 + now.getMinutes();
    const [oh, om] = (S.cfg.open || '08:00').split(':').map(Number);
    const [ch, cm] = (S.cfg.close || '23:00').split(':').map(Number);
    const oMin = (oh || 8) * 60 + (om || 0);
    const cMin = (ch || 23) * 60 + (cm || 0);
    return cur >= oMin && cur <= cMin;
  }catch(e){
    return true;
  }
}

function openLoginModal(){
  loginModalOpen = true;
  hpNavOpen = false;
  document.body.classList.remove('hp-menu-opened');
  render();
  setTimeout(()=>{
    const u = document.getElementById('u');
    if (u) u.focus();
  }, 100);
}

function closeLoginModal(){
  loginModalOpen = false;
  if (location.hash === '#login'){
    try{ history.replaceState(null, '', location.pathname + location.search); }catch(e){}
  }
  render();
}

function hpOpenAdminLogin(e){
  if (e) {
    if (e.preventDefault) e.preventDefault();
    if (e.stopPropagation) e.stopPropagation();
  }
  if (window.me) {
    page = 'pos';
    render();
  } else {
    openLoginModal();
  }
}

function hpSetCat(c){
  hpCat = c;
  const list = document.getElementById('hp-menu-list');
  const tabs = document.getElementById('hp-cat-tabs');
  if (list && tabs){
    tabs.querySelectorAll('.hp-tab-btn').forEach(b => {
      b.classList.toggle('active', b.dataset.cat === c);
    });
    list.innerHTML = hpRenderDishes();
  } else {
    render();
  }
}

function hpRenderDishes(){
  const av = (S.menu || []).filter(m => m.st !== 'hide');
  const filtered = hpCat === 'all' ? av : av.filter(m => m.cat === hpCat);
  if (!filtered.length){
    return `<div class="hp-empty-menu"><i class="fa-solid fa-utensils"></i><p>${hpLang === 'en' ? 'No dishes available in this category yet.' : 'Hiện chưa có món ăn trong danh mục này.'}</p></div>`;
  }
  const hotList = S.hot || [];
  return filtered.map((m, idx) => {
    const isHot = hotList.includes(m.id) || idx < 3;
    const catIcons = {
      'Món chính': 'fa-bowl-rice',
      'Khai vị': 'fa-plate-wheat',
      'Đồ uống': 'fa-mug-hot',
      'Tráng miệng': 'fa-ice-cream'
    };
    const icon = catIcons[m.cat] || 'fa-utensils';
    const isOut = m.st === 'out';
    return `<div class="hp-dish-card ${isOut ? 'out' : ''}">
      <div class="hp-dish-media">
        ${m.img ? `<img src="${m.img}" alt="${esc(m.name)}" class="hp-dish-img">` : `<div class="hp-dish-fallback"><i class="fa-solid ${icon}"></i></div>`}
        <div class="hp-dish-badges">
          ${isHot ? `<span class="hp-dish-tag hot"><i class="fa-solid fa-fire"></i> ${hpLang === 'en' ? 'Featured' : 'Món nổi bật'}</span>` : ''}
          ${isOut ? `<span class="hp-dish-tag out">${hpLang === 'en' ? 'Sold Out' : 'Tạm hết'}</span>` : ''}
        </div>
      </div>
      <div class="hp-dish-body">
        <div class="hp-dish-meta"><span class="hp-dish-cat">${esc(hpTranslateCat(m.cat))}</span><span class="hp-dish-area">${esc(m.area || (hpLang === 'en' ? 'Kitchen' : 'Bếp'))}</span></div>
        <h4 class="hp-dish-name">${esc(m.name)}</h4>
        <div class="hp-dish-foot">
          <div class="hp-dish-price">${money(m.price)}</div>
          <button type="button" class="hp-dish-btn" onclick="alert('${hpLang === 'en' ? 'Please scan the table QR code to order directly or inform our staff!' : 'Quý khách vui lòng quét mã QR tại bàn để gọi món trực tiếp vào bếp hoặc thông báo cho nhân viên phục vụ!' }')" title="${hpLang === 'en' ? 'Order guide' : 'Hướng dẫn gọi món'}"><i class="fa-solid fa-qrcode"></i> ${hpLang === 'en' ? 'Order' : 'Gọi món'}</button>
        </div>
      </div>
    </div>`;
  }).join('');
}

/* ===== Chính sách đặt cọc theo quy tắc đặt bàn ===== */
function hpGetDepositPolicy(guests, space = 'Bàn chung', date = '', isHoliday = false) {
  guests = parseInt(guests, 10) || 2;
  space = String(space || 'Bàn chung');
  date = String(date || '');

  // Kiểm tra Lễ Tết qua cờ, ngày hoặc từ khóa
  if (!isHoliday && date) {
    const md = date.slice(5);
    const holidays = ['01-01', '02-14', '03-08', '04-30', '05-01', '09-02', '09-03', '10-20', '12-24', '12-25', '12-31'];
    if (holidays.includes(md)) isHoliday = true;
  }

  const isEvent = /tiệc|sự kiện|event|liên hoan|sinh nhật/i.test(space);
  const isVip = /vip|phòng riêng/i.test(space);

  // 1. Đặt tiệc, sự kiện: Nên yêu cầu cọc
  if (isEvent) {
    return {
      level: 'required',
      badge: 'Nên yêu cầu cọc',
      label: 'Nên yêu cầu cọc',
      badgeClass: 'red',
      icon: 'fa-champagne-glasses',
      title: 'Đặt tiệc & sự kiện',
      desc: 'Cần chuẩn bị không gian tiệc riêng, trang trí và lên thực đơn bàn tiệc chu đáo.',
      amountFixed: '1.000.000đ – 3.000.000đ',
      amountPercent: '30% – 50% giá trị dự kiến',
      suggested: 1000000,
      note: 'Nhà hàng sẽ gửi thực đơn tiệc và thông báo rõ số tiền cọc trước khi xác nhận giữ chỗ.'
    };
  }

  // 2. Dịp Lễ, Tết: Nên yêu cầu cọc
  if (isHoliday) {
    return {
      level: 'required',
      badge: 'Nên yêu cầu cọc',
      label: 'Nên yêu cầu cọc',
      badgeClass: 'red',
      icon: 'fa-gift',
      title: 'Dịp Lễ, Tết cao điểm',
      desc: 'Ngày cao điểm lễ tết, nhà hàng cần giữ chỗ ưu tiên để đảm bảo có bàn đón tiếp Quý khách.',
      amountFixed: '500.000đ – 1.000.000đ',
      amountPercent: '20% – 30% giá trị dự kiến',
      suggested: 500000,
      note: 'Nhân viên sẽ liên hệ thông báo rõ mức tiền cọc cần chuyển trước khi chốt bàn.'
    };
  }

  // 3. Trên 15 khách: Nên yêu cầu cọc
  if (guests > 15) {
    return {
      level: 'required',
      badge: 'Nên yêu cầu cọc',
      label: 'Nên yêu cầu cọc',
      badgeClass: 'red',
      icon: 'fa-users-rectangle',
      title: `Đoàn đông (${guests} khách)`,
      desc: 'Đoàn từ trên 15 khách cần sắp xếp dãy bàn dài và nhân sự phục vụ riêng chu đáo.',
      amountFixed: '1.000.000đ – 2.000.000đ',
      amountPercent: '30% giá trị dự kiến',
      suggested: 1000000,
      note: 'Mức cọc là khoản cố định từ 1.000.000đ hoặc 30% dự kiến. Nhân viên sẽ thông báo rõ trước khi xác nhận.'
    };
  }

  // 4. Phòng VIP riêng: Có thể yêu cầu cọc
  if (isVip) {
    return {
      level: 'recommended',
      badge: 'Có thể yêu cầu cọc',
      label: 'Có thể yêu cầu cọc',
      badgeClass: 'orange',
      icon: 'fa-crown',
      title: 'Phòng VIP riêng tư',
      desc: 'Không gian riêng tư, sang trọng. Nhà hàng có thể yêu cầu cọc để giữ phòng.',
      amountFixed: '500.000đ',
      amountPercent: '20% giá trị dự kiến',
      suggested: 500000,
      note: 'Mức cọc cố định 500.000đ hoặc 20% dự tính. Nhân viên sẽ thông báo rõ trước khi xác nhận đặt phòng.'
    };
  }

  // 5. 9 - 15 khách: Có thể yêu cầu cọc
  if (guests >= 9 && guests <= 15) {
    return {
      level: 'recommended',
      badge: 'Có thể yêu cầu cọc',
      label: 'Có thể yêu cầu cọc',
      badgeClass: 'orange',
      icon: 'fa-users',
      title: `Nhóm 9 – 15 khách (${guests} người)`,
      desc: 'Nhóm đông cần giữ khu vực bàn liền kề và chuẩn bị chỗ ngồi chu đáo.',
      amountFixed: '300.000đ – 500.000đ',
      amountPercent: '20% giá trị dự kiến',
      suggested: 300000,
      note: 'Có thể yêu cầu cọc 300.000đ - 500.000đ hoặc 20% dự kiến. Nhân viên sẽ thông báo rõ trước khi chốt đơn.'
    };
  }

  // 6. 5 - 8 khách: Không cần cọc hoặc tùy thời điểm
  if (guests >= 5 && guests <= 8) {
    return {
      level: 'flexible',
      badge: 'Không cần cọc hoặc tùy thời điểm',
      label: 'Không cần cọc hoặc tùy thời điểm',
      badgeClass: 'yellow',
      icon: 'fa-user-group',
      title: `Nhóm 5 – 8 khách (${guests} người)`,
      desc: 'Ngày thường không cần cọc. Khung giờ cao điểm cuối tuần có thể linh hoạt yêu cầu cọc nhẹ.',
      amountFixed: '0đ (hoặc 200.000đ giờ cao điểm)',
      amountPercent: '10% – 15% (chỉ khi vào giờ cao điểm)',
      suggested: 0,
      note: 'Thông thường miễn phí đặt cọc. Nếu vào khung giờ cao điểm đặc biệt đông, nhân viên sẽ trao đổi rõ trước.'
    };
  }

  // 7. 1 - 4 khách: ko cần cọc
  return {
    level: 'none',
    badge: 'Không cần cọc',
    label: 'Không cần cọc',
    badgeClass: 'green',
    icon: 'fa-circle-check',
    title: `Nhóm 1 – 4 khách (${guests} người)`,
    desc: 'Hoàn toàn miễn phí đặt cọc! Nhà hàng giữ bàn ưu tiên trong 15 phút tính từ giờ hẹn.',
    amountFixed: '0đ (Miễn phí cọc)',
    amountPercent: '0%',
    suggested: 0,
    note: 'Miễn phí đặt cọc 100%. Quý khách không cần thanh toán bất kỳ khoản nào trước khi đến.'
  };
}

function hpUpdateDepositNotice() {
  const box = document.getElementById('hp-deposit-notice');
  if (!box) return;
  const guests = document.getElementById('hp-bk-guests')?.value || '2';
  const space = document.getElementById('hp-bk-space')?.value || 'Bàn chung';
  const date = document.getElementById('hp-bk-date')?.value || '';
  const isHoliday = !!document.getElementById('hp-bk-holiday')?.checked;

  const p = hpGetDepositPolicy(guests, space, date, isHoliday);

  box.className = 'hp-res-deposit-box lvl-' + p.level;
  box.innerHTML = `
    <div class="hp-dp-top">
      <span class="hp-dp-title"><i class="fa-solid ${p.icon}"></i> ${esc(p.title)}</span>
      <span class="hp-dp-badge ${p.badgeClass}" style="background:transparent!important;color:#ef4444!important;font-size:13px!important;font-weight:700!important;padding:0!important;border:none!important;box-shadow:none!important;white-space:nowrap!important;text-transform:uppercase!important">${esc(p.badge)}</span>
    </div>
    <div style="font-size:12px;color:rgba(255,255,255,0.85);margin-bottom:6px">${esc(p.desc)}</div>
    <div class="hp-dp-pills">
      <div class="hp-dp-pill"><i class="fa-solid fa-money-bill-wave"></i> Cố định: <b>${esc(p.amountFixed)}</b></div>
      <div class="hp-dp-pill"><i class="fa-solid fa-percent"></i> Hoặc theo % dự kiến: <b>${esc(p.amountPercent)}</b></div>
    </div>
    <div class="hp-dp-note">
      <i class="fa-solid fa-circle-info"></i>
      <span><b>Thông báo rõ trước khi xác nhận:</b> ${esc(p.note)}</span>
    </div>
  `;
}

async function hpBookTable(e){
  if (e && e.preventDefault) e.preventDefault();
  const nameInput = $('#hp-bk-name');
  const phoneInput = $('#hp-bk-phone');
  const guestsInput = $('#hp-bk-guests');
  const dateInput = $('#hp-bk-date');
  const timeInput = $('#hp-bk-time');
  const spaceInput = $('#hp-bk-space');
  const holidayInput = $('#hp-bk-holiday');
  const noteInput = $('#hp-bk-note');
  const submitBtn = document.querySelector('.hp-btn-res-submit');

  const name = (nameInput?.value || '').trim();
  const phone = (phoneInput?.value || '').trim();
  const guests = guestsInput?.value || '2';
  const date = dateInput?.value || ymd(Date.now());
  const time = timeInput?.value || '18:30';
  const space = spaceInput?.value || 'Bàn chung';
  const isHoliday = !!holidayInput?.checked;
  const note = (noteInput?.value || '').trim();

  if (!name) return alert('Quý khách vui lòng nhập Họ và tên.');
  if (!phone || !/^[0-9+() -]{9,15}$/.test(phone)) return alert('Quý khách vui lòng nhập số điện thoại hợp lệ (9 - 15 chữ số) để nhà hàng liên hệ xác nhận.');
  if (!date) return alert('Quý khách vui lòng chọn ngày đặt bàn.');
  if (!time) return alert('Quý khách vui lòng chọn giờ đến.');

  const policy = hpGetDepositPolicy(guests, space, date, isHoliday);

  const oldBtnHtml = submitBtn ? submitBtn.innerHTML : 'Đặt bàn ngay';
  if (submitBtn) {
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Đang gửi yêu cầu...';
  }

  try {
    const res = await fetch('/api/reservation', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name, phone, guests, date, time, space, isHoliday, note })
    });
    const data = await res.json().catch(() => ({}));

    if (res.ok && data.success) {
      const resId = data.id || 'DB';
      dlg(`<div class="hp-book-success">
        <div class="hp-bs-icon"><i class="fa-solid fa-circle-check"></i></div>
        <h3 style="margin:8px 0;color:var(--pri)">Đặt Bàn Thành Công!</h3>
        <p style="margin:0 0 14px;color:var(--fg);font-size:14px">Mã đặt bàn: <b style="color:var(--hp-gold,#b8863b);font-size:16px">${esc(resId)}</b><br>Cảm ơn Quý khách <b>${esc(name)}</b> đã lựa chọn <b>${esc(S.cfg.name)}</b>.</p>
        
        <div class="hp-bs-details">
          <div class="hp-bs-row"><span><i class="fa-solid fa-users"></i> Số lượng khách:</span><b>${esc(guests)} người</b></div>
          <div class="hp-bs-row"><span><i class="fa-solid fa-calendar-day"></i> Ngày đến:</span><b>${dmy(date)}</b></div>
          <div class="hp-bs-row"><span><i class="fa-solid fa-clock"></i> Giờ đến:</span><b>${esc(time)}</b></div>
          <div class="hp-bs-row"><span><i class="fa-solid fa-chair"></i> Khu vực:</span><b>${esc(space)}</b></div>
          <div class="hp-bs-row"><span><i class="fa-solid fa-phone"></i> Điện thoại:</span><b>${esc(phone)}</b></div>
          ${isHoliday ? '<div class="hp-bs-row"><span><i class="fa-solid fa-gift"></i> Thời điểm:</span><b>Dịp Lễ, Tết cao điểm</b></div>' : ''}
          ${note ? `<div class="hp-bs-row"><span><i class="fa-solid fa-note-sticky"></i> Ghi chú:</span><em>${esc(note)}</em></div>` : ''}
        </div>

        <!-- Thông báo chính sách tiền cọc rõ ràng trước khi nhận đơn -->
        <div style="background:#fffcf7;border:1px solid #ebd8c0;border-radius:10px;padding:12px;margin:12px 0;text-align:left">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;gap:8px;flex-wrap:wrap">
            <span style="font-size:12px;font-weight:700;color:#786650"><i class="fa-solid fa-shield-halved"></i> CHÍNH SÁCH TIỀN CỌC</span>
            <span class="hp-dp-badge ${policy.badgeClass}" style="background:transparent!important;color:#ef4444!important;font-size:13px!important;font-weight:700!important;padding:0!important;border:none!important;box-shadow:none!important;white-space:nowrap!important;text-transform:uppercase!important">${esc(policy.badge)}</span>
          </div>
          <div style="font-weight:700;color:#231d17;font-size:13.5px;margin-bottom:4px"><i class="fa-solid ${policy.icon}"></i> ${esc(policy.title)}</div>
          <div style="font-size:12px;color:#554838;margin-bottom:8px">${esc(policy.desc)}</div>
          <div style="background:#ffffff;border:1px solid #e7ded0;border-radius:8px;padding:8px 10px;font-size:12px;color:#231d17">
            <div style="margin-bottom:3px">• <b>Mức cọc cố định:</b> <span style="color:#b8863b;font-weight:700">${esc(policy.amountFixed)}</span></div>
            <div>• <b>Hoặc phần trăm dự kiến:</b> <span style="color:#b8863b;font-weight:700">${esc(policy.amountPercent)}</span></div>
          </div>
          <div style="font-size:11.5px;color:#856404;margin-top:7px;display:flex;align-items:flex-start;gap:6px">
            <i class="fa-solid fa-circle-exclamation" style="margin-top:2px;flex-shrink:0"></i>
            <span>${esc(policy.note)}</span>
          </div>
        </div>

        <div class="hp-bs-alert"><i class="fa-solid fa-headset"></i> Yêu cầu đặt bàn đã lưu vào máy chủ nhà hàng. Nhân viên sẽ gọi điện xác nhận trong vòng 5-10 phút.</div>
        <button class="p" style="width:100%;padding:12px;font-size:15px;margin-top:14px;border-radius:10px" onclick="dx()">Đã hiểu & Đóng</button>
      </div>`);

      if (nameInput) nameInput.value = '';
      if (phoneInput) phoneInput.value = '';
      if (noteInput) noteInput.value = '';
      if (typeof toast === 'function') toast('Đặt bàn thành công! Mã: ' + resId, 'ok');
    } else {
      alert(data.error || 'Không thể gửi yêu cầu đặt bàn lúc này. Quý khách vui lòng gọi hotline để được phục vụ.');
    }
  } catch (_) {
    alert('Không thể kết nối đến máy chủ nhà hàng, vui lòng thử lại sau hoặc gọi hotline.');
  } finally {
    if (submitBtn) {
      submitBtn.disabled = false;
      submitBtn.innerHTML = oldBtnHtml;
    }
  }
}

async function hpSubscribe(e) {
  if (e && e.preventDefault) e.preventDefault();
  const input = document.getElementById('hp-sub-email');
  const btn = document.getElementById('hp-sub-btn');
  const email = (input?.value || '').trim();
  if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
    return alert('Quý khách vui lòng nhập địa chỉ email hợp lệ.');
  }

  const oldBtnHtml = btn ? btn.innerHTML : 'Đăng ký';
  if (btn) {
    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';
  }

  try {
    const res = await fetch('/api/newsletter', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email })
    });
    const data = await res.json().catch(() => ({}));
    if (res.ok && data.success) {
      alert(data.message || 'Cảm ơn Quý khách đã đăng ký nhận thông tin ưu đãi!');
      if (input) input.value = '';
    } else {
      alert(data.error || 'Không thể đăng ký nhận tin lúc này, vui lòng thử lại sau.');
    }
  } catch (_) {
    alert('Lỗi kết nối máy chủ, vui lòng thử lại sau.');
  } finally {
    if (btn) {
      btn.disabled = false;
      btn.innerHTML = oldBtnHtml;
    }
  }
}

/* ===== Quản lý & Trình chiếu Banner Slide (Slick Slider Infinite Loop) ===== */
