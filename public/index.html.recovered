document.head.insertAdjacentHTML('beforeend',`<style>
.v2-pos{display:grid!important;grid-template-columns:minmax(280px,1fr) minmax(0,2fr)!important;gap:16px!important;align-items:stretch!important}
.v2-pos>.v2-panel{display:flex!important;flex-direction:column!important;height:100%!important;min-height:100%!important;box-sizing:border-box!important}
.v2-pos .v2-list{flex:1 1 auto!important;min-height:0!important;max-height:575px!important;overflow-y:auto!important}
.v2-pos>.v2-panel:last-child{display:flex!important;flex-direction:column!important}
.v2-pos>.v2-panel:last-child .hdf{margin-top:auto!important;padding-top:10px!important}
html[data-dev=phone] .v2-pos{grid-template-columns:1fr!important}
html[data-dev=phone] .v2-pos .v2-list{max-height:480px!important}
@media(max-width:900px){.v2-pos{grid-template-columns:1fr!important}.v2-pos .v2-list{max-height:480px!important}}
.v2-kpi{background:color-mix(in srgb,var(--c) 16%,var(--card))!important}
.v2-kic{background:color-mix(in srgb,var(--c) 16%,var(--card))!important}
.v2c-name,.v2c-amt{font-size:16px!important;font-weight:600!important}
aside{padding:5px 10px}
</style>`);
/* ===== Bổ sung v57: lưới bàn phục vụ 4 hàng; hộp thoại chọn bàn theo kiểu thẻ mới ===== */
document.head.insertAdjacentHTML('beforeend',`<style>
.v2-pickgrid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;max-height:calc(4 * 132px + 36px);overflow:auto;padding:2px}
html[data-dev=phone] .v2-pickgrid{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;max-height:calc(4 * 140px + 24px)}
</style>`);
function v2PickTile(t,id){const c=V2TS[t.st]||'var(--mut)',busy=t.st=='busy',n=tOrders(t.id).length,lbl=TS[t.st];
return`<button class=v2c style="--c:${c}" onclick="v2Pick(${t.id},'${id}')"><span class=v2c-top><span class=v2c-name>${esc(t.name)}</span><span class=v2c-st><span class=v2c-dot></span>${lbl}</span></span><span class=v2c-n><i class="fa-solid fa-users"></i><span>${n} đơn</span></span><span class=v2c-foot><span class=v2c-amt>${busy?money(tTotal(t.id)):'—'}</span><i class="fa-solid fa-chevron-right v2c-go"></i></span></button>`}
function quick(id){const av=S.tables.filter(t=>!t.off&&t.st!='clean'),m=S.menu.find(x=>x.id==id);if(!m)return;if(!av.length)return toast('Không có bàn khả dụng.','warn');
dlg(`<div class=v2-modal-h><div><b>${esc(m.name)}</b><div class=v2-sub>Chọn bàn để thêm món</div></div></div><div class=v2-pickgrid>${av.map(t=>v2PickTile(t,id)).join('')}</div><div style="margin-top:12px;text-align:right"><button onclick="dx()">Hủy</button></div>`);
const bx=$('#dlg>.box');if(bx)bx.style.width='min(760px,100%)';}
