function togCol(){if(document.documentElement.getAttribute('data-dev')=='phone'){const want=!document.body.classList.contains('drawer');setTimeout(()=>document.body.classList.toggle('drawer',want),0);return}colp=!colp;document.body.classList.toggle('col',colp);try{localStorage.setItem('nh_col',colp?'1':'0')}catch(e){}}
document.head.insertAdjacentHTML('beforeend',`<style>
#hbg{display:none!important}
html[data-dev=phone] aside a.cb{display:block!important}
