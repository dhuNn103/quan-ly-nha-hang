html[data-dev=phone] body:not(.drawer) main{padding-left:62px!important}
html[data-dev=phone] body:not(.drawer) aside a,html[data-dev=phone] body:not(.drawer) aside h5,html[data-dev=phone] body:not(.drawer) aside b,html[data-dev=phone] body:not(.drawer) aside .mut,html[data-dev=phone] body:not(.drawer) aside .tx{font-size:0!important;line-height:0!important;white-space:nowrap!important}
html[data-dev=phone] body:not(.drawer) aside .ic,html[data-dev=phone] body:not(.drawer) aside .ic i,html[data-dev=phone] body:not(.drawer) aside a i{font-size:18px!important;line-height:1!important}
