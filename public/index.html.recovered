  if (tab === 'dishes') {
    return `
      <div class="hp-ed-card">
        <div class="hp-ed-card-head"><i class="fa-solid fa-utensils" style="color:#b8863b"></i> 4 Món ăn nổi bật (Thực đơn nổi bật)</div>
