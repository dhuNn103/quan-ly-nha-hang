                <div class="hp-ed-field">
                  <label>Chữ nút liên kết</label>
                  <input id="hp_ed_s_btn_${i}" value="${esc(s.linkText || 'Xem thêm')}" placeholder="VD: Xem thực đơn">
                </div>
              </div>
              <div class="hp-ed-field" style="margin-bottom:10px">
                <label>Mô tả dịch vụ</label>
                <input id="hp_ed_s_desc_${i}" value="${esc(s.desc)}" placeholder="Mô tả ngắn">
              </div>
              <div class="hp-ed-field">
                <label>Hình ảnh dịch vụ</label>
                <div class="hp-img-upload-row">
                  <img id="hp_ed_s_prv_${i}" src="${esc(s.img)}" class="hp-img-thumb-preview" alt="Xem trước">
                  <input id="hp_ed_s_img_${i}" value="${esc(s.img)}" oninput="$('#hp_ed_s_prv_${i}').src=this.value" placeholder="URL hình ảnh">
                  <button type="button" class="p" onclick="$('#hp_ed_s_f_${i}').click()" style="white-space:nowrap"><i class="fa-solid fa-upload"></i> Chọn ảnh</button>
                  <input id="hp_ed_s_f_${i}" type="file" accept="image/*" style="display:none" onchange="hpPickLocalImg(this, 'hp_ed_s_img_${i}', 'hp_ed_s_prv_${i}')">
