  'crispy vietnamese crepe': 'Bánh Xèo'
};

function hpTranslateDish(name) {
  if (!name) return '';
  const key = name.trim().toLowerCase();
  if (hpLang !== 'en') {
    if (HP_DISH_NAMES_EN_TO_VI[key]) return HP_DISH_NAMES_EN_TO_VI[key];
    return name;
  }
  if (HP_DISH_NAMES[key]) return HP_DISH_NAMES[key];
  for (const [k, v] of Object.entries(HP_DISH_NAMES)) {
    if (key.includes(k)) return v;
  }
  return name;
}

function hpToggleLang() {
  const prevScrollY = window.scrollY;
  hpLang = (hpLang === 'en') ? 'vi' : 'en';
  hpNavOpen = false;
  document.body.classList.remove('hp-menu-opened');
  try {
    localStorage.setItem('nh_lang', hpLang);
  } catch(e) {}
  render();
  if (prevScrollY > 0) {
    requestAnimationFrame(() => window.scrollTo(0, prevScrollY));
  }
}

function hpRenderLangBtn() {
  const isEn = (hpLang === 'en');
  const tip = isEn ? hpT('switchLangTooltipVi', 'Chuyển sang Tiếng Việt') : hpT('switchLangTooltipEn', 'Switch to English');
  return `<button type="button" class="hp-lang-btn" onclick="hpToggleLang()" title="${tip}" aria-label="${tip}">
    ${isEn ? hpFlagVnSvg : hpFlagUkSvg}
  </button>`;
}

let hpSubPage = 'home'; // 'home' | 'fullmenu' | 'about'
let hpFullMenuSelectedCat = 'all';
let hpFullMenuSearchKeyword = '';

function hpCheckHashRoute() {
  const h = location.hash || '';
  if (h.startsWith('#full-menu')) {
    hpSubPage = 'fullmenu';
    const match = h.match(/cat=([^&]+)/);
    if (match) {
      try { hpFullMenuSelectedCat = decodeURIComponent(match[1]); } catch(_) {}
    } else {
      hpFullMenuSelectedCat = 'all';
    }
  } else if (h === '#about-us' || h === '#about-page') {
    hpSubPage = 'about';
  } else {
    hpSubPage = 'home';
  }
}
hpCheckHashRoute();
window.addEventListener('hashchange', () => {
  const prevSubPage = hpSubPage;
  hpCheckHashRoute();
  if (!me || page === 'home') {
    if (prevSubPage !== hpSubPage || hpSubPage === 'fullmenu' || hpSubPage === 'about') {
      render();
    }
  }
});

function hpNavToFullMenu(cat = 'all', e) {
  if (e) {
    if (e.preventDefault) e.preventDefault();
    if (e.stopPropagation) e.stopPropagation();
  }
  hpNavOpen = false;
  document.body.classList.remove('hp-menu-opened');
  hpActiveNav = 'menu';
  hpSubPage = 'fullmenu';
  hpFullMenuSelectedCat = cat || 'all';
  hpFullMenuSearchKeyword = '';
  try {
    const hashStr = (cat && cat !== 'all') ? ('#full-menu?cat=' + encodeURIComponent(cat)) : '#full-menu';
    history.pushState ? history.pushState(null, '', hashStr) : (location.hash = hashStr);
  } catch(_) {}
  render();
  window.scrollTo({ top: 0, behavior: 'smooth' });
  if (typeof hpInitStatsCounters === 'function') setTimeout(hpInitStatsCounters, 60);
  if (typeof hpInitQuoteTypewriter === 'function') setTimeout(hpInitQuoteTypewriter, 70);
}

function hpNavToMenuCat(cat, e) {
  hpNavToFullMenu(cat || 'all', e);
}

function hpNavToAboutUs(e) {
  if (e) {
    if (e.preventDefault) e.preventDefault();
    if (e.stopPropagation) e.stopPropagation();
  }
  hpNavOpen = false;
  document.body.classList.remove('hp-menu-opened');
  hpActiveNav = 'about';
  hpSubPage = 'about';
  try {
    history.pushState ? history.pushState(null, '', '#about-us') : (location.hash = '#about-us');
  } catch(_) {}
  render();
  window.scrollTo({ top: 0, behavior: 'smooth' });
  if (typeof hpInitStatsCounters === 'function') setTimeout(hpInitStatsCounters, 60);
  if (typeof hpInitQuoteTypewriter === 'function') setTimeout(hpInitQuoteTypewriter, 70);
}

/* ===== Trình chỉnh sửa nội dung Trang chủ (Visual Homepage Editor) ===== */

let hpActiveNav = 'home';

function hpNavTo(targetId, e) {
  if (e) {
    if (e.preventDefault) e.preventDefault();
    if (e.stopPropagation) e.stopPropagation();
  }
  if (!targetId) return;
  const cleanId = String(targetId).replace(/^#/, '').trim();
  if (!cleanId) return;

  if (cleanId.startsWith('http://') || cleanId.startsWith('https://') || cleanId.startsWith('tel:') || cleanId.startsWith('mailto:')) {
    window.open(cleanId, '_blank');
    return;
  }

  hpNavOpen = false;
  document.body.classList.remove('hp-menu-opened');
  hpActiveNav = cleanId;

  const nav = document.querySelector('.hp-nav-links');
  if (nav) nav.classList.remove('open');
  const toggleBtn = document.querySelector('.hp-menu-toggle');
  if (toggleBtn) toggleBtn.innerHTML = '<i class="fa-solid fa-bars"></i>';

  document.querySelectorAll('.hp-nav-links a[data-nav]').forEach(a => {
    a.classList.toggle('active', a.dataset.nav === cleanId);
  });

  if (hpSubPage === 'fullmenu' || hpSubPage === 'about') {
    if (hpSubPage === 'about' && cleanId === 'about') {
      window.scrollTo({ top: 0, behavior: 'smooth' });
      return;
    }
    if (hpSubPage === 'fullmenu' && cleanId === 'menu') {
      window.scrollTo({ top: 0, behavior: 'smooth' });
      return;
    }
    if (cleanId === 'menu') {
      hpNavToFullMenu('all', e);
      return;
    }
    hpSubPage = 'home';
    render();
    if (cleanId === 'home') {
      window.scrollTo({ top: 0, behavior: 'smooth' });
      try { history.replaceState(null, '', location.pathname + '#home'); } catch(_) {}
    } else {
      setTimeout(() => {
        const sec = document.getElementById(cleanId);
        if (sec) {
          sec.scrollIntoView({ behavior: 'smooth', block: 'start' });
          try { history.replaceState(null, '', '#' + cleanId); } catch(_) {}
        }
      }, 60);
    }
    return;
  }

  if (cleanId === 'home') {
    window.scrollTo({ top: 0, behavior: 'smooth' });
    try { history.replaceState(null, '', location.pathname); } catch(_) {}
    return;
  }

  const sec = document.getElementById(cleanId);
  if (sec) {
    sec.scrollIntoView({ behavior: 'smooth', block: 'start' });
    try { history.replaceState(null, '', '#' + cleanId); } catch(_) {}
  }
}

// Global click capture: bấm 1 lần chuyển ngay lập tức đến mục cần đến, không cần bấm lần 2
document.addEventListener('click', function(e) {
  const a = e.target.closest('a[href^="#"]');
  if (!a) return;
  if (a.hasAttribute('data-menu-cat')) {
    e.preventDefault();
    e.stopPropagation();
    const cat = a.getAttribute('data-menu-cat');
    hpNavToMenuCat(cat, e);
    return;
  }
  const hash = a.getAttribute('href');
  if (hash === '#full-menu') {
    e.preventDefault();
    e.stopPropagation();
    hpNavToFullMenu('all', e);
    return;
  }
  if (hash === '#about-us' || hash === '#about-page') {
    e.preventDefault();
    e.stopPropagation();
    hpNavToAboutUs(e);
    return;
  }
  if (!hash || hash === '#' || hash === '#login') return;
  const targetId = hash.replace(/^#/, '');
  if (hpSubPage === 'fullmenu' || hpSubPage === 'about') {
    e.preventDefault();
    e.stopPropagation();
    hpNavTo(targetId, e);
    return;
  }
  const sec = document.getElementById(targetId);
  if (sec) {
    e.preventDefault();
    e.stopPropagation();
    hpNavTo(targetId);
  }
}, true);

function hpInitScrollspy() {
  const sections = [
    { id: 'home', el: document.querySelector('.hp-banner-sec') },
    { id: 'about', el: document.getElementById('about') },
    { id: 'space', el: document.getElementById('space') },
    { id: 'menu', el: document.getElementById('menu') },
    { id: 'booking', el: document.getElementById('booking') },
    { id: 'contact', el: document.getElementById('contact') }
  ];

  let scrollTimeout;
  window.addEventListener('scroll', () => {
    if (!document.body.classList.contains('home-page') || hpSubPage === 'fullmenu' || hpSubPage === 'about') return;
    clearTimeout(scrollTimeout);
    scrollTimeout = setTimeout(() => {
      const scrollPos = window.scrollY + 120;
      let currentId = 'home';

      for (const s of sections) {
        if (s.el) {
          const top = s.el.offsetTop;
          const height = s.el.offsetHeight;
          if (scrollPos >= top && scrollPos < top + height) {
            currentId = s.id;
          }
        }
      }

      if ((window.innerHeight + window.scrollY) >= (document.body.offsetHeight - 90)) {
        currentId = 'contact';
      }

      hpActiveNav = currentId;
      document.querySelectorAll('.hp-nav-links a[data-nav]').forEach(a => {
        a.classList.toggle('active', a.dataset.nav === currentId);
      });
    }, 50);
  }, { passive: true });
}

