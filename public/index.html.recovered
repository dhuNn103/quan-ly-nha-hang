function hpSlideItemHtml(b, realIndex, isClone) {
  const isEn = (hpLang === 'en');
  const enB = isEn ? (HP_EN_BANNERS[b.id] || {
    tag: '— Huong Vi Viet —',
    title: 'Essence of\nVietnamese Cuisine',
    sub: 'Discover authentic traditional flavors in an elegant, cozy, and contemporary setting.'
  }) : null;

  const slideTag = enB ? enB.tag : (b.tag || '— Hương Vị Việt —');
  const slideTitle = enB ? enB.title : (b.title || 'Tinh Hoa\nẨm Thực Việt');
  const slideSub = enB ? enB.sub : (b.sub || 'Khám phá hương vị truyền thống trong không gian sang trọng, ấm cúng và hiện đại.');
  const btnBook = hpT('bookTableBtn', 'Đặt bàn');
  const btnMenu = hpT('exploreMenu', 'Xem thực đơn');

  return `
    <div class="hp-slide ${!isClone && realIndex === hpSliderIdx ? 'active' : ''}${isClone ? ' hp-slide-clone' : ''}" data-real-index="${realIndex}" ${isClone ? 'data-clone="1"' : ''} style="${b.img ? `background-image:url('${esc(b.img)}');` : ''}${b.bg ? `background:${esc(b.bg)};` : ''}" onclick="hpSlideClick('${esc(b.link || '#menu')}')">
      <div class="hp-slide-overlay"></div>
      <div class="hp-slide-inner">
        <div class="hp-slide-content">
          <span class="hp-slide-curved-tag">${esc(slideTag)}</span>
          <h1 class="hp-slide-title">${esc(slideTitle).replace(/\n/g, '<br>')}</h1>
          <p class="hp-slide-sub">${esc(slideSub)}</p>
          <div class="hp-slide-actions" onclick="event.stopPropagation()">
            <a href="#booking" class="hp-btn-hero-primary" onclick="hpNavTo('booking', event)"><i class="fa-solid fa-utensils"></i> ${esc(btnBook)} <i class="fa-solid fa-arrow-right"></i></a>
            <a href="#menu" class="hp-btn-hero-secondary" onclick="hpNavTo('menu', event)"><i class="fa-solid fa-play" style="font-size:11px"></i> ${esc(btnMenu)}</a>
          </div>
        </div>
      </div>
    </div>
  `;
}

function hpUpdateSliderUI(idx) {
  const dots = document.querySelectorAll('.hp-slider-dot');
  dots.forEach((d, i) => d.classList.toggle('active', i === idx));
  const track = document.getElementById('hp-slider-track');
  if (track) {
    const slides = track.querySelectorAll('.hp-slide');
    slides.forEach(sl => {
      const realIdx = parseInt(sl.getAttribute('data-real-index'), 10);
      const isClone = sl.hasAttribute('data-clone');
      sl.classList.toggle('active', !isClone && realIdx === idx);
    });
  }
}

function hpResetTimer() {
  if (hpSliderTimer) {
    clearInterval(hpSliderTimer);
    hpSliderTimer = null;
  }
  if (!hpSliderPaused) {
    hpSliderTimer = setInterval(hpSliderNext, 3500);
  }
}

function hpSliderGo(targetRealIdx) {
  const banners = getHpBanners();
  const N = banners.length;
  if (N <= 1) return;
  if (targetRealIdx === hpSliderIdx) return;
  if (hpIsTransitioning) return;

  const track = document.getElementById('hp-slider-track');
  if (!track) return;

  if (hpSliderIdx === N - 1 && targetRealIdx === 0) {
    hpSliderNext();
    return;
  }
  if (hpSliderIdx === 0 && targetRealIdx === N - 1) {
    hpSliderPrev();
    return;
  }

  hpIsTransitioning = true;
  hpSliderIdx = targetRealIdx;
  hpVisualIdx = targetRealIdx + 1;
  hpUpdateSliderUI(hpSliderIdx);

  track.style.transition = 'transform .75s cubic-bezier(.25,1,.5,1)';
  track.style.transform = `translateX(-${hpVisualIdx * 100}%)`;

  const onEnd = () => {
    if (hpTransitionTimer) { clearTimeout(hpTransitionTimer); hpTransitionTimer = null; }
    track.removeEventListener('transitionend', onEnd);
    hpIsTransitioning = false;
  };
  track.addEventListener('transitionend', onEnd, { once: true });
  hpTransitionTimer = setTimeout(onEnd, 850);

  hpResetTimer();
}

function hpSliderNext() {
  const banners = getHpBanners();
  const N = banners.length;
  if (N <= 1) return;
  if (hpIsTransitioning) return;

  const track = document.getElementById('hp-slider-track');
  if (!track) return;

  hpIsTransitioning = true;
  hpVisualIdx++;

  if (hpVisualIdx >= N + 1) {
    hpSliderIdx = 0;
  } else {
    hpSliderIdx = hpVisualIdx - 1;
  }
  hpUpdateSliderUI(hpSliderIdx);

  track.style.transition = 'transform .75s cubic-bezier(.25,1,.5,1)';
  track.style.transform = `translateX(-${hpVisualIdx * 100}%)`;

  const onEnd = () => {
    if (hpTransitionTimer) { clearTimeout(hpTransitionTimer); hpTransitionTimer = null; }
    track.removeEventListener('transitionend', onEnd);
    if (hpVisualIdx >= N + 1) {
      hpVisualIdx = 1;
      track.style.transition = 'none';
      track.style.transform = `translateX(-${hpVisualIdx * 100}%)`;
      track.offsetHeight;
    }
    hpIsTransitioning = false;
  };

  track.addEventListener('transitionend', onEnd, { once: true });
  hpTransitionTimer = setTimeout(onEnd, 850);

  hpResetTimer();
}

function hpSliderPrev() {
  const banners = getHpBanners();
  const N = banners.length;
  if (N <= 1) return;
  if (hpIsTransitioning) return;

  const track = document.getElementById('hp-slider-track');
  if (!track) return;

  hpIsTransitioning = true;
  hpVisualIdx--;

  if (hpVisualIdx <= 0) {
    hpSliderIdx = N - 1;
  } else {
    hpSliderIdx = hpVisualIdx - 1;
  }
  hpUpdateSliderUI(hpSliderIdx);

  track.style.transition = 'transform .75s cubic-bezier(.25,1,.5,1)';
  track.style.transform = `translateX(-${hpVisualIdx * 100}%)`;

  const onEnd = () => {
    if (hpTransitionTimer) { clearTimeout(hpTransitionTimer); hpTransitionTimer = null; }
    track.removeEventListener('transitionend', onEnd);
    if (hpVisualIdx <= 0) {
      hpVisualIdx = N;
      track.style.transition = 'none';
      track.style.transform = `translateX(-${hpVisualIdx * 100}%)`;
      track.offsetHeight;
    }
    hpIsTransitioning = false;
  };

  track.addEventListener('transitionend', onEnd, { once: true });
  hpTransitionTimer = setTimeout(onEnd, 850);

  hpResetTimer();
}

function hpSliderPause() {
  hpSliderPaused = true;
  if (hpSliderTimer) {
    clearInterval(hpSliderTimer);
    hpSliderTimer = null;
  }
}

function hpSliderResume() {
  hpSliderPaused = false;
  if (!hpSliderTimer) {
    hpSliderTimer = setInterval(hpSliderNext, 3500);
  }
}

function hpSlideClick(link) {
  if (link && link.startsWith('#')) {
    hpNavTo(link);
  } else if (link) {
    window.open(link, '_blank');
  }
}

function hpSliderInit() {
  const track = document.getElementById('hp-slider-track');
  if (!track) return;

  const banners = getHpBanners();
  const N = banners.length;

  if (hpSliderTimer) clearInterval(hpSliderTimer);
  if (hpTransitionTimer) clearTimeout(hpTransitionTimer);
  hpIsTransitioning = false;
  hpSliderPaused = false;

  if (N <= 1) {
    track.style.transition = 'none';
    track.style.transform = 'translateX(0%)';
    return;
  }

  if (hpSliderIdx < 0 || hpSliderIdx >= N) hpSliderIdx = 0;
  hpVisualIdx = hpSliderIdx + 1;

  track.style.transition = 'none';
  track.style.transform = `translateX(-${hpVisualIdx * 100}%)`;
  track.offsetHeight;
  track.style.transition = 'transform .75s cubic-bezier(.25,1,.5,1)';

  hpUpdateSliderUI(hpSliderIdx);

  hpSliderTimer = setInterval(hpSliderNext, 3500);

  const wrap = document.getElementById('hp-slider-wrap');
  if (wrap && !wrap.dataset.sliderBound) {
    wrap.dataset.sliderBound = '1';
    wrap.addEventListener('mouseenter', hpSliderPause);
    wrap.addEventListener('mouseleave', hpSliderResume);

    let touchStartX = 0;
    let touchEndX = 0;
    wrap.addEventListener('touchstart', e => {
      if (e.changedTouches && e.changedTouches[0]) {
        touchStartX = e.changedTouches[0].screenX;
      }
    }, { passive: true });
    wrap.addEventListener('touchend', e => {
      if (e.changedTouches && e.changedTouches[0]) {
        touchEndX = e.changedTouches[0].screenX;
        if (touchStartX - touchEndX > 45) {
          hpSliderNext();
        } else if (touchEndX - touchStartX > 45) {
          hpSliderPrev();
        }
      }
    }, { passive: true });
  }
}

function pickBannerImg(el) {
  if (!el.files || !el.files[0]) return;
  rz(el.files[0], 'image/jpeg', 1280, d => {
    tmpBannerImg = d;
    const prev = $('#bn-prev');
    if (prev) {
      prev.style.backgroundImage = `url('${d}')`;
      prev.innerHTML = '';
    }
  });
}

window.bannerAdminCollapsed = true;
try {
  localStorage.removeItem('nh_banner_collapsed');
} catch (e) {}

function toggleBannerAdminCollapse() {
  window.bannerAdminCollapsed = !window.bannerAdminCollapsed;
  const list = document.getElementById('hp-banner-list-container');
  const btn = document.getElementById('btn-toggle-banners');
  if (list) {
    list.style.display = window.bannerAdminCollapsed ? 'none' : 'flex';
  }
  if (btn) {
    btn.innerHTML = `<i class="fa-solid ${window.bannerAdminCollapsed ? 'fa-chevron-down' : 'fa-chevron-up'}"></i>`;
    btn.title = window.bannerAdminCollapsed ? 'Mở rộng danh sách slide' : 'Thu gọn danh sách slide';
  }
}

function renderBannerAdminList() {
  const banners = (S.cfg && Array.isArray(S.cfg.banners) && S.cfg.banners.length) ? S.cfg.banners : getDefaultBanners();
  const isCustom = !!(S.cfg && Array.isArray(S.cfg.banners) && S.cfg.banners.length);
  if (!banners.length) {
    return '<p class="mut" style="padding:10px 0;font-size:13px">Chưa có banner nào. Bấm "+ Thêm Slide" để tạo banner mới.</p>';
  }
  return banners.map((b, i) => `
    <div class="hp-bitem-card" style="display:flex;gap:10px;align-items:center;background:var(--bg);border:1px solid var(--bd);border-radius:12px;padding:9px 12px;min-width:0;max-width:100%;box-sizing:border-box;flex-wrap:wrap">
      <div class="hp-bitem-thumb" style="width:84px;height:52px;border-radius:8px;background-size:cover;background-position:center;background-color:#1e293b;flex-shrink:0;${b.img ? `background-image:url('${esc(b.img)}');` : ''}border:1px solid var(--bd);display:flex;align-items:center;justify-content:center;color:#fff;font-size:15px">
        ${!b.img ? '<i class="fa-solid fa-image" style="opacity:.6"></i>' : ''}
      </div>
      <div style="flex:1 1 120px;min-width:0;overflow:hidden">
        <div style="display:flex;align-items:center;gap:6px;margin-bottom:2px;flex-wrap:wrap">
          <span style="font-size:11px;font-weight:700;padding:2px 7px;border-radius:999px;background:color-mix(in srgb,var(--w) 18%,var(--card));color:var(--w);flex-shrink:0">${esc(b.tag || 'Slide ' + (i + 1))}</span>
          <b style="font-size:13px;color:var(--fg);white-space:nowrap;overflow:hidden;text-overflow:ellipsis" title="${esc(b.title || '')}">${esc(b.title || 'Slide không tên')}</b>
          ${!isCustom ? '<span style="font-size:10.5px;color:var(--mut);font-style:italic;white-space:nowrap">(Mặc định)</span>' : ''}
        </div>
        <div style="font-size:11.5px;color:var(--mut);line-height:1.35;white-space:nowrap;overflow:hidden;text-overflow:ellipsis" title="${esc(b.sub || b.desc || '')}">${esc(b.sub || b.desc || 'Chưa có mô tả')}</div>
        <div style="font-size:11px;color:var(--w);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><i class="fa-solid fa-link"></i> Nút: <b>${esc(b.btn || 'Xem')}</b> (${esc(b.link || '#menu')})</div>
      </div>
      <div style="display:flex;gap:4px;align-items:center;margin-left:auto;flex-shrink:0">
        <button type="button" class="ib" title="Chuyển lên" onclick="moveBanner(${i}, -1)" ${i === 0 ? 'disabled style="opacity:.4"' : ''} style="width:28px;height:28px;padding:0;min-height:0;font-size:11.5px"><i class="fa-solid fa-arrow-up"></i></button>
        <button type="button" class="ib" title="Chuyển xuống" onclick="moveBanner(${i}, 1)" ${i === banners.length - 1 ? 'disabled style="opacity:.4"' : ''} style="width:28px;height:28px;padding:0;min-height:0;font-size:11.5px"><i class="fa-solid fa-arrow-down"></i></button>
        <button type="button" class="ib" title="Chỉnh sửa slide này" style="width:28px;height:28px;padding:0;min-height:0;font-size:11.5px" onclick="openBannerModal(${i})"><i class="fa-solid fa-pen"></i></button>
        <button type="button" class="ib x" title="Xóa slide này" style="width:28px;height:28px;padding:0;min-height:0;font-size:11.5px" onclick="delBanner(${i})"><i class="fa-solid fa-trash-can"></i></button>
      </div>
    </div>
  `).join('');
}

function openBannerModal(idx = null) {
  const banners = (S.cfg && Array.isArray(S.cfg.banners) && S.cfg.banners.length) ? S.cfg.banners : getDefaultBanners();
  const isEdit = idx !== null && banners[idx];
  const cur = isEdit ? banners[idx] : { tag: 'MÓN NGON MỚI', title: '', sub: '', btn: 'Xem thực đơn', link: '#menu', img: '' };
  tmpBannerImg = cur.img || '';

  dlg(`
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;border-bottom:1px solid var(--bd);padding-bottom:10px">
      <h3 style="margin:0;font-size:18px"><i class="fa-solid fa-images" style="color:var(--w)"></i> ${isEdit ? 'Chỉnh sửa Banner Slide' : 'Thêm Banner Slide mới'}</h3>
      <button class="ib x" onclick="dx()" title="Đóng"><i class="fa-solid fa-xmark"></i></button>
    </div>

    <div class="fr" style="margin:0 0 12px">
      <label style="font-weight:600;font-size:13.5px;margin-bottom:6px">Hình ảnh Banner Slide (*)</label>
      <div style="width:100%;display:flex;flex-direction:column;gap:10px">
        <div id="bn-prev" style="width:100%;height:220px;border-radius:12px;background:#1e293b;background-size:cover;background-position:center;border:1px dashed var(--bd);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;${tmpBannerImg ? `background-image:url('${tmpBannerImg}');` : ''}">
          ${!tmpBannerImg ? '<span class="mut" style="font-size:13px"><i class="fa-solid fa-cloud-arrow-up"></i> Chưa có ảnh · Bấm nút dưới để tải ảnh lên</span>' : ''}
        </div>
        <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap">
          <button type="button" class="p" style="display:inline-flex;align-items:center;gap:6px;padding:8px 16px;border-radius:8px;font-weight:600;white-space:nowrap" onclick="$('#bnf').click()"><i class="fa-solid fa-upload"></i> Tải ảnh từ máy tính</button>
          <input id="bnf" type="file" accept="image/*" hidden onchange="pickBannerImg(this)">
          <button type="button" class="x" style="display:inline-flex;align-items:center;gap:6px;padding:8px 16px;border-radius:8px;font-weight:500;white-space:nowrap;border:1px solid color-mix(in srgb,var(--bad) 40%,var(--bd));background:color-mix(in srgb,var(--bad) 8%,transparent);color:var(--bad)" onclick="tmpBannerImg='';$('#bn-prev').style.backgroundImage='none';$('#bn-prev').innerHTML='<span class=mut style=font-size:13px><i class=\\\'fa-solid fa-cloud-arrow-up\\\'></i> Chưa có ảnh · Bấm nút dưới để tải ảnh lên</span>'"><i class="fa-solid fa-trash-can"></i> Xóa ảnh</button>
        </div>
        <div class="mut" style="font-size:12px;line-height:1.4">Khuyên dùng ảnh ngang tỷ lệ 16:9 hoặc 21:9 (kích thước tối ưu 1280x540px hoặc lớn hơn). Hệ thống tự động nén tối ưu hiển thị nhanh.</div>
      </div>
    </div>

    <div class="fr" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:0 0 12px">
      <div class="fp"><label style="font-weight:600;font-size:13px;margin-bottom:4px;white-space:nowrap">Huy hiệu / Tag</label><input id="bn-tag" value="${esc(cur.tag || '')}" placeholder="VD: Món Ngon Tinh Hoa" style="width:100%"></div>
      <div class="fp"><label style="font-weight:600;font-size:13px;margin-bottom:4px;white-space:nowrap">Chữ trên nút bấm</label><input id="bn-btn" value="${esc(cur.btn || 'Xem thực đơn')}" placeholder="VD: Xem thực đơn, Đặt bàn ngay" style="width:100%"></div>
    </div>

    <div class="fr" style="margin:0 0 12px">
      <div class="fp" style="width:100%"><label style="font-weight:600;font-size:13px;margin-bottom:4px;white-space:nowrap">Tiêu đề nổi bật (*)</label><input id="bn-title" value="${esc(cur.title || '')}" placeholder="VD: Hương Vị Ẩm Thực Tinh Hoa" style="width:100%" required></div>
    </div>

    <div class="fr" style="margin:0 0 12px">
      <div class="fp" style="width:100%"><label style="font-weight:600;font-size:13px;margin-bottom:4px;white-space:nowrap">Mô tả ngắn / Lời dẫn</label><textarea id="bn-sub" rows="2" style="width:100%;resize:vertical" placeholder="VD: Thưởng thức những tuyệt tác ẩm thực tinh tế mỗi ngày...">${esc(cur.sub || cur.desc || '')}</textarea></div>
    </div>

    <div class="fr" style="margin:0 0 16px">
      <div class="fp" style="width:100%">
        <label style="font-weight:600;font-size:13px;margin-bottom:4px;white-space:nowrap">Liên kết khi bấm nút hoặc click slide</label>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;align-items:center">
          <select id="bn-link-sel" onchange="if(this.value!=='custom')$('#bn-link').value=this.value" style="width:100%">
            <option value="#menu" ${cur.link === '#menu' ? 'selected' : ''}>Xem thực đơn (#menu)</option>
            <option value="#booking" ${cur.link === '#booking' ? 'selected' : ''}>Đặt bàn trực tuyến (#booking)</option>
            <option value="#space" ${cur.link === '#space' ? 'selected' : ''}>Không gian nhà hàng (#space)</option>
            <option value="#about" ${cur.link === '#about' ? 'selected' : ''}>Về chúng tôi (#about)</option>
            <option value="#hours" ${cur.link === '#hours' ? 'selected' : ''}>Giờ mở cửa & Liên hệ (#hours)</option>
            <option value="custom" ${cur.link && !cur.link.startsWith('#') ? 'selected' : ''}>Liên kết tùy chỉnh...</option>
          </select>
          <input id="bn-link" value="${esc(cur.link || '#menu')}" placeholder="#menu hoặc liên kết web" style="width:100%">
        </div>
      </div>
    </div>

    <div style="display:flex;justify-content:flex-end;gap:10px;border-top:1px solid var(--bd);padding-top:12px">
      <button type="button" style="padding:8px 18px" onclick="dx()">Hủy</button>
      <button type="button" class="p" style="padding:8px 20px" onclick="saveBannerSlide(${idx !== null ? idx : 'null'})"><i class="fa-solid fa-floppy-disk"></i> Lưu Slide</button>
    </div>
  `, 'min(866px, 96vw)');

  const bx = $('#dlg>.box');
  if (bx) {
    bx.style.width = 'min(866px, 96vw)';
    bx.style.maxHeight = '92vh';
    bx.style.overflowY = 'auto';
  }
}

function saveBannerSlide(idx) {
  const title = ($('#bn-title') ? $('#bn-title').value.trim() : '');
  if (!title) {
    alert('Vui lòng nhập tiêu đề cho Banner Slide.');
    $('#bn-title')?.focus();
    return;
  }
  const tag = ($('#bn-tag') ? $('#bn-tag').value.trim() : '');
  const sub = ($('#bn-sub') ? $('#bn-sub').value.trim() : '');
  const btn = ($('#bn-btn') ? $('#bn-btn').value.trim() : 'Xem thực đơn');
  const link = ($('#bn-link') ? $('#bn-link').value.trim() : '#menu');

  if (!Array.isArray(S.cfg.banners) || !S.cfg.banners.length) {
    S.cfg.banners = JSON.parse(JSON.stringify(getDefaultBanners()));
  }

  const slide = {
    id: idx !== null && S.cfg.banners[idx] && S.cfg.banners[idx].id ? S.cfg.banners[idx].id : ('bn_' + Date.now()),
    img: tmpBannerImg || '',
    tag,
    title,
    sub,
    btn,
    link
  };

  if (idx !== null && idx >= 0 && idx < S.cfg.banners.length) {
    S.cfg.banners[idx] = slide;
  } else {
    S.cfg.banners.push(slide);
  }

  save();
  dx();
  render();
  alert('Đã lưu Banner Slide thành công!');
}

function delBanner(idx) {
  if (!Array.isArray(S.cfg.banners) || !S.cfg.banners.length) {
    S.cfg.banners = JSON.parse(JSON.stringify(getDefaultBanners()));
  }
  if (!confirm('Bạn có chắc chắn muốn xóa Banner Slide này?')) return;
  S.cfg.banners.splice(idx, 1);
  save();
  render();
}

function moveBanner(idx, dir) {
  if (!Array.isArray(S.cfg.banners) || !S.cfg.banners.length) {
    S.cfg.banners = JSON.parse(JSON.stringify(getDefaultBanners()));
  }
  const target = idx + dir;
  if (target < 0 || target >= S.cfg.banners.length) return;
  const temp = S.cfg.banners[idx];
  S.cfg.banners[idx] = S.cfg.banners[target];
  S.cfg.banners[target] = temp;
  save();
  render();
}

function resetDefaultBanners() {
  if (!confirm('Bạn có muốn khôi phục lại bộ 3 Banner Slide mặc định được thiết kế sẵn không?')) return;
  S.cfg.banners = JSON.parse(JSON.stringify(getDefaultBanners()));
  save();
  render();
  alert('Đã khôi phục bộ Banner Slide mặc định!');
}

/* ===== Quản lý Danh sách đăng ký nhận ưu đãi & Cấu hình SMTP ===== */
let subSearchQ = '';
if (!window.PG) window.PG = {};
if (window.PG.subs === undefined) window.PG.subs = 0;

function openSubscribersModal() {
  const subs = Array.isArray(S.subscribers) ? S.subscribers : [];
  window.PG.subs = 0;
  dlg(`
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;border-bottom:1px solid var(--bd);padding-bottom:10px">
      <h3 style="margin:0;font-size:18px"><i class="fa-solid fa-envelope-open-text" style="color:var(--hp-gold,#b8863b)"></i> Danh sách khách đăng ký nhận ưu đãi (<span id="sub-modal-count">${subs.length}</span>)</h3>
      <button class="ib x" onclick="dx()" title="Đóng"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:14px;flex-wrap:wrap">
      <div style="position:relative;flex:1 1 240px;min-width:180px">
        <input id="sub-q" placeholder="Tìm theo địa chỉ email..." value="${esc(subSearchQ)}" oninput="subSearchQ=this.value;PG.subs=0;renderSubTable()" style="width:100%;box-sizing:border-box">
      </div>
      <div class="sub-modal-acts" style="display:flex;gap:8px;flex-wrap:wrap">
        <button type="button" onclick="copyAllSubEmails()"><i class="fa-solid fa-copy"></i> Sao chép toàn bộ email</button>
        <button type="button" class="p" onclick="exportSubCsv()"><i class="fa-solid fa-file-excel"></i> Xuất file Excel / CSV</button>
      </div>
    </div>
    <div id="sub-table-container" style="overflow-x:auto;-webkit-overflow-scrolling:touch;width:100%">
      ${renderSubscribersTableHtml()}
    </div>
  `, '850px');
}

function renderSubscribersTableHtml() {
  const subs = Array.isArray(S.subscribers) ? S.subscribers : [];
  const q = (subSearchQ || '').trim().toLowerCase();
  const filtered = q ? subs.filter(s => (s.email && s.email.toLowerCase().includes(q)) || (s.id && s.id.toLowerCase().includes(q))) : subs;

  if (!filtered.length) {
    return `<div style="text-align:center;padding:40px 20px;color:var(--mut)">
      <div style="font-size:36px;margin-bottom:10px;color:var(--mut)"><i class="fa-solid fa-inbox"></i></div>
      <p style="margin:0;font-size:15px;font-weight:600">${q ? 'Không tìm thấy email nào khớp với từ khóa.' : 'Chưa có khách hàng nào đăng ký nhận ưu đãi.'}</p>
      <small style="color:var(--mut)">Các email khách đăng ký từ chân trang chủ sẽ xuất hiện tại đây.</small>
    </div>`;
  }

  const pageSize = 6;
  const pc = Math.max(1, Math.ceil(filtered.length / pageSize));
  PG.subs = Math.max(0, Math.min(PG.subs || 0, pc - 1));
  const start = PG.subs * pageSize;
  const pageRows = filtered.slice(start, start + pageSize);

  return `
    <table class="sub-table" style="width:100%;border-collapse:collapse;font-size:13.5px">
      <thead>
        <tr style="border-bottom:2px solid var(--bd);text-align:left">
          <th class="sub-col-stt" style="padding:10px 8px;width:46px;text-align:center">STT</th>
          <th class="sub-col-email" style="padding:10px 8px">Email khách hàng</th>
          <th class="sub-hide-mobile" style="padding:10px 8px;width:160px">Thời gian đăng ký</th>
          <th class="sub-hide-mobile" style="padding:10px 8px;width:110px">Địa chỉ IP</th>
          <th class="sub-col-actions" style="padding:10px 8px;text-align:center;width:90px">Thao tác</th>
        </tr>
      </thead>
      <tbody>
        ${pageRows.map((s, idx) => {
          const globalIdx = start + idx + 1;
          const timeStr = s.t ? new Date(s.t).toLocaleString('vi-VN') : '—';
          return `
            <tr style="border-bottom:1px solid var(--bd)">
              <td class="sub-col-stt" style="padding:10px 8px;text-align:center;color:var(--mut)">${globalIdx}</td>
              <td class="sub-col-email" style="padding:10px 8px;font-weight:600;min-width:0">
                <a href="mailto:${esc(s.email)}" style="color:inherit;text-decoration:none;word-break:break-all" title="Nhấp để soạn email gửi cho khách">
                  <i class="fa-regular fa-envelope" style="margin-right:6px;color:var(--hp-gold,#b8863b)"></i>${esc(s.email)}
                </a>
                <div class="sub-meta-mobile" style="font-size:12px;color:var(--mut);margin-top:3px;font-weight:400;line-height:1.3">
                  <i class="fa-regular fa-clock" style="margin-right:3px"></i>${timeStr}<span style="margin:0 5px">·</span>IP: ${esc(s.ip || '—')}
                </div>
              </td>
              <td class="sub-hide-mobile" style="padding:10px 8px;color:var(--mut);white-space:nowrap">${timeStr}</td>
              <td class="sub-hide-mobile" style="padding:10px 8px;font-size:12.5px;color:var(--mut);white-space:nowrap">${esc(s.ip || '—')}</td>
              <td class="sub-col-actions" style="padding:10px 8px;text-align:center;white-space:nowrap">
                <a href="mailto:${esc(s.email)}" class="ib" title="Gửi email cho khách" style="margin-right:4px"><i class="fa-solid fa-paper-plane" style="color:#1565c0"></i></a>
                <button type="button" class="ib x" onclick="delSubscriber('${esc(s.email)}')" title="Xóa email này"><i class="fa-solid fa-trash-can"></i></button>
              </td>
            </tr>
          `;
        }).join('')}
      </tbody>
    </table>
    <div style="margin-top:8px">
      ${pgBarF(filtered.length, pageSize, PG.subs, 'khách', 'PG.subs', 'renderSubTable()')}
    </div>
  `;
}

function renderSubTable() {
  const container = document.getElementById('sub-table-container');
  if (container) container.innerHTML = renderSubscribersTableHtml();
  const countEl = document.getElementById('sub-modal-count');
  if (countEl && Array.isArray(S.subscribers)) countEl.textContent = S.subscribers.length;
}

async function delSubscriber(email) {
  if (!confirm(`Bạn có chắc muốn xóa email "${email}" khỏi danh sách nhận ưu đãi?`)) return;
  try {
    const res = await jf('/api/subscribers?email=' + encodeURIComponent(email), {
      method: 'DELETE',
      headers: { 'x-token': tok }
    });
    if (res.ok) {
      if (Array.isArray(S.subscribers)) {
        S.subscribers = S.subscribers.filter(s => s.email !== email);
      }
      save();
      renderSubTable();
      toast('Đã xóa ' + email, 'ok');
    } else {
      alert((res.j && res.j.error) || 'Không thể xóa email này.');
    }
  } catch (_) {
    alert('Lỗi kết nối máy chủ khi xóa.');
  }
}

function copyAllSubEmails() {
  const subs = Array.isArray(S.subscribers) ? S.subscribers : [];
  if (!subs.length) return alert('Danh sách hiện đang trống.');
  const emails = subs.map(s => s.email).filter(Boolean).join(', ');
  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(emails).then(() => {
      toast(`Đã sao chép ${subs.length} địa chỉ email vào bộ nhớ tạm!`, 'ok', 6000);
    }).catch(() => {
      prompt('Sao chép danh sách email bên dưới:', emails);
    });
  } else {
    prompt('Sao chép danh sách email bên dưới:', emails);
  }
}

async function exportSubCsv() {
  try {
    const res = await fetch('/api/subscribers/export', {
      headers: { 'x-token': tok || '' }
    });
    if (!res.ok) return alert('Không thể xuất file lúc này.');
    const blob = await res.blob();
    const url = window.URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `danh_sach_nhan_uu_dai_${new Date().toISOString().slice(0,10)}.csv`;
    document.body.appendChild(a);
    a.click();
    a.remove();
    window.URL.revokeObjectURL(url);
    toast('Đã tải xuống tệp danh sách Excel/CSV thành công.', 'ok');
  } catch (_) {
    alert('Lỗi tải tệp.');
  }
}

function applySmtpPreset(preset) {
  const hostEl = $('#cs_smtp_host');
  const portEl = $('#cs_smtp_port');
  if (!preset || !hostEl || !portEl) return;
  if (preset === 'gmail') {
    hostEl.value = 'smtp.gmail.com';
    portEl.value = '465';
  } else if (preset === 'outlook') {
    hostEl.value = 'smtp-mail.outlook.com';
    portEl.value = '587';
  } else if (preset === 'hostinger') {
    hostEl.value = 'smtp.hostinger.com';
    portEl.value = '465';
  }
}

function toggleSmtpGuide() {
  const box = $('#smtp-guide-box');
  if (!box) return;
  box.style.display = box.style.display === 'none' ? 'block' : 'none';
}

async function testSmtp() {
  const host = ($('#cs_smtp_host')?.value || '').trim() || 'smtp.gmail.com';
  const port = parseInt($('#cs_smtp_port')?.value || '465', 10) || 465;
  const user = ($('#cs_smtp_user')?.value || '').trim();
  const pass = ($('#cs_smtp_pass')?.value || '').trim();
  const fromName = ($('#cs_smtp_from')?.value || '').trim() || (S.cfg.name || 'Hương Vị Việt');
  const adminEmail = ($('#cs_smtp_admin')?.value || '').trim() || (S.cfg.email || user);

  if (!user) return alert('Vui lòng nhập Email gửi / Tài khoản SMTP (VD: nhahang@gmail.com).');
  if (!pass) return alert('Vui lòng nhập Mật khẩu ứng dụng (App Password) của email gửi.');
  if (!adminEmail) return alert('Vui lòng nhập Email Admin nhận thông báo.');

  const btn = $('#btn-test-smtp');
  const oldBtnHtml = btn ? btn.innerHTML : '';
  if (btn) {
    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Đang gửi thử email...';
  }

  try {
    const res = await jf('/api/email/test', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'x-token': tok },
      body: JSON.stringify({
        smtp: {
          host,
          port,
          secure: port === 465,
          user,
          pass,
          fromName,
          adminEmail
        },
        targetEmail: adminEmail
      })
    });

    if (res.ok && res.j && res.j.success) {
      alert(res.j.message);
      toast(res.j.message, 'ok', 9000);
    } else {
      const err = (res.j && res.j.error) || 'Gửi email thử nghiệm thất bại.';
      alert('Kiểm tra email thất bại:\n' + err + '\n\nLưu ý: Với Gmail, bạn cần bật Xác minh 2 bước và tạo Mật khẩu ứng dụng (App Password) 16 ký tự để điền vào ô Mật khẩu.');
      toast(err, 'err', 10000);
    }
  } catch (e) {
    alert('Lỗi kết nối máy chủ: ' + e.message);
  } finally {
    if (btn) {
      btn.disabled = false;
      btn.innerHTML = oldBtnHtml;
    }
  }
}

