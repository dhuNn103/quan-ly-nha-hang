          <p style="font-size:15.5px;line-height:1.8;color:#4a4034;text-align:justify">${hpT('chefDesc', 'Người xưa có câu "Bát ngát phong vị là bởi người đầu bếp có tâm". Tại ' + esc(restNameDisplay) + ', mỗi món ăn từ nồi nước dùng hầm xương trên 12 tiếng đến đĩa rau ghém giòn mát đều trải qua quá trình nêm nếm nghiêm ngặt, giữ trọn vị ngọt tự nhiên không ph��� thuộc mì chính hay hương liệu nhân tạo.')}</p>
          <div class="hp-aboutpage-chef-quote">
            <p id="hp-chef-quote-text" data-full-text="${esc(hpT('chefQuote', '"Ẩm thực không đơn thuần là bữa ăn no, mà là phương tiện chuyên chở tình cảm, kết nối con người và lưu giữ văn hóa nguồn cội."'))}">${esc(hpT('chefQuote', '"Ẩm thực không đơn thuần là bữa ăn no, mà là phương tiện chuyên chở tình cảm, kết nối con người và lưu giữ văn hóa nguồn cội."'))}</p>
            <span class="hp-chef-quote-author">${hpT('chefAuthor', '— Bếp Trưởng Nhà Hàng ' + esc(restNameDisplay))}</span>
          </div>
        </div>
