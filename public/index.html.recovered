function hpT(key, fallback = '') {
  const dict = HP_TRANSLATIONS[hpLang] || HP_TRANSLATIONS.vi;
  return (dict && dict[key] !== undefined) ? dict[key] : (fallback || key);
}

function hpTranslateCat(cat) {
  if (hpLang !== 'en') return cat;
  const map = {
    'all': 'All Menu',
    'Tất cả': 'All Dishes',
    'Tất cả thực đơn': 'All Menu',
    'Khai vị': 'Appetizers',
    'Món chính': 'Main Courses',
    'Món nướng & Lẩu': 'BBQ & Hotpot',
    'Món phụ': 'Side Dishes',
    'Tráng miệng': 'Desserts',
    'Đồ uống': 'Beverages',
    'Khác': 'Other',
    'Đồ Trung': 'Chinese Cuisine',
    'Đồ Á': 'Asian Cuisine',
    'Đồ Âu': 'Western Cuisine',
    'Hải sản': 'Seafood',
    'Ăn vặt': 'Snacks',
    'Đặc sản': 'Specialties'
  };
  return map[cat] || cat;
}

