];

function getHpFeatures(forEditor = false) {
  const saved = (Array.isArray(S.cfg.hpFeatures) && S.cfg.hpFeatures.length === 4) ? S.cfg.hpFeatures : null;
  if (!forEditor && hpLang === 'en') {
    return HP_DEFAULT_FEATURES_EN.map((enItem, i) => {
      if (!saved) return { ...enItem };
      const viDef = HP_DEFAULT_FEATURES_VI[i];
      const cur = saved[i] || {};
      const t = (cur.title || '').trim();
      const d = (cur.desc || '').trim();
      const isDefaultTitle = !t || t === viDef.title || t === enItem.title;
      const isDefaultDesc = !d || d === viDef.desc || d === enItem.desc;
      return {
        title: isDefaultTitle ? enItem.title : t,
        desc: isDefaultDesc ? enItem.desc : d
      };
    });
  }
  if (!saved) return HP_DEFAULT_FEATURES_VI.map(f => ({ ...f }));
  return saved.map((cur, i) => {
    const viDef = HP_DEFAULT_FEATURES_VI[i];
    const enDef = HP_DEFAULT_FEATURES_EN[i];
    const t = (cur && cur.title ? cur.title : '').trim();
    const d = (cur && cur.desc ? cur.desc : '').trim();
    return {
      title: (!t || t === enDef.title) ? viDef.title : t,
      desc: (!d || d === enDef.desc) ? viDef.desc : d
    };
  });
}

