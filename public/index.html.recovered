html[data-dev=phone] .v2-fields label{flex:0 0 100%!important;gap:10px!important}
html[data-dev=phone] .v2-fields label input{flex:1 1 auto!important;min-width:0!important;width:auto!important}
html[data-dev=phone] .lg-clr{flex:0 0 100%!important;display:flex!important;justify-content:flex-end!important}
</style>`);
/* ===== Bổ sung v82: điện thoại: ô ngày và ô tháng trong bộ lọc nhật ký cao 42px ===== */
document.head.insertAdjacentHTML('beforeend',`<style>
html[data-dev=phone] .v2-fields label input{height:42px!important;min-height:42px!important;box-sizing:border-box!important}
</style>`);
/* ===== Bổ sung v83: nút phân trang ở mọi trang 30×30px ===== */
document.head.insertAdjacentHTML('beforeend',`<style>
.pgb{width:30px!important;height:30px!important;min-width:30px!important;min-height:30px!important;max-width:30px!important;max-height:30px!important;padding:0!important}
</style>`);
/* ===== Bổ sung v84: nút phân trang lịch sử ca 30×30px ===== */
document.head.insertAdjacentHTML('beforeend',`<style>
.cs-pg button{width:30px!important;height:30px!important;min-width:30px!important;min-height:30px!important;max-width:30px!important;max-height:30px!important;padding:0!important}
</style>`);
/* ===== Bổ sung v85: điện thoại: nút Thêm / quản lý bàn căn bên trái ===== */
document.head.insertAdjacentHTML('beforeend',`<style>
html[data-dev=phone] .v2-head>div:last-child:not(:first-child){justify-content:flex-start!important}
</style>`);
/* ===== Bổ sung v88: Quản lý tài khoản — sửa thông tin, chức vụ, trạng thái làm việc, liên hệ; xóa hoặc ngừng hoạt động có điều kiện ===== */
document.head.insertAdjacentHTML('beforeend',`<style>
.uf{display:flex;flex-direction:column;gap:4px;margin-bottom:8px;font-size:14px;color:var(--mut);text-align:left}
.uf input,.uf select{width:100%;box-sizing:border-box}
</style>`);
const WSM={working:'Đang làm việc',leave:'Nghỉ phép',absent:'Vắng mặt'},ASM={active:'Đang hoạt động',locked:'Đã khóa',off:'Ngừng hoạt động'};
function uPolicyOk(p){return /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z0-9]).{8,}$/.test(p)}
function isMe(u){return !!me&&me.u==u.u}
function uOtherActiveAdmins(i){return S.users.filter((x,j)=>j!=i&&x.role=='admin'&&x.st=='active').length}
function uLastLogin(u){const l=(S.log||[]).filter(x=>x.by==u.name&&x.a=='Đăng nhập').pop();return l?new Date(l.t).toLocaleString('vi-VN',{hour:'2-digit',minute:'2-digit',day:'2-digit',month:'2-digit',year:'numeric'}):'Chưa đăng nhập'}
function uHasHist(u){const parts=Object.entries(S).filter(([k])=>k!='users').map(([,v])=>v);return JSON.stringify(parts).includes('"by":'+JSON.stringify(u.name))}
function setU(i,s){const u=S.users[i];if(!u)return;
if(s!='active'&&isMe(u))return alert('Không thể khóa hoặc ngừng hoạt động tài khoản đang đăng nhập.');
if(s!='active'&&u.role=='admin'&&u.st=='active'&&uOtherActiveAdmins(i)==0)return alert('Không thể khóa admin cuối cùng đang hoạt động.');
u.st=s;save();render()}
function reU(i){const u=S.users[i];if(!u)return;u.st='active';save();logA('Kích hoạt tài khoản',u.name);render()}
function addU(){const n=$('#sn').value.trim(),u=$('#su').value.trim(),p=$('#sp').value;if(!n||!u)return alert('Nhập họ tên và tên đăng nhập.');if(S.users.some(x=>x.u==u))return alert('Tên đăng nhập đã tồn tại.');if(!uPolicyOk(p))return alert('Mật khẩu chưa đạt: tối thiểu 8 ký tự, đủ chữ hoa, chữ thường, số, ký tự đặc biệt.');S.users.push({name:n,u,p,role:$('#sr').value,st:'active',t:Date.now(),ws:'working',ph:'',em:'',ad:''});save();logA('Tạo tài khoản',n);render()}
function editU(i){const u=S.users[i];if(!u)return;
const opts=(o,v)=>Object.entries(o).map(([k,l])=>`<option value=${k} ${k==v?'selected':''}>${l}</option>`).join('');
dlg(`<h4 style="margin:0 0 10px">Sửa tài khoản</h4>
<label class=uf>Họ và tên<input id=eu_n value="${esc(u.name)}"></label>
<label class=uf>Tên đăng nhập<input id=eu_u value="${esc(u.u)}"></label>
<label class=uf>Chức vụ<select id=eu_r>${opts(R,u.role)}</select></label>
<label class=uf>Trạng thái làm việc<select id=eu_w>${opts(WSM,u.ws||'working')}</select></label>
<label class=uf>Số điện thoại<input id=eu_ph value="${esc(u.ph||'')}"></label>
<label class=uf>Email<input id=eu_em value="${esc(u.em||'')}"></label>
<label class=uf>Địa chỉ<input id=eu_ad value="${esc(u.ad||'')}"></label>
<label class=uf>Mật khẩu mới (để trống nếu không đổi)<input id=eu_p type=password></label>
<div class=row style="margin-top:10px"><button onclick="dx()">Hủy</button><button class=p onclick="saveU(${i})">Lưu</button></div>`);
const bx=$('#dlg>.box');if(bx)bx.style.width='min(520px,100%)'}
function saveU(i){const u=S.users[i];if(!u)return;
const n=$('#eu_n').value.trim(),nu=$('#eu_u').value.trim(),r=$('#eu_r').value,w=$('#eu_w').value,ph=$('#eu_ph').value.trim(),em=$('#eu_em').value.trim(),ad=$('#eu_ad').value.trim(),np=$('#eu_p').value;
if(!n||!nu)return alert('Nhập họ tên và tên đăng nhập.');
if(S.users.some((x,j)=>j!=i&&x.u==nu))return alert('Tên đăng nhập đã tồn tại.');
if(ph&&!/^[0-9+ ]{8,15}$/.test(ph))return alert('Số điện thoại không hợp lệ (8 đến 15 chữ số).');
if(em&&!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(em))return alert('Email không hợp lệ.');
if(np&&!uPolicyOk(np))return alert('Mật khẩu mới chưa đạt: tối thiểu 8 ký tự, đủ chữ hoa, chữ thường, số, ký tự đặc biệt.');
if(r!=u.role){
 if(isMe(u)&&u.role=='admin'&&r!='admin')return alert('Không thể đổi chức vụ admin của chính bạn.');
 if(u.role=='admin'&&u.st=='active'&&uOtherActiveAdmins(i)==0)return alert('Không thể đổi chức vụ admin cuối cùng đang hoạt động.');}
Object.assign(u,{name:n,u:nu,role:r,ws:w,ph,em,ad});if(np)u.p=np;
save();logA('Sửa tài khoản',n);dx();render()}
function delU(i){const u=S.users[i];if(!u)return;
if(isMe(u))return alert('Không thể xóa hoặc ngừng hoạt động tài khoản đang đăng nhập.');
if(u.role=='admin'&&u.st=='active'&&uOtherActiveAdmins(i)==0)return alert('Không thể xóa hoặc ngừng admin cuối cùng đang hoạt động.');
if(uHasHist(u)){ask(`Tài khoản "${u.name}" đã có lịch sử hoạt động nên không thể xóa. Ngừng hoạt động tài khoản này? Tài khoản sẽ không đăng nhập được và lịch sử được giữ nguyên.`,()=>{u.st='off';save();logA('Ngừng hoạt động',u.name);render()});return}
ask(`Xóa vĩnh viễn tài khoản "${u.name}"? Tài khoản chưa có lịch sử hoạt động nên có thể xóa.`,()=>{const k=S.users.indexOf(u);if(k>=0)S.users.splice(k,1);save();logA('Xóa tài khoản',u.name);render()})}
PAGES.staff=()=>{const st=pg('staff',S.users.length,10),rows=S.users.map((u,i)=>[u,i]).slice(st,st+10);return`<div><h3 style="margin:0 0 2px">Quản lý tài khoản</h3><div class=v2-sub>Theo dõi nhân sự và phân quyền sử dụng</div></div><div class="box stf"><input id=sn placeholder="Họ và tên"> <input id=su placeholder="Tên đăng nhập"> <select id=sr>${Object.entries(R).map(([k,v])=>`<option value=${k}>${v}</option>`).join('')}</select> <input id=sp type=password placeholder="Mật khẩu khởi tạo"> <button class=p onclick="addU()">Tạo tài khoản</button><div class=tag>Mật khẩu tối thiểu 8 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt.</div></div><div class="rc" style="padding:0;overflow:hidden"><div class=sc><table><tr><th>Họ tên</th><th>Đăng nhập</th><th>Mật khẩu</th><th>Chức vụ</th><th>Trạng thái làm việc</th><th>Trạng thái tài khoản</th><th>Liên hệ</th><th>Đăng nhập gần nhất</th><th>Ngày tạo</th><th></th></tr>${rows.map(([u,i])=>`<tr style="${u.st!='active'?'color:var(--mut);opacity:.65':''}"><td>${esc(u.name)}</td><td>${esc(u.u)}</td><td><span id=pw${i}>••••••••</span> <button class=ib title="Hiện / ẩn mật khẩu" onclick="togPw(${i})"><i class="fa-solid fa-eye"></i></button></td><td>${R[u.role]}</td><td>${WSM[u.ws||'working']}</td><td>${ASM[u.st]||u.st}</td><td>${esc(u.ph||'—')}${u.em?`<br><small>${esc(u.em)}</small>`:''}</td><td>${uLastLogin(u)}</td><td>${new Date(u.t).toLocaleDateString('vi-VN')}</td><td style="white-space:nowrap"><button class=ib title="Sửa tài khoản" onclick="editU(${i})"><i class="fa-solid fa-pen"></i></button>${u.role=='admin'?'':(u.st=='active'?` <button onclick="setU(${i},'locked')">Khóa</button>`:u.st=='locked'?` <button onclick="setU(${i},'active')">Mở khóa</button>`:` <button onclick="reU(${i})">Kích hoạt</button>`)}${isMe(u)?'':` <button class="ib x" title="Xóa hoặc ngừng hoạt động" onclick="delU(${i})"><i class="fa-solid fa-trash-can"></i></button>`}</td></tr>`).join('')||'<tr><td colspan=10 class=mut>Chưa có tài khoản nào.</td></tr>'}</table></div>${pgBar(S.users.length,10,PG.staff,'tài khoản','PG.staff')}</div>`};
/* ===== Bổ sung v89: Chấm công — vào/ra ca, lịch sử, thống kê công, duyệt và chỉnh sửa công ===== */
const attF={uid:'',month:'',date:''};
document.head.insertAdjacentHTML('beforeend',`<style>
.attk{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px}
.attk div{background:var(--card);border:1px solid var(--bd);border-radius:12px;padding:12px;min-width:0}
.attk small{color:var(--mut);display:block}
.attk b{display:block;font-size:20px;color:var(--fg)}
.att-btns{display:flex;gap:10px;flex-wrap:wrap;margin-top:10px}
.att-bar{display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end;margin-bottom:10px}
.att-bar label{display:flex;flex-direction:column;gap:4px;font-size:14px;color:var(--mut)}
</style>`);
function attList(){S.att=S.att||[];return S.att}
function attCfg(){S.cfg.att=S.cfg.att||{start:'08:00',end:'17:00',grace:10,std:8};return S.cfg.att}
function attAdmin(){return !!me&&me.role=='admin'}
function attCanView(){return !!me&&(me.role=='admin'||me.role=='manager')}
function ymd(t){const d=new Date(t);return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')}
function hmOf(t){if(!t)return '—';const d=new Date(t);return String(d.getHours()).padStart(2,'0')+':'+String(d.getMinutes()).padStart(2,'0')}
function atOn(date,hm){const [y,m,d]=date.split('-').map(Number),[hh,mm]=hm.split(':').map(Number);return new Date(y,m-1,d,hh,mm,0,0).getTime()}
function dmy(s){if(!s)return '—';if(s instanceof Date)return String(s.getDate()).padStart(2,'0')+'/'+String(s.getMonth()+1).padStart(2,'0')+'/'+s.getFullYear();if(typeof s==='number'){const dt=new Date(s);return String(dt.getDate()).padStart(2,'0')+'/'+String(dt.getMonth()+1).padStart(2,'0')+'/'+dt.getFullYear()}const p=String(s).split('-');return p.length===3?p[2]+'/'+p[1]+'/'+p[0]:String(s)}
function fmtH(h){if(!h)return '0h00';const hh=Math.floor(h),mm=Math.round((h-hh)*60);return hh+'h'+String(mm).padStart(2,'0')}
function attCalc(r){const c=attCfg();r.late=0;r.early=0;r.hours=0;r.ot=0;
 if(r.inAt){r.late=Math.max(0,Math.round((r.inAt-atOn(r.date,c.start))/6e4))}
 if(r.outAt){r.early=Math.max(0,Math.round((atOn(r.date,c.end)-r.outAt)/6e4));r.hours=Math.max(0,(r.outAt-r.inAt)/36e5);r.ot=Math.max(0,r.hours-c.std)}
 r.hours=Math.round(r.hours*100)/100;r.ot=Math.round(r.ot*100)/100;return r}
function attOpenOf(uid){return attList().find(r=>r.uid==uid&&!r.outAt)}
function attWorkDays(month){const [y,m]=month.split('-').map(Number),last=new Date(y,m,0).getDate(),today=ymd(Date.now()),out=[];
 for(let d=1;d<=last;d++){const dt=new Date(y,m-1,d),s=ymd(dt.getTime());if(s>=today)break;if(dt.getDay()===0)continue;out.push(s)}return out}
function attAbsent(month,uid){const days=attWorkDays(month),res=[],recs=attList();
 S.users.filter(u=>u.st!='off'&&(!uid||u.u==uid)).forEach(u=>{const joined=ymd(u.t);days.forEach(d=>{if(d<joined)return;if(!recs.some(r=>r.uid==u.u&&r.date==d))res.push({uid:u.u,name:u.name,date:d})})});return res}
function attStats(month,uid){const c=attCfg(),recs=attList().filter(r=>(!uid||r.uid==uid)&&r.date.startsWith(month)&&r.outAt);
 return{days:recs.length,hours:recs.reduce((s,r)=>s+r.hours,0),late:recs.filter(r=>r.late>c.grace).length,absent:attAbsent(month,uid).length,ot:recs.reduce((s,r)=>s+r.ot,0)}}
function attStatus(r,today){const c=attCfg(),t=[];
 if(!r.outAt&&r.date<today)t.push('Quên kết thúc ca');
 if(!r.outAt&&r.date==today)t.push('Đang trong ca');
 if(r.late>c.grace)t.push('Đi muộn');
 if(r.outAt&&r.early>0)t.push('Về sớm');
 if(r.status=='manual')t.push('Xác nhận quên chấm công');
 if(r.status=='adjusted')t.push('Đã điều chỉnh');
 return t.length?t.join(', '):(r.outAt?'Đúng giờ':'—')}
function attEditInfo(r){const e=(r.edits||[]);if(!e.length)return '—';const l=e[e.length-1];return `${esc(l.by)} · ${hmOf(l.at)} ${dmy(ymd(l.at))}<br><small>${esc(l.reason)}</small>`}
function attStart(){if(!me)return;const now=Date.now(),td=ymd(now);
 if(attOpenOf(me.u))return alert('Bạn đang trong ca làm việc.');
 if(attList().some(r=>r.uid==me.u&&r.date==td&&r.outAt))return alert('Hôm nay bạn đã kết thúc ca. Liên hệ admin nếu cần điều chỉnh.');
 attList().push(attCalc({id:'AT'+(S.seq++),uid:me.u,name:me.name,date:td,inAt:now,outAt:null,src:'self',status:'open',note:'',edits:[]}));
 save();logA('Bắt đầu ca',me.name);render()}
function attEnd(){const r=me&&attOpenOf(me.u);if(!r)return alert('Bạn chưa bắt đầu ca.');
 r.outAt=Date.now();r.status='closed';attCalc(r);save();logA('Kết thúc ca',me.name);render()}
function attEditOpen(id){if(!attAdmin())return;const r=attList().find(x=>x.id==id);if(!r)return;
 dlg(`<h4 style="margin:0 0 10px">Điều chỉnh công</h4>
<div class=uf>Nhân viên<b>${esc(r.name)}</b></div>
<div class=uf>Ngày<b>${dmy(r.date)}</b></div>
<label class=uf>Giờ vào<input type=time id=ae_in value="${r.inAt?hmOf(r.inAt):''}"></label>
<label class=uf>Giờ ra (để trống nếu chưa kết thúc ca)<input type=time id=ae_out value="${r.outAt?hmOf(r.outAt):''}"></label>
<label class=uf>Lý do chỉnh sửa (bắt buộc)<input id=ae_rs></label>
<div class=row style="margin-top:10px"><button onclick="dx()">Hủy</button><button class=p onclick="attSaveEdit('${id}')">Lưu</button></div>`);
 const bx=$('#dlg>.box');if(bx)bx.style.width='min(520px,100%)'}
function attSaveEdit(id){if(!attAdmin())return;const r=attList().find(x=>x.id==id);if(!r)return;
 const vin=$('#ae_in').value,vout=$('#ae_out').value,rs=$('#ae_rs').value.trim();
 if(!vin)return alert('Nhập giờ vào.');if(!rs)return alert('Nhập lý do chỉnh sửa.');
 const from={in:r.inAt?hmOf(r.inAt):'',out:r.outAt?hmOf(r.outAt):''};
 const inAt=atOn(r.date,vin),outAt=vout?atOn(r.date,vout):null;
 if(outAt&&outAt<=inAt)return alert('Giờ ra phải sau giờ vào.');
 r.inAt=inAt;r.outAt=outAt;r.status=outAt?'adjusted':'open';
 r.edits=r.edits||[];r.edits.push({by:me.name,at:Date.now(),reason:rs,from,to:{in:vin,out:vout||''}});
 attCalc(r);save();logA('Điều chỉnh công',r.name);dx();render()}
function attManualOpen(uid,date){if(!attAdmin())return;const u=S.users.find(x=>x.u==uid);if(!u)return;const c=attCfg();
 dlg(`<h4 style="margin:0 0 10px">Xác nhận quên chấm công</h4>
<div class=uf>Nhân viên<b>${esc(u.name)}</b></div>
<div class=uf>Ngày<b>${dmy(date)}</b></div>
<label class=uf>Giờ vào<input type=time id=am_in value="${c.start}"></label>
<label class=uf>Giờ ra<input type=time id=am_out value="${c.end}"></label>
<label class=uf>Lý do xác nhận (bắt buộc)<input id=am_rs></label>
<div class=row style="margin-top:10px"><button onclick="dx()">Hủy</button><button class=p onclick="attSaveManual('${uid}','${date}')">Xác nhận</button></div>`);
 const bx=$('#dlg>.box');if(bx)bx.style.width='min(520px,100%)'}
function attSaveManual(uid,date){if(!attAdmin())return;const u=S.users.find(x=>x.u==uid);if(!u)return;
 const vin=$('#am_in').value,vout=$('#am_out').value,rs=$('#am_rs').value.trim();
 if(!vin||!vout)return alert('Nhập đủ giờ vào và giờ ra.');if(!rs)return alert('Nhập lý do xác nhận.');
 if(date>=ymd(Date.now()))return alert('Chỉ xác nhận công cho ngày đã qua.');
 const inAt=atOn(date,vin),outAt=atOn(date,vout);if(outAt<=inAt)return alert('Giờ ra phải sau giờ vào.');
 attList().push(attCalc({id:'AT'+(S.seq++),uid,name:u.name,date,inAt,outAt,src:'admin',status:'manual',note:rs,edits:[{by:me.name,at:Date.now(),reason:rs,from:null,to:{in:vin,out:vout}}]}));
 save();logA('Xác nhận quên chấm công',u.name);dx();render()}
function attSaveCfg(){if(!attAdmin())return;const c=attCfg();
 const s=$('#ac_s').value,e=$('#ac_e').value,g=Math.max(0,+$('#ac_g').value||0),hh=Math.max(1,+$('#ac_h').value||8);
 if(!s||!e||s>=e)return alert('Giờ kết thúc ca phải sau giờ vào ca.');
 c.start=s;c.end=e;c.grace=g;c.std=hh;attList().forEach(r=>attCalc(r));save();logA('Cấu hình công',s+' – '+e);render()}
function attSet(k,v){attF[k]=v;render()}
PAGES.attendance=()=>{
 const today=ymd(Date.now()),month=attF.month||today.slice(0,7),view=attCanView(),c=attCfg(),adm=attAdmin();
 const uid=view?attF.uid:me.u;
 const users=S.users.filter(u=>u.st=='active');
 const mine=attOpenOf(me.u),myToday=attList().find(r=>r.uid==me.u&&r.date==today&&r.outAt);
 const myStatus=mine?`Đang trong ca (vào ${hmOf(mine.inAt)})`:myToday?`Đã kết thúc ca (${hmOf(myToday.inAt)} – ${hmOf(myToday.outAt)})`:'Chưa chấm công hôm nay';
 const recs=attList().filter(r=>(!uid||r.uid==uid)&&r.date.startsWith(month)&&(!attF.date||r.date==attF.date)).sort((a,b)=>b.date.localeCompare(a.date)||a.inAt-b.inAt);
 const st=attStats(month,uid);
 const openRows=attList().filter(r=>!r.outAt&&r.date<today&&(!uid||r.uid==uid)).map(r=>`<tr><td>${dmy(r.date)}</td><td>${esc(r.name)}</td><td>Quên kết thúc ca (vào ${hmOf(r.inAt)})</td><td><button onclick="attEditOpen('${r.id}')">Điều chỉnh</button></td></tr>`).join('');
 const absRows=attAbsent(month,uid).slice(0,50).map(a=>`<tr><td>${dmy(a.date)}</td><td>${esc(a.name)}</td><td>Chưa có chấm công</td><td><button class=p onclick="attManualOpen('${a.uid}','${a.date}')">Xác nhận quên chấm công</button></td></tr>`).join('');
 return`<div><h3 style="margin:0 0 2px">Chấm công</h3><div class=v2-sub>Ghi nhận giờ vào ra, theo dõi đi muộn, về sớm và thống kê công</div></div>
<section class=v2w-panel><div class=v2w-ph><h4>Chấm công của tôi</h4></div>
<div><b>Hôm nay ${dmy(today)}:</b> ${myStatus}</div>
<div class=att-btns><button class=p ${mine||myToday?'disabled':''} onclick="attStart()"><i class="fa-solid fa-play"></i> Bắt đầu ca</button><button class=p ${mine?'':'disabled'} onclick="attEnd()"><i class="fa-solid fa-stop"></i> Kết thúc ca</button></div></section>
${view?`<section class=v2w-panel><div class=v2w-ph><h4>Kiểm tra chấm công hôm nay</h4><span class=v2-cnt>${users.length} nhân viên</span></div>
<div class="rc" style="padding:0;overflow:hidden"><div class=sc><table><tr><th>Nhân viên</th><th>Chức vụ</th><th>Trạng thái</th></tr>${users.map(u=>{const r=attList().find(x=>x.uid==u.u&&x.date==today);const s=r?(r.outAt?`Đã kết thúc ca (${hmOf(r.inAt)} – ${hmOf(r.outAt)})`:`Đang trong ca (vào ${hmOf(r.inAt)})`):'Chưa chấm công';return `<tr><td>${esc(u.name)}</td><td>${R[u.role]}</td><td>${s}</td></tr>`}).join('')}</table></div></div></section>`:''}
<section class=v2w-panel><div class=v2w-ph><h4>Thống kê công</h4></div>
<div class=att-bar>${view?`<label>Nhân viên<select onchange="attSet('uid',this.value)"><option value="">Tất cả nhân viên</option>${users.map(u=>`<option value="${u.u}" ${u.u==uid?'selected':''}>${esc(u.name)}</option>`).join('')}</select></label>`:''}<label>Tháng<input type=month value="${month}" onchange="attSet('month',this.value)"></label><label>Ngày<input type=date value="${attF.date}" onchange="attSet('date',this.value)"></label></div>
<div class=attk><div><small>Ngày công</small><b>${st.days}</b></div><div><small>Giờ làm</small><b>${fmtH(st.hours)}</b></div><div><small>Đi muộn</small><b>${st.late}</b></div><div><small>Nghỉ</small><b>${st.absent}</b></div><div><small>Tăng ca</small><b>${fmtH(st.ot)}</b></div></div></section>
<section class=v2w-panel><div class=v2w-ph><h4>Lịch sử chấm công</h4><span class=v2-cnt>${recs.length} dòng</span></div>
<div class="rc" style="padding:0;overflow:hidden"><div class=sc><table><tr><th>Ngày</th><th>Nhân viên</th><th>Vào</th><th>Ra</th><th>Số giờ</th><th>Đi muộn</th><th>Về sớm</th><th>Tăng ca</th><th>Trạng thái</th><th>Chỉnh sửa gần nhất</th>${adm?'<th></th>':''}</tr>${recs.map(r=>`<tr><td>${dmy(r.date)}</td><td>${esc(r.name)}</td><td>${hmOf(r.inAt)}</td><td>${hmOf(r.outAt)}</td><td>${r.outAt?fmtH(r.hours):'—'}</td><td>${r.late>c.grace?r.late+' phút':'—'}</td><td>${r.outAt&&r.early>0?r.early+' phút':'—'}</td><td>${r.ot>0?fmtH(r.ot):'—'}</td><td>${attStatus(r,today)}</td><td>${attEditInfo(r)}</td>${adm?`<td><button onclick="attEditOpen('${r.id}')"><i class="fa-solid fa-pen"></i> Sửa</button></td>`:''}</tr>`).join('')||`<tr><td colspan=11 class=mut>Chưa có dữ liệu chấm công.</td></tr>`}</table></div></div></section>
${adm?`<section class=v2w-panel><div class=v2w-ph><h4>Duyệt và chỉnh sửa công</h4></div>
<div class="rc" style="padding:0;overflow:hidden"><div class=sc><table><tr><th>Ngày</th><th>Nhân viên</th><th>Vấn đề</th><th></th></tr>${openRows+absRows||'<tr><td colspan=4 class=mut>Không có trường hợp cần duyệt trong kỳ này.</td></tr>'}</table></div></div></section>
<section class=v2w-panel><div class=v2w-ph><h4>Cấu hình ca làm việc</h4></div><div class=att-bar><label>Giờ vào ca chuẩn<input type=time id=ac_s value="${c.start}"></label><label>Giờ kết thúc ca chuẩn<input type=time id=ac_e value="${c.end}"></label><label>Cho phép đi muộn (phút)<input type=number id=ac_g value="${c.grace}" min=0 onkeydown="if(['-','+','e','E'].includes(event.key))event.preventDefault()" oninput="if(+this.value<0)this.value=0"></label><label>Giờ công chuẩn mỗi ngày<input type=number id=ac_h value="${c.std}" min=1 step=0.5 onkeydown="if(['-','+','e','E'].includes(event.key))event.preventDefault()" oninput="if(+this.value<1&&this.value!=='')this.value=1"></label><button class=p onclick="attSaveCfg()">Lưu cấu hình</button></div></section>`:''}`};
/* ===== Bổ sung v90: bảo vệ tài khoản Admin: không tự xóa, không xóa / khóa / hạ quyền Admin cuối cùng; sửa Admin chỉ thông tin cá nhân và đổi mật khẩu sau xác thực ===== */
function adminOthers(i){return S.users.filter((x,j)=>j!=i&&x.role=='admin'&&x.st=='active').length}
function isLastAdmin(i){const u=S.users[i];return !!u&&u.role=='admin'&&adminOthers(i)==0}
function staffActions(u,i){let a='';
 if(u.role=='admin'){
  if(u.st=='active'){if(!isMe(u)&&adminOthers(i)>0)a+=` <button onclick="setU(${i},'locked')">Khóa</button>`}
  else if(u.st=='locked')a+=` <button onclick="setU(${i},'active')">Mở khóa</button>`;
  else a+=` <button onclick="reU(${i})">Kích hoạt</button>`;
 }else{
  a+=u.st=='active'?` <button onclick="setU(${i},'locked')">Khóa</button>`:u.st=='locked'?` <button onclick="setU(${i},'active')">Mở khóa</button>`:` <button onclick="reU(${i})">Kích hoạt</button>`;
 }
 if(!isMe(u)){const last=isLastAdmin(i);a+=` <button class="ib x" title="${last?'Không thể xóa Admin cuối cùng':'Xóa hoặc ngừng hoạt động'}" ${last?'disabled':''} onclick="delU(${i})"><i class="fa-solid fa-trash-can"></i></button>`}
 return a}
function setU(i,s){const u=S.users[i];if(!u)return;
 if(s!='active'&&isMe(u))return alert('Không thể khóa hoặc ngừng hoạt động tài khoản đang đăng nhập.');
 if(s!='active'&&u.role=='admin'&&u.st=='active'&&adminOthers(i)==0)return alert('Không thể khóa Admin cuối cùng trong hệ thống.');
 u.st=s;save();render()}
function delU(i){const u=S.users[i];if(!u)return;
 if(isMe(u))return alert('Admin không thể tự xóa tài khoản của mình.');
 if(isLastAdmin(i))return alert('Không thể xóa Admin cuối cùng trong hệ thống.');
 if(uHasHist(u)){ask(`Tài khoản "${u.name}" đã có lịch sử hoạt động nên không thể xóa. Ngừng hoạt động tài khoản này? Tài khoản sẽ không đăng nhập được và lịch sử được giữ nguyên.`,()=>{u.st='off';save();logA('Ngừng hoạt động',u.name);render()});return}
 ask(`Xóa vĩnh viễn tài khoản "${u.name}"? Tài khoản chưa có lịch sử hoạt động nên có thể xóa.`,()=>{const k=S.users.indexOf(u);if(k>=0)S.users.splice(k,1);save();logA('Xóa tài khoản',u.name);render()})}
function editU(i){const u=S.users[i];if(!u)return;const adm=u.role=='admin';
 const opts=(o,v)=>Object.entries(o).map(([k,l])=>`<option value=${k} ${k==v?'selected':''}>${l}</option>`).join('');
 const pwBlock=adm?(isMe(u)?`<div class=uf><b>Đổi mật khẩu (xác thực bằng mật khẩu hiện tại)</b></div><label class=uf>Mật khẩu hiện tại<input id=eu_cp type=password></label><label class=uf>Mật khẩu mới (để trống nếu không đổi)<input id=eu_p type=password></label>`:`<label class=uf>Mật khẩu mới<input id=eu_p type=password disabled placeholder="Admin tự đổi mật khẩu của mình"></label>`)
  :`<label class=uf>Mật khẩu mới (để trống nếu không đổi)<input id=eu_p type=password></label>`;
 dlg(`<h4 style="margin:0 0 10px">Sửa tài khoản${adm?' Admin':''}</h4>
${adm?'<p class=mut style="margin:0 0 8px">Tài khoản Admin chỉ được sửa thông tin cá nhân và đổi mật khẩu sau khi xác thực.</p>':''}
<label class=uf>Họ và tên<input id=eu_n value="${esc(u.name)}"></label>
<label class=uf>Tên đăng nhập<input id=eu_u value="${esc(u.u)}" ${adm?'disabled':''}></label>
<label class=uf>Chức vụ<select id=eu_r ${adm?'disabled':''}>${opts(R,u.role)}</select></label>
<label class=uf>Trạng thái làm việc<select id=eu_w ${adm?'disabled':''}>${opts(WSM,u.ws||'working')}</select></label>
<label class=uf>Số điện thoại<input id=eu_ph value="${esc(u.ph||'')}"></label>
<label class=uf>Email<input id=eu_em value="${esc(u.em||'')}"></label>
<label class=uf>Địa chỉ<input id=eu_ad value="${esc(u.ad||'')}"></label>
${pwBlock}
<div class=row style="margin-top:10px"><button onclick="dx()">Hủy</button><button class=p onclick="saveU(${i})">Lưu</button></div>`);
 const bx=$('#dlg>.box');if(bx)bx.style.width='min(520px,100%)'}
function saveU(i){const u=S.users[i];if(!u)return;const adm=u.role=='admin';
 const n=$('#eu_n').value.trim(),ph=$('#eu_ph').value.trim(),em=$('#eu_em').value.trim(),ad=$('#eu_ad').value.trim(),np=$('#eu_p').value;
 if(!n)return alert('Nhập họ tên.');
 if(ph&&!/^[0-9+ ]{8,15}$/.test(ph))return alert('Số điện thoại không hợp lệ (8 đến 15 chữ số).');
 if(em&&!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(em))return alert('Email không hợp lệ.');
 if(adm){
  if(np){
   if(!isMe(u))return alert('Chỉ Admin đó mới được đổi mật khẩu của mình.');
   const cp=$('#eu_cp')?$('#eu_cp').value:'';
   if(cp!==u.p)return alert('Mật khẩu hiện tại không đúng. Cần xác thực để đổi mật khẩu.');
   if(!uPolicyOk(np))return alert('Mật khẩu mới chưa đạt: tối thiểu 8 ký tự, đủ chữ hoa, chữ thường, số, ký tự đặc biệt.');
   u.p=np;
  }
  Object.assign(u,{name:n,ph,em,ad});save();logA('Sửa thông tin Admin',n);dx();render();return;
 }
 const nu=$('#eu_u').value.trim(),r=$('#eu_r').value,w=$('#eu_w').value;
 if(!nu)return alert('Nhập tên đăng nhập.');
 if(S.users.some((x,j)=>j!=i&&x.u==nu))return alert('Tên đăng nhập đã tồn tại.');
 if(np&&!uPolicyOk(np))return alert('Mật khẩu mới chưa đạt: tối thiểu 8 ký tự, đủ chữ hoa, chữ thường, số, ký tự đặc biệt.');
 Object.assign(u,{name:n,u:nu,role:r,ws:w,ph,em,ad});if(np)u.p=np;
 save();logA('Sửa tài khoản',n);dx();render()}
PAGES.staff=()=>{const st=pg('staff',S.users.length,10),rows=S.users.map((u,i)=>[u,i]).slice(st,st+10);return`<div><h3 style="margin:0 0 2px">Quản lý tài khoản</h3><div class=v2-sub>Theo dõi nhân sự và phân quyền sử dụng</div></div><div class="box stf"><input id=sn placeholder="Họ và tên"> <input id=su placeholder="Tên đăng nhập"> <select id=sr>${Object.entries(R).map(([k,v])=>`<option value=${k}>${v}</option>`).join('')}</select> <input id=sp type=password placeholder="Mật khẩu khởi tạo"> <button class=p onclick="addU()">Tạo tài khoản</button><div class=tag>Mật khẩu tối thiểu 8 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt.</div></div><div class="rc" style="padding:0;overflow:hidden"><div class=sc><table><tr><th>Họ tên</th><th>Đăng nhập</th><th>Mật khẩu</th><th>Chức vụ</th><th>Trạng thái làm việc</th><th>Trạng thái tài khoản</th><th>Liên hệ</th><th>Đăng nhập gần nhất</th><th>Ngày tạo</th><th></th></tr>${rows.map(([u,i])=>`<tr style="${u.st!='active'?'color:var(--mut);opacity:.65':''}"><td>${esc(u.name)}${u.role=='admin'?' <small class=mut>(Admin)</small>':''}</td><td>${esc(u.u)}</td><td><span id=pw${i}>••••••••</span> <button class=ib title="Hiện / ẩn mật khẩu" onclick="togPw(${i})"><i class="fa-solid fa-eye"></i></button></td><td>${R[u.role]}</td><td>${WSM[u.ws||'working']}</td><td>${ASM[u.st]||u.st}</td><td>${esc(u.ph||'—')}${u.em?`<br><small>${esc(u.em)}</small>`:''}</td><td>${uLastLogin(u)}</td><td>${new Date(u.t).toLocaleDateString('vi-VN')}</td><td style="white-space:nowrap"><button class=ib title="Sửa tài khoản" onclick="editU(${i})"><i class="fa-solid fa-pen"></i></button>${staffActions(u,i)}</td></tr>`).join('')||'<tr><td colspan=10 class=mut>Chưa có tài khoản nào.</td></tr>'}</table></div>${pgBar(S.users.length,10,PG.staff,'tài khoản','PG.staff')}</div>`};
/* ===== Bổ sung v91: nút khóa, mở khóa, kích hoạt tài khoản dùng biểu tượng ===== */
function staffActions(u,i){let a='';
 const lockBtn=`<button class=ib title="Khóa tài khoản" aria-label="Khóa tài khoản" onclick="setU(${i},'locked')"><i class="fa-solid fa-lock"></i></button>`;
 const unlockBtn=`<button class=ib title="Mở khóa tài khoản" aria-label="Mở khóa tài khoản" onclick="setU(${i},'active')"><i class="fa-solid fa-lock-open"></i></button>`;
 const actBtn=`<button class=ib title="Kích hoạt tài khoản" aria-label="Kích hoạt tài khoản" onclick="reU(${i})"><i class="fa-solid fa-user-check"></i></button>`;
 if(u.role=='admin'){
  if(u.st=='active'){if(!isMe(u)&&adminOthers(i)>0)a+=' '+lockBtn}
  else if(u.st=='locked')a+=' '+unlockBtn;
  else a+=' '+actBtn;
 }else{
  a+=' '+(u.st=='active'?lockBtn:u.st=='locked'?unlockBtn:actBtn);
 }
 if(!isMe(u)){const last=isLastAdmin(i);a+=` <button class="ib x" title="${last?'Không thể xóa Admin cuối cùng':'Xóa hoặc ngừng hoạt động'}" aria-label="Xóa hoặc ngừng hoạt động" ${last?'disabled':''} onclick="delU(${i})"><i class="fa-solid fa-trash-can"></i></button>`}
 return a}
/* ===== Bổ sung v93: Quản lý nhân viên — ba tab Nhân viên, Chấm công, Thống kê; bỏ mã NV và ô tick ===== */
const qlF={tab:'',q:'',role:'',ws:''};
const qlAttOld=PAGES.attendance;
document.head.insertAdjacentHTML('beforeend',`<style>
.qltabs{display:flex;gap:8px;flex-wrap:wrap;margin:8px 0 12px}
.qltab{border:1px solid var(--bd);background:var(--card);color:var(--mut);border-radius:12px;padding:9px 16px;font-weight:600;display:inline-flex;align-items:center;gap:8px;cursor:pointer}
.qltab.on{background:var(--pri);border-color:var(--pri);color:#fff}
.qlbar{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin:10px 0 14px}
.qlin{height:42px;box-sizing:border-box;border:1px solid var(--bd);border-radius:10px;background:var(--card);padding:0 12px;color:var(--fg);min-width:150px}
.qlin.qlq{min-width:240px;flex:1 1 240px}
.qlbtn{height:42px;display:inline-flex;align-items:center;gap:8px}
.qlstats{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px;margin-bottom:14px}
.qlst{display:flex;align-items:center;gap:12px;background:color-mix(in srgb,var(--c) 10%,var(--card));border:1px solid color-mix(in srgb,var(--c) 30%,var(--bd));border-radius:14px;padding:14px;min-width:0}
.qlst>i{width:44px;height:44px;border-radius:12px;display:inline-flex;align-items:center;justify-content:center;background:color-mix(in srgb,var(--c) 18%,var(--card));color:var(--c);font-size:18px;flex:none}
.qlst small{display:block;color:var(--mut)}
.qlst b{font-size:22px;color:var(--fg)}
.qlpill{display:inline-flex;align-items:center;gap:6px;border-radius:999px;padding:3px 10px;font-size:13px;font-weight:600;color:var(--c);background:color-mix(in srgb,var(--c) 14%,var(--card));white-space:nowrap}
.qlact{white-space:nowrap}
</style>`);
function qlTabs(){return attCanView()?['staff','att','stat']:['att']}
function qlSetTab(t){qlF.tab=t;staffFb=false;render()}
function qlFilter(k,v){qlF[k]=v;render()}
function qlKey(u){return u.st=='off'?'off':u.st=='locked'?'locked':(u.ws||'working')}
const qlRC={admin:'var(--pri)',manager:'var(--w)',waiter:'var(--ok)',kitchen:'#5b7f9b'};
const qlSC={working:'var(--ok)',leave:'var(--w)',absent:'#5b7f9b',locked:'var(--mut)',off:'var(--mut)'};
function qlLockBtn(u,i){
 if(u.role=='admin'&&u.st=='active'&&(isMe(u)||adminOthers(i)==0))return '';
 if(u.st=='active')return `<button class=ib title="Khóa tài khoản" aria-label="Khóa tài khoản" onclick="setU(${i},'locked')"><i class="fa-solid fa-lock"></i></button>`;
 if(u.st=='locked')return `<button class=ib title="Mở khóa tài khoản" aria-label="Mở khóa tài khoản" onclick="setU(${i},'active')"><i class="fa-solid fa-lock-open"></i></button>`;
 return `<button class=ib title="Kích hoạt tài khoản" aria-label="Kích hoạt tài khoản" onclick="reU(${i})"><i class="fa-solid fa-user-check"></i></button>`}
function qlDelBtn(u,i){if(isMe(u))return '';const last=isLastAdmin(i);
 return `<button class="ib x" title="${last?'Không thể xóa Admin cuối cùng':'Xóa hoặc ngừng hoạt động'}" aria-label="Xóa hoặc ngừng hoạt động" ${last?'disabled':''} onclick="delU(${i})"><i class="fa-solid fa-trash-can"></i></button>`}
function qlViewOpen(i){const u=S.users[i];if(!u)return;const m=attF.month||ymd(Date.now()).slice(0,7),s=attStats(m,u.u);
 dlg(`<h4 style="margin:0 0 10px">Thông tin nhân viên</h4>
<div class=uf>Họ và tên<b>${esc(u.name)}</b></div>
<div class=uf>Tên đăng nhập<b>${esc(u.u)}</b></div>
<div class=uf>Chức vụ<b>${R[u.role]}</b></div>
<div class=uf>Trạng thái làm việc<b>${WSM[u.ws||'working']}</b></div>
<div class=uf>Trạng thái tài khoản<b>${ASM[u.st]||u.st}</b></div>
<div class=uf>Số điện thoại<b>${esc(u.ph||'—')}</b></div>
<div class=uf>Email<b>${esc(u.em||'—')}</b></div>
<div class=uf>Địa chỉ<b>${esc(u.ad||'—')}</b></div>
<div class=uf>Đăng nhập gần nhất<b>${uLastLogin(u)}</b></div>
<div class=uf>Công trong tháng<b>${s.days} ngày · ${fmtH(s.hours)} · ${s.late} lần đi muộn</b></div>
<div class=row style="margin-top:10px"><button class=p onclick="dx()">Đóng</button></div>`);
 const bx=$('#dlg>.box');if(bx)bx.style.width='min(520px,100%)'}
function qlAddOpen(){if(!attAdmin())return;
 dlg(`<h4 style="margin:0 0 10px">Thêm nhân viên</h4>
<label class=uf>Họ và tên<input id=qa_n></label>
<label class=uf>Tên đăng nhập<input id=qa_u></label>
<label class=uf>Chức vụ<select id=qa_r>${Object.entries(R).map(([k,v])=>`<option value=${k}>${v}</option>`).join('')}</select></label>
<label class=uf>Mật khẩu khởi tạo<input id=qa_p type=password></label>
<p class=mut style="font-size:13px;margin:0 0 8px">Mật khẩu tối thiểu 8 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt.</p>
<div class=row style="margin-top:10px"><button onclick="dx()">Hủy</button><button class=p onclick="qlAddSave()">Tạo nhân viên</button></div>`);
 const bx=$('#dlg>.box');if(bx)bx.style.width='min(480px,100%)'}
function qlAddSave(){if(!attAdmin())return;const n=$('#qa_n').value.trim(),u=$('#qa_u').value.trim(),p=$('#qa_p').value,r=$('#qa_r').value;
 if(!n||!u)return alert('Nhập họ tên và tên đăng nhập.');
 if(S.users.some(x=>x.u==u))return alert('Tên đăng nhập đã tồn tại.');
 if(!uPolicyOk(p))return alert('Mật khẩu chưa đạt: tối thiểu 8 ký tự, đủ chữ hoa, chữ thường, số, ký tự đặc biệt.');
 S.users.push({name:n,u,p,role:r,st:'active',t:Date.now(),ws:'working',ph:'',em:'',ad:''});save();logA('Tạo tài khoản',n);dx();render()}
function qlStaffTab(){
 const admin=attAdmin(),q=(qlF.q||'').trim().toLowerCase(),rf=qlF.role||'',wf=qlF.ws||'',month=attF.month||ymd(Date.now()).slice(0,7);
 const rows=S.users.map((u,i)=>[u,i]).filter(([u])=>(!q||(u.name+' '+u.u).toLowerCase().includes(q))&&(!rf||u.role==rf)&&(!wf||qlKey(u)==wf));
 const cnt=f=>S.users.filter(f).length;
 const stats=`<div class=qlstats>
  <div class=qlst style="--c:var(--pri)"><i class="fa-solid fa-users"></i><div><small>Tổng nhân viên</small><b>${S.users.length}</b></div></div>
  <div class=qlst style="--c:var(--ok)"><i class="fa-solid fa-circle-check"></i><div><small>Đang làm việc</small><b>${cnt(u=>u.st=='active'&&(u.ws||'working')=='working')}</b></div></div>
  <div class=qlst style="--c:var(--w)"><i class="fa-solid fa-plane-departure"></i><div><small>Đang nghỉ phép</small><b>${cnt(u=>u.st=='active'&&u.ws=='leave')}</b></div></div>
  <div class=qlst style="--c:var(--mut)"><i class="fa-solid fa-circle-pause"></i><div><small>Ngừng hoạt động</small><b>${cnt(u=>u.st=='off')}</b></div></div></div>`;
 const bar=`<div class=qlbar>
  <input id=qlq class="qlin qlq" placeholder="Tìm kiếm nhân viên..." value="${esc(qlF.q||'')}" oninput="qlF.q=this.value;render();refocus('qlq')">
  <select class=qlin onchange="qlFilter('role',this.value)"><option value="">Tất cả chức vụ</option>${Object.entries(R).map(([k,v])=>`<option value=${k} ${k==rf?'selected':''}>${v}</option>`).join('')}</select>
  <select class=qlin onchange="qlFilter('ws',this.value)"><option value="">Tất cả trạng thái</option>${Object.entries(WSM).map(([k,v])=>`<option value=${k} ${k==wf?'selected':''}>${v}</option>`).join('')}<option value=locked ${wf=='locked'?'selected':''}>Đã khóa</option><option value=off ${wf=='off'?'selected':''}>Ngừng hoạt động</option></select>
  <input class=qlin type=month value="${month}" onchange="attSet('month',this.value)">
  <button class="p qlbtn" onclick="render()"><i class="fa-solid fa-filter"></i> Lọc</button>
  ${admin?`<button class="p qlbtn" onclick="qlAddOpen()"><i class="fa-solid fa-plus"></i> Thêm nhân viên</button>`:''}</div>`;
 const trs=rows.map(([u,i])=>{const k=qlKey(u);const sl=k=='off'?'Ngừng hoạt động':k=='locked'?'Đã khóa':WSM[k];
  return `<tr style="${u.st!='active'?'opacity:.7':''}"><td><b>${esc(u.name)}</b></td><td><span class=qlpill style="--c:${qlRC[u.role]||'var(--mut)'}">${R[u.role]}</span></td><td class=col-ph>${esc(u.ph||'—')}</td><td class=col-em>${esc(u.em||'—')}</td><td><span class=qlpill style="--c:${qlSC[k]||'var(--mut)'}">${sl}</span></td><td class=col-st>${dmy(ymd(u.t))}</td><td class=qlact><button class=ib title="Xem chi tiết" aria-label="Xem chi tiết" onclick="qlViewOpen(${i})"><i class="fa-solid fa-eye"></i></button>${admin?`<button class=ib title="Sửa tài khoản" aria-label="Sửa tài khoản" onclick="editU(${i})"><i class="fa-solid fa-pen"></i></button>`:''}${admin?qlLockBtn(u,i):''}${admin?qlDelBtn(u,i):''}</td></tr>`}).join('');
 return stats+bar+`<section class=v2w-panel style="padding:0;overflow:hidden"><div class=sc><table><tr><th>Họ và tên</th><th>Chức vụ</th><th class=col-ph>Số điện thoại</th><th class=col-em>Email</th><th>Trạng thái</th><th class=col-st>Ngày vào làm</th><th style="text-align:center">Thao tác</th></tr>${trs||'<tr><td colspan=7 class=mut>Không có nhân viên phù hợp.</td></tr>'}</table></div></section>`}
function qlStatTab(){
 const month=attF.month||ymd(Date.now()).slice(0,7);
 const data=S.users.filter(u=>u.st!='off').map(u=>({u,s:attStats(month,u.u)}));
 const T=data.reduce((a,x)=>({d:a.d+x.s.days,h:a.h+x.s.hours,l:a.l+x.s.late,n:a.n+x.s.absent,o:a.o+x.s.ot}),{d:0,h:0,l:0,n:0,o:0});
 const cards=`<div class=qlstats>
  <div class=qlst style="--c:var(--pri)"><i class="fa-solid fa-calendar-check"></i><div><small>Tổng số ngày công</small><b>${T.d}</b></div></div>
  <div class=qlst style="--c:var(--ok)"><i class="fa-solid fa-clock"></i><div><small>Giờ làm</small><b>${fmtH(T.h)}</b></div></div>
  <div class=qlst style="--c:var(--w)"><i class="fa-solid fa-person-walking-luggage"></i><div><small>Đi muộn</small><b>${T.l}</b></div></div>
  <div class=qlst style="--c:#5b7f9b"><i class="fa-solid fa-calendar-xmark"></i><div><small>Nghỉ</small><b>${T.n}</b></div></div>
  <div class=qlst style="--c:var(--mut)"><i class="fa-solid fa-hourglass-half"></i><div><small>Tăng ca</small><b>${fmtH(T.o)}</b></div></div></div>`;
 const bar=`<div class=qlbar><input class=qlin type=month value="${month}" onchange="attSet('month',this.value)"></div>`;
 const trs=data.map(({u,s})=>`<tr><td><b>${esc(u.name)}</b></td><td><span class=qlpill style="--c:${qlRC[u.role]||'var(--mut)'}">${R[u.role]}</span></td><td>${s.days}</td><td>${fmtH(s.hours)}</td><td>${s.late}</td><td>${s.absent}</td><td>${fmtH(s.ot)}</td></tr>`).join('');
 return cards+bar+`<section class=v2w-panel style="padding:0;overflow:hidden"><div class=sc><table><tr><th>Họ và tên</th><th>Chức vụ</th><th>Ngày công</th><th>Giờ làm</th><th>Đi muộn</th><th>Nghỉ</th><th>Tăng ca</th></tr>${trs||'<tr><td colspan=7 class=mut>Chưa có nhân viên.</td></tr>'}</table></div></section>`}
function qlAttBody(){return qlAttOld().replace(/^<div><h3[\s\S]*?<\/div><\/div>/,'')}
PAGES.attendance=()=>{
 const tabs=qlTabs();const tab=tabs.includes(qlF.tab)?qlF.tab:tabs[0];qlF.tab=tab;
 const tb=(k,l,ic)=>`<button class="qltab ${tab==k?'on':''}" onclick="qlSetTab('${k}')"><i class="fa-solid ${ic}"></i> ${l}</button>`;
 const head=`<div><h3 style="margin:0 0 2px">Quản lý nhân viên</h3><div class=v2-sub>Theo dõi nhân sự, chấm công và thống kê công</div></div>`;
 const tabsHtml=`<div class=qltabs>${tabs.includes('staff')?tb('staff','Nhân viên','fa-users'):''}${tb('att','Chấm công','fa-calendar-check')}${tabs.includes('stat')?tb('stat','Thống kê','fa-chart-column'):''}</div>`;
 const body=tab=='staff'?qlStaffTab():tab=='stat'?qlStatTab():qlAttBody();
 return head+tabsHtml+body};
/* ===== Bổ sung v94: Quản lý nhân viên — tab + nút Thêm cùng hàng, tìm kiếm có icon, phân trang, nhãn không viền ===== */
document.head.insertAdjacentHTML('beforeend',`<style>
.qltabbar{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;margin:8px 0 12px}
.qltabbar .qltabs{margin:0}
.qlsearch{position:relative;flex:1 1 240px;min-width:0}
.qlsearch>i{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--mut);pointer-events:none}
.qlsearch input{width:100%!important;min-width:0!important;flex:none!important;box-sizing:border-box;padding-left:36px!important}
.qlpill{border:0!important;box-shadow:none!important;outline:0}
</style>`);
function qlStaffTab(){
 const admin=attAdmin(),q=(qlF.q||'').trim().toLowerCase(),rf=qlF.role||'',wf=qlF.ws||'',month=attF.month||ymd(Date.now()).slice(0,7);
 const rows=S.users.map((u,i)=>[u,i]).filter(([u])=>(!q||(u.name+' '+u.u).toLowerCase().includes(q))&&(!rf||u.role==rf)&&(!wf||qlKey(u)==wf));
 const st=pg('qlstaff',rows.length,10),page=rows.slice(st,st+10);
 const cnt=f=>S.users.filter(f).length;
 const stats=`<div class=qlstats>
  <div class=qlst style="--c:var(--pri)"><i class="fa-solid fa-users"></i><div><small>Tổng nhân viên</small><b>${S.users.length}</b></div></div>
  <div class=qlst style="--c:var(--ok)"><i class="fa-solid fa-circle-check"></i><div><small>Đang làm việc</small><b>${cnt(u=>u.st=='active'&&(u.ws||'working')=='working')}</b></div></div>
  <div class=qlst style="--c:var(--w)"><i class="fa-solid fa-plane-departure"></i><div><small>Đang nghỉ phép</small><b>${cnt(u=>u.st=='active'&&u.ws=='leave')}</b></div></div>
  <div class=qlst style="--c:var(--mut)"><i class="fa-solid fa-circle-pause"></i><div><small>Ngừng hoạt động</small><b>${cnt(u=>u.st=='off')}</b></div></div></div>`;
 const bar=`<details class="rp-fbox staff-fbox"${(devType()!='phone'||staffFb)?' open':''} ontoggle="if(devType()=='phone')staffFb=this.open">
  <summary class=rp-fsum><span class=rp-fi><i class="fa-solid fa-filter"></i></span><span>Bộ lọc</span><i class="fa-solid fa-chevron-up rp-fch"></i></summary>
  <div class="qlbar staff-fbody">
   <div class=qlsearch><i class="fa-solid fa-magnifying-glass"></i><input id=qlq class="qlin" placeholder="Tìm kiếm nhân viên..." value="${esc(qlF.q||'')}" oninput="qlF.q=this.value;PG.qlstaff=0;render();refocus('qlq')"></div>
   <div class=staff-frow2>
    <select class="qlin staff-frole" onchange="qlFilter('role',this.value)"><option value="">Tất cả chức vụ</option>${Object.entries(R).map(([k,v])=>`<option value=${k} ${k==rf?'selected':''}>${v}</option>`).join('')}</select>
    <select class="qlin staff-fws" onchange="qlFilter('ws',this.value)"><option value="">Tất cả trạng thái</option>${Object.entries(WSM).map(([k,v])=>`<option value=${k} ${k==wf?'selected':''}>${v}</option>`).join('')}<option value=locked ${wf=='locked'?'selected':''}>Đã khóa</option><option value=off ${wf=='off'?'selected':''}>Ngừng hoạt động</option></select>
   </div>
   <div class=staff-frow3>
    <input class="qlin staff-fm" type=month value="${month}" onchange="attSet('month',this.value)">
    <button class="p qlbtn staff-fclr" onclick="qlClear()" ${qlHasFilter()?'':'disabled'}>Xóa lọc</button>
   </div>
  </div>
 </details>`;
 const trs=page.map(([u,i])=>{const k=qlKey(u);const sl=k=='off'?'Ngừng hoạt động':k=='locked'?'Đã khóa':WSM[k];
  return `<tr style="${u.st!='active'?'opacity:.7':''}"><td><b>${esc(u.name)}</b></td><td><span class=qlpill style="--c:${qlRC[u.role]||'var(--mut)'}">${R[u.role]}</span></td><td class=col-ph>${esc(u.ph||'—')}</td><td class=col-em>${esc(u.em||'—')}</td><td><span class=qlpill style="--c:${qlSC[k]||'var(--mut)'}">${sl}</span></td><td class=col-st>${dmy(ymd(u.t))}</td><td class=qlact><button class=ib title="Xem chi tiết" aria-label="Xem chi tiết" onclick="qlViewOpen(${i})"><i class="fa-solid fa-eye"></i></button>${admin?`<button class=ib title="Sửa tài khoản" aria-label="Sửa tài khoản" onclick="editU(${i})"><i class="fa-solid fa-pen"></i></button>`:''}${admin?qlLockBtn(u,i):''}${admin?qlDelBtn(u,i):''}</td></tr>`}).join('');
 return stats+bar+`<section class=v2w-panel style="padding:0;overflow:hidden"><div class=sc><table><tr><th>Họ và tên</th><th>Chức vụ</th><th class=col-ph>Số điện thoại</th><th class=col-em>Email</th><th>Trạng thái</th><th class=col-st>Ngày vào làm</th><th style="text-align:center">Thao tác</th></tr>${trs||'<tr><td colspan=7 class=mut>Không có nhân viên phù hợp.</td></tr>'}</table></div>${pgBar(rows.length,10,PG.qlstaff,'nhân viên','PG.qlstaff')}</section>`}
function qlFilter(k,v){qlF[k]=v;PG.qlstaff=0;render()}
PAGES.attendance=()=>{
 const tabs=qlTabs();const tab=tabs.includes(qlF.tab)?qlF.tab:tabs[0];qlF.tab=tab;
 const tb=(k,l,ic)=>`<button class="qltab ${tab==k?'on':''}" onclick="qlSetTab('${k}')"><i class="fa-solid ${ic}"></i> ${l}</button>`;
 const head=`<div><h3 style="margin:0 0 2px">Quản lý nhân viên</h3><div class=v2-sub>Theo dõi nhân sự, chấm công và thống kê công</div></div>`;
 const addBtn=(attAdmin()&&tab=='staff')?`<button class="p qlbtn" onclick="qlAddOpen()"><i class="fa-solid fa-plus"></i> Thêm nhân viên</button>`:'';
 const tabsHtml=`<div class=qltabbar><div class=qltabs>${tabs.includes('staff')?tb('staff','Nhân viên','fa-users'):''}${tb('att','Chấm công','fa-calendar-check')}${tabs.includes('stat')?tb('stat','Thống kê','fa-chart-column'):''}</div>${addBtn}</div>`;
 const body=tab=='staff'?qlStaffTab():tab=='stat'?qlStatTab():qlAttBody();
 return head+tabsHtml+body};
/* ===== Bổ sung v95: icon tìm kiếm nằm trong khung ô nhập; chức vụ và trạng thái không còn màu ===== */
document.head.insertAdjacentHTML('beforeend',`<style>
.qlsearch{position:relative!important;display:flex!important;align-items:center!important;gap:8px!important;flex:1 1 240px!important;min-width:0!important;height:42px!important;box-sizing:border-box!important;border:1px solid var(--bd)!important;border-radius:10px!important;background:var(--card)!important;padding:0 12px!important}
.qlsearch>i{position:static!important;transform:none!important;top:auto!important;left:auto!important;color:var(--mut)!important;flex:none!important;pointer-events:none!important;font-size:15px!important;line-height:1!important}
.qlsearch input{flex:1 1 auto!important;width:auto!important;min-width:0!important;height:100%!important;border:0!important;outline:none!important;background:transparent!important;padding:0!important;margin:0!important;box-shadow:none!important;color:var(--fg)!important}
.qlpill{color:var(--fg)!important;background:var(--bg)!important}
</style>`);
/* ===== Bổ sung v96: nhãn chức vụ và trạng thái không có màu nền ===== */
document.head.insertAdjacentHTML('beforeend',`<style>
.qlpill{background:transparent!important;color:var(--fg)!important;padding-left:0!important;padding-right:0!important}
</style>`);
/* ===== Bổ sung v97: ẩn mã món (M1, M2...) trong cột Món trên mọi thiết bị ===== */
document.head.insertAdjacentHTML('beforeend',`<style>
.mcode{display:none!important}
</style>`);
/* ===== Bổ sung v98: giao diện hộp thoại sửa nhân viên gọn hơn: nhóm thông tin, hai cột, nội dung cuộn, nút cố định ===== */
document.head.insertAdjacentHTML('beforeend',`<style>
.eu-wrap{display:flex;flex-direction:column;max-height:88vh;min-height:0}
.eu-hd{padding-bottom:10px;border-bottom:1px solid var(--bd);margin-bottom:12px;flex:none}
.eu-hd h4{margin:0 0 2px}
.eu-body{overflow:auto;min-height:0;flex:1 1 auto;padding-right:4px}
.eu-sec{margin-bottom:16px}
.eu-st{font-weight:700;color:var(--pri);margin:0 0 8px;padding-bottom:6px;border-bottom:1px dashed var(--bd)}
.eu-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px 14px}
.eu-grid .eu-full{grid-column:1/-1}
.eu-grid .uf{margin:0}
.eu-grid .uf input,.eu-grid .uf select{height:42px}
.eu-note{font-size:13px;color:var(--mut);margin:0 0 8px;grid-column:1/-1}
.eu-ft{display:flex;justify-content:flex-end;gap:10px;padding-top:12px;border-top:1px solid var(--bd);margin-top:4px;flex:none}
#dlg input:disabled,#dlg select:disabled{background:var(--bg);color:var(--mut);cursor:not-allowed}
html[data-dev=phone] .eu-grid{grid-template-columns:1fr}
</style>`);
function editU(i){const u=S.users[i];if(!u)return;const adm=u.role=='admin',self=isMe(u);
 const opts=(o,v)=>Object.entries(o).map(([k,l])=>`<option value=${k} ${k==v?'selected':''}>${l}</option>`).join('');
 const pwFields=adm
  ?(self
    ?`<div class=eu-note>Đổi mật khẩu của chính bạn cần nhập đúng mật khẩu hiện tại.</div>
      <label class=uf>Mật khẩu hiện tại<input id=eu_cp type=password></label>
      <label class=uf>Mật khẩu mới (để trống nếu không đổi)<input id=eu_p type=password></label>`
    :`<div class=eu-note>Chỉ Admin đó mới được đổi mật khẩu của mình.</div>
      <label class=uf>Mật khẩu mới<input id=eu_p type=password disabled placeholder="Không thể đổi"></label>`)
  :`<label class="uf eu-full">Mật khẩu mới (để trống nếu không đổi)<input id=eu_p type=password></label>`;
 dlg(`<div class=eu-wrap>
  <div class=eu-hd><h4>Sửa thông tin nhân viên</h4><div class=v2-sub>${adm?'Tài khoản Admin: chỉ sửa thông tin cá nhân và đổi mật khẩu sau khi xác thực.':'Cập nhật thông tin tài khoản, chức vụ và liên hệ.'}</div></div>
  <div class=eu-body>
   <div class=eu-sec><div class=eu-st>Thông tin tài khoản</div><div class=eu-grid>
    <label class=uf>Họ và tên<input id=eu_n value="${esc(u.name)}"></label>
    <label class=uf>Tên đăng nhập<input id=eu_u value="${esc(u.u)}" ${adm?'disabled':''}></label>
    <label class=uf>Chức vụ<select id=eu_r ${adm?'disabled':''}>${opts(R,u.role)}</select></label>
    <label class=uf>Trạng thái làm việc<select id=eu_w ${adm?'disabled':''}>${opts(WSM,u.ws||'working')}</select></label>
   </div></div>
   <div class=eu-sec><div class=eu-st>Thông tin liên hệ</div><div class=eu-grid>
    <label class=uf>Số điện thoại<input id=eu_ph value="${esc(u.ph||'')}"></label>
    <label class=uf>Email<input id=eu_em value="${esc(u.em||'')}"></label>
    <label class="uf eu-full">Địa chỉ<input id=eu_ad value="${esc(u.ad||'')}"></label>
   </div></div>
   <div class=eu-sec><div class=eu-st>Mật khẩu</div><div class=eu-grid>${pwFields}</div></div>
  </div>
  <div class=eu-ft><button onclick="dx()">Hủy</button><button class=p onclick="saveU(${i})">Lưu thay đổi</button></div>
 </div>`);
 const bx=$('#dlg>.box');if(bx){bx.style.width='min(720px,96vw)';bx.style.maxHeight='94vh';bx.style.overflow='hidden'}}
/* ===== Bổ sung v99: form Thêm nhân viên có bố cục giống form Sửa thông tin nhân viên ===== */
function qlAddOpen(){if(!attAdmin())return;
 const opts=(o,v)=>Object.entries(o).map(([k,l])=>`<option value=${k} ${k==v?'selected':''}>${l}</option>`).join('');
 dlg(`<div class=eu-wrap>
  <div class=eu-hd><h4>Thêm nhân viên</h4><div class=v2-sub>Tạo tài khoản mới và nhập thông tin liên hệ. Có thể chỉnh sửa lại sau khi tạo.</div></div>
  <div class=eu-body>
   <div class=eu-sec><div class=eu-st>Thông tin tài khoản</div><div class=eu-grid>
    <label class=uf>Họ và tên<input id=qa_n></label>
    <label class=uf>Tên đăng nhập<input id=qa_u></label>
    <label class=uf>Chức vụ<select id=qa_r>${opts(R,'waiter')}</select></label>
    <label class=uf>Trạng thái làm việc<select id=qa_w>${opts(WSM,'working')}</select></label>
   </div></div>
   <div class=eu-sec><div class=eu-st>Thông tin liên hệ</div><div class=eu-grid>
    <label class=uf>Số điện thoại<input id=qa_ph></label>
    <label class=uf>Email<input id=qa_em></label>
    <label class="uf eu-full">Địa chỉ<input id=qa_ad></label>
   </div></div>
   <div class=eu-sec><div class=eu-st>Mật khẩu</div><div class=eu-grid>
    <div class="eu-note">Mật khẩu tối thiểu 8 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt. Nhân viên có thể đổi sau khi đăng nhập.</div>
    <label class="uf eu-full">Mật khẩu khởi tạo<input id=qa_p type=password></label>
   </div></div>
  </div>
  <div class=eu-ft><button onclick="dx()">Hủy</button><button class=p onclick="qlAddSave()">Tạo nhân viên</button></div>
 </div>`);
 const bx=$('#dlg>.box');if(bx){bx.style.width='min(720px,96vw)';bx.style.maxHeight='94vh';bx.style.overflow='hidden'}}
function qlAddSave(){if(!attAdmin())return;
 const n=$('#qa_n').value.trim(),u=$('#qa_u').value.trim(),p=$('#qa_p').value,r=$('#qa_r').value,w=$('#qa_w').value,
  ph=$('#qa_ph').value.trim(),em=$('#qa_em').value.trim(),ad=$('#qa_ad').value.trim();
 if(!n||!u)return alert('Nhập họ tên và tên đăng nhập.');
 if(S.users.some(x=>x.u==u))return alert('Tên đăng nhập đã tồn tại.');
 if(ph&&!/^[0-9+ ]{8,15}$/.test(ph))return alert('Số điện thoại không hợp lệ (8 đến 15 chữ số).');
 if(em&&!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(em))return alert('Email không hợp lệ.');
 if(!uPolicyOk(p))return alert('Mật khẩu chưa đạt: tối thiểu 8 ký tự, đủ chữ hoa, chữ thường, số, ký tự đặc biệt.');
 S.users.push({name:n,u,p,role:r,st:'active',t:Date.now(),ws:w,ph,em,ad});save();logA('Tạo tài khoản',n);dx();render()}
/* ===== Bổ sung v100: form xem thông tin nhân viên có bố cục giống form sửa, trên điện thoại và máy tính ===== */
document.head.insertAdjacentHTML('beforeend',`<style>
.vw-f{display:flex;flex-direction:column;gap:4px;min-width:0}
.vw-l{font-size:14px;color:var(--mut)}
.vw-v{background:var(--bg);border:1px solid var(--bd);border-radius:10px;padding:9px 12px;min-height:42px;box-sizing:border-box;color:var(--fg);font-weight:600;display:flex;align-items:center;word-break:break-word}
.vw-v.vw-n{font-weight:400}
.vw-full{grid-column:1/-1}
</style>`);
function qlViewOpen(i){const u=S.users[i];if(!u)return;
 const m=attF.month||ymd(Date.now()).slice(0,7),s=attStats(m,u.u);
 const wsTxt=u.st=='off'?'Ngừng hoạt động':u.st=='locked'?'Đã khóa':(WSM[u.ws||'working']||'—');
 const f=(l,v,cls='')=>`<div class="vw-f ${cls}"><div class=vw-l>${l}</div><div class=vw-v>${v}</div></div>`;
 dlg(`<div class=eu-wrap>
  <div class=eu-hd><h4>${esc(u.name)}</h4><div class=v2-sub>${R[u.role]} · ${ASM[u.st]||u.st}</div></div>
  <div class=eu-body>
   <div class=eu-sec><div class=eu-st>Thông tin tài khoản</div>
    <div class=eu-grid>
     ${f('Họ và tên',esc(u.name))}
     ${f('Tên đăng nhập',esc(u.u))}
     ${f('Chức vụ',R[u.role],'vw-full')}
    </div>
    <div class="att-view-row1 att-status-row" style="margin-top:10px;margin-bottom:0!important">
     ${f('Trạng thái làm việc',wsTxt)}
     ${f('Trạng thái tài khoản',ASM[u.st]||u.st)}
    </div>
   </div>
   <div class=eu-sec><div class=eu-st>Thông tin liên hệ</div><div class=eu-grid>
    ${f('Số điện thoại',esc(u.ph||'—'))}
    ${f('Email',esc(u.em||'—'))}
    ${f('Địa chỉ',esc(u.ad||'—'),'vw-full')}
   </div></div>
   <div class=eu-sec><div class=eu-st>Hoạt động</div><div class="att-view-row1 att-act-row">
    ${f('Ngày vào làm',dmy(ymd(u.t)))}
    ${f('Đăng nhập gần nhất',uLastLogin(u))}
   </div></div>
   <div class=eu-sec><div class=eu-st>Chấm công tháng ${m.slice(5)}/${m.slice(0,4)}</div>
    <div class=att-view-row1>
     ${f('Ngày công',s.days)}
     ${f('Giờ làm',fmtH(s.hours))}
    </div>
    <div class=att-view-row2>
     ${f('Đi muộn',s.late)}
     ${f('Nghỉ',s.absent)}
     ${f('Tăng ca',fmtH(s.ot))}
    </div>
   </div>
  </div>
  <div class=eu-ft>${attAdmin()?`<button onclick="editU(${i})"><i class="fa-solid fa-pen"></i> Sửa thông tin</button>`:''}<button class=p onclick="dx()">Đóng</button></div>
 </div>`);
 const bx=$('#dlg>.box');if(bx){bx.style.width='min(720px,96vw)';bx.style.maxHeight='94vh';bx.style.overflow='hidden'}}
/* ===== Bổ sung v101: xuất công nhân viên ra Excel (.xlsx) — từng nhân viên hoặc tất cả ===== */
const XL_CRC=(()=>{const t=[];for(let n=0;n<256;n++){let c=n;for(let k=0;k<8;k++)c=(c&1)?(0xEDB88320^(c>>>1)):(c>>>1);t[n]=c>>>0}return t})();
function xlCrc(b){let c=0xFFFFFFFF;for(let i=0;i<b.length;i++)c=XL_CRC[(c^b[i])&0xFF]^(c>>>8);return (c^0xFFFFFFFF)>>>0}
function xlEsc(s){return String(s==null?'':s).replace(/[&<>"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&apos;'}[ch]))}
function xlCol(n){let s='';n++;while(n>0){const m=(n-1)%26;s=String.fromCharCode(65+m)+s;n=Math.floor((n-1)/26)}return s}
function xlSheetXml(rows,widths){
 const cols=widths?`<cols>${widths.map((w,i)=>`<col min="${i+1}" max="${i+1}" width="${w}" customWidth="1"/>`).join('')}</cols>`:'';
 const body=rows.map((row,r)=>{const cells=row.map((c,ci)=>{if(c===null||c===undefined||c==='')return '';const ref=xlCol(ci)+(r+1);const isObj=c&&typeof c=='object';const bold=isObj&&c.b;const v=isObj?c.v:c;
   if(typeof v=='number'&&isFinite(v))return `<c r="${ref}"${bold?' s="1"':''}><v>${v}</v></c>`;
   return `<c r="${ref}" t="inlineStr"${bold?' s="1"':''}><is><t xml:space="preserve">${xlEsc(v)}</t></is></c>`}).join('');
   return `<row r="${r+1}">${cells}</row>`}).join('');
 return `<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n<worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">${cols}<sheetData>${body}</sheetData></worksheet>`}
function xlZip(files){const enc=new TextEncoder(),parts=[],cen=[];let off=0;
 const u16=v=>[v&255,(v>>>8)&255],u32=v=>[v&255,(v>>>8)&255,(v>>>16)&255,(v>>>24)&255];
 files.forEach(f=>{const nm=enc.encode(f.name),data=typeof f.data=='string'?enc.encode(f.data):f.data,crc=xlCrc(data),sz=data.length;
  const lh=new Uint8Array([...u32(0x04034b50),...u16(20),...u16(0x0800),...u16(0),...u16(0),...u16(0x21),...u32(crc),...u32(sz),...u32(sz),...u16(nm.length),...u16(0)]);
  const ch=new Uint8Array([...u32(0x02014b50),...u16(20),...u16(20),...u16(0x0800),...u16(0),...u16(0),...u16(0x21),...u32(crc),...u32(sz),...u32(sz),...u16(nm.length),...u16(0),...u16(0),...u16(0),...u16(0),...u32(0),...u32(off)]);
  parts.push(lh,nm,data);cen.push(ch,nm);off+=lh.length+nm.length+sz});
 const cenSz=cen.reduce((s,a)=>s+a.length,0);
 const end=new Uint8Array([...u32(0x06054b50),...u16(0),...u16(0),...u16(files.length),...u16(files.length),...u32(cenSz),...u32(off),...u16(0)]);
 const all=[...parts,...cen,end];const total=all.reduce((s,a)=>s+a.length,0);const out=new Uint8Array(total);let p=0;all.forEach(a=>{out.set(a,p);p+=a.length});return out}
function xlBuild(sheets){
 const safe=n=>(String(n).replace(/[\[\]\:\*\?\/\\]/g,' ').slice(0,31).trim())||'Sheet';
 const used=new Set();const names=sheets.map(s=>{const base=safe(s.name);let nm=base,k=2;while(used.has(nm.toLowerCase())){nm=base.slice(0,27)+' '+(k++)}used.add(nm.toLowerCase());return nm});
 const X='<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n';
 const files=[];
 files.push({name:'[Content_Types].xml',data:X+`<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types"><Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/><Default Extension="xml" ContentType="application/xml"/><Override PartName="/xl/workbook.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"/><Override PartName="/xl/styles.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.styles+xml"/>${sheets.map((s,i)=>`<Override PartName="/xl/worksheets/sheet${i+1}.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/>`).join('')}</Types>`});
 files.push({name:'_rels/.rels',data:X+`<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="xl/workbook.xml"/></Relationships>`});
 files.push({name:'xl/workbook.xml',data:X+`<workbook xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"><sheets>${names.map((n,i)=>`<sheet name="${xlEsc(n)}" sheetId="${i+1}" r:id="rId${i+1}"/>`).join('')}</sheets></workbook>`});
 files.push({name:'xl/_rels/workbook.xml.rels',data:X+`<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">${sheets.map((s,i)=>`<Relationship Id="rId${i+1}" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet" Target="worksheets/sheet${i+1}.xml"/>`).join('')}<Relationship Id="rId${sheets.length+1}" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/styles" Target="styles.xml"/></Relationships>`});
 files.push({name:'xl/styles.xml',data:X+`<styleSheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main"><fonts count="2"><font><sz val="11"/><name val="Calibri"/></font><font><b/><sz val="11"/><name val="Calibri"/></font></fonts><fills count="2"><fill><patternFill patternType="none"/></fill><fill><patternFill patternType="gray125"/></fill></fills><borders count="1"><border><left/><right/><top/><bottom/><diagonal/></border></borders><cellStyleXfs count="1"><xf numFmtId="0" fontId="0" fillId="0" borderId="0"/></cellStyleXfs><cellXfs count="2"><xf numFmtId="0" fontId="0" fillId="0" borderId="0" xfId="0"/><xf numFmtId="0" fontId="1" fillId="0" borderId="0" xfId="0" applyFont="1"/></cellXfs><cellStyles count="1"><cellStyle name="Normal" xfId="0" builtinId="0"/></cellStyles></styleSheet>`});
 sheets.forEach((s,i)=>files.push({name:`xl/worksheets/sheet${i+1}.xml`,data:xlSheetXml(s.rows,s.widths)}));
 return xlZip(files)}
const XL_WD=['Chủ nhật','Thứ 2','Thứ 3','Thứ 4','Thứ 5','Thứ 6','Thứ 7'];
function attWeekday(d){const [y,m,dd]=d.split('-').map(Number);return XL_WD[new Date(y,m-1,dd).getDay()]}
function xl2(x){return Math.round((x||0)*100)/100}
function attEmpSheet(u,month){
 const c=attCfg(),s=attStats(month,u.u),recs=attList().filter(r=>r.uid==u.u&&r.date.startsWith(month)).sort((a,b)=>a.date.localeCompare(b.date)||a.inAt-b.inAt),abs=attAbsent(month,u.u),today=ymd(Date.now());
 const rows=[];
 rows.push([{v:'BẢNG CÔNG NHÂN VIÊN',b:true}]);
 rows.push([`Họ và tên: ${u.name}`]);
 rows.push([`Tên đăng nhập: ${u.u}`]);
 rows.push([`Chức vụ: ${R[u.role]||u.role}`]);
 rows.push([`Tháng: ${month.slice(5)}/${month.slice(0,4)}`]);
 rows.push([`Ca chuẩn: ${c.start} – ${c.end} · Đi muộn cho phép: ${c.grace} phút · Giờ công chuẩn: ${c.std} giờ/ngày`]);
 rows.push([]);
 rows.push(['Ngày','Thứ','Giờ vào','Giờ ra','Số giờ làm','Đi muộn (phút)','Về sớm (phút)','Tăng ca (giờ)','Trạng thái','Chỉnh sửa gần nhất','Lý do chỉnh sửa'].map(x=>({v:x,b:true})));
 recs.forEach(r=>{const last=(r.edits||[]).slice(-1)[0];
  rows.push([dmy(r.date),attWeekday(r.date),hmOf(r.inAt),hmOf(r.outAt),r.outAt?xl2(r.hours):'',r.late>c.grace?r.late:0,(r.outAt&&r.early>0)?r.early:0,r.ot>0?xl2(r.ot):0,attStatus(r,today),last?`${last.by} · ${hmOf(last.at)} ${dmy(ymd(last.at))}`:'',last?last.reason:'']);});
 abs.forEach(a=>rows.push([dmy(a.date),attWeekday(a.date),'','',0,0,0,0,'Nghỉ (chưa chấm công)','','']));
 rows.push([]);
 rows.push([{v:'TỔNG HỢP',b:true}]);
 rows.push(['Số ngày công',s.days]);
 rows.push(['Tổng số giờ làm',xl2(s.hours)]);
 rows.push(['Số lần đi muộn',s.late]);
 rows.push(['Số ngày nghỉ',s.absent]);
 rows.push(['Số giờ tăng ca',xl2(s.ot)]);
 const nm=('NV '+u.name).replace(/\s+/g,' ');
 return {name:nm,rows,widths:[12,12,10,10,12,14,14,14,26,30,36]}}
function attSummarySheet(users,month){
 const rows=[];
 rows.push([{v:`TỔNG HỢP CÔNG NHÂN VIÊN THÁNG ${month.slice(5)}/${month.slice(0,4)}`,b:true}]);
 rows.push([]);
 rows.push(['Họ và tên','Tên đăng nhập','Chức vụ','Ngày công','Tổng giờ làm','Số lần đi muộn','Số ngày nghỉ','Giờ tăng ca'].map(x=>({v:x,b:true})));
 users.forEach(u=>{const s=attStats(month,u.u);rows.push([u.name,u.u,R[u.role]||u.role,s.days,xl2(s.hours),s.late,s.absent,xl2(s.ot)])});
 return {name:'Tổng hợp',rows,widths:[24,16,20,12,14,16,14,14]}}
async function attDownload(filename,bytes){
 let dl=null;
 if(window.claude&&typeof window.claude.use==='function'){try{dl=await window.claude.use('downloads')}catch(e){dl=null}
  if(!dl){toast('Không thể xuất tệp trong chế độ xem này.','err');return}
  try{await dl.save({filename,data:bytes});toast('Đã xuất '+filename,'ok')}
  catch(e){const code=e&&e.code;if(code=='declined')toast('Đã hủy lưu tệp.','err');else toast('Không thể lưu tệp Excel.','err')}
  return}
 const blob=new Blob([bytes],{type:'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'});
 const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download=filename;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),2000);
 toast('Đã xuất '+filename,'ok')}
function attExportUsers(users){if(!attCanView())return;const month=attF.month||ymd(Date.now()).slice(0,7);
 if(!users.length)return alert('Không có nhân viên để xuất.');
 const sheets=[attSummarySheet(users,month)].concat(users.map(u=>attEmpSheet(u,month)));
 const fname=users.length==1?`bang-cong-${users[0].u.replace(/[^A-Za-z0-9_-]/g,'_')}-${month}.xlsx`:`tong-hop-cong-${month}.xlsx`;
 attDownload(fname,xlBuild(sheets))}
function attExportOne(i){const u=S.users[i];if(!u)return;attExportUsers([u])}
function attExportAll(){attExportUsers(S.users.filter(u=>u.st!='off'))}
function qlStaffTab(){
 const admin=attAdmin(),view=attCanView(),q=(qlF.q||'').trim().toLowerCase(),rf=qlF.role||'',wf=qlF.ws||'',month=attF.month||ymd(Date.now()).slice(0,7);
 const rows=S.users.map((u,i)=>[u,i]).filter(([u])=>(!q||(u.name+' '+u.u).toLowerCase().includes(q))&&(!rf||u.role==rf)&&(!wf||qlKey(u)==wf));
 const st=pg('qlstaff',rows.length,10),page=rows.slice(st,st+10);
 const cnt=f=>S.users.filter(f).length;
 const stats=`<div class=qlstats>
  <div class=qlst style="--c:var(--pri)"><i class="fa-solid fa-users"></i><div><small>Tổng nhân viên</small><b>${S.users.length}</b></div></div>
  <div class=qlst style="--c:var(--ok)"><i class="fa-solid fa-circle-check"></i><div><small>Đang làm việc</small><b>${cnt(u=>u.st=='active'&&(u.ws||'working')=='working')}</b></div></div>
  <div class=qlst style="--c:var(--w)"><i class="fa-solid fa-plane-departure"></i><div><small>Đang nghỉ phép</small><b>${cnt(u=>u.st=='active'&&u.ws=='leave')}</b></div></div>
  <div class=qlst style="--c:var(--mut)"><i class="fa-solid fa-circle-pause"></i><div><small>Ngừng hoạt động</small><b>${cnt(u=>u.st=='off')}</b></div></div></div>`;
 const bar=`<details class="rp-fbox staff-fbox"${(devType()!='phone'||staffFb)?' open':''} ontoggle="if(devType()=='phone')staffFb=this.open">
  <summary class=rp-fsum><span class=rp-fi><i class="fa-solid fa-filter"></i></span><span>Bộ lọc</span><i class="fa-solid fa-chevron-up rp-fch"></i></summary>
  <div class="qlbar staff-fbody">
   <div class=qlsearch><i class="fa-solid fa-magnifying-glass"></i><input id=qlq class="qlin" placeholder="Tìm kiếm nhân viên..." value="${esc(qlF.q||'')}" oninput="qlF.q=this.value;PG.qlstaff=0;render();refocus('qlq')"></div>
   <div class=staff-frow2>
    <select class="qlin staff-frole" onchange="qlFilter('role',this.value)"><option value="">Tất cả chức vụ</option>${Object.entries(R).map(([k,v])=>`<option value=${k} ${k==rf?'selected':''}>${v}</option>`).join('')}</select>
    <select class="qlin staff-fws" onchange="qlFilter('ws',this.value)"><option value="">Tất cả trạng thái</option>${Object.entries(WSM).map(([k,v])=>`<option value=${k} ${k==wf?'selected':''}>${v}</option>`).join('')}<option value=locked ${wf=='locked'?'selected':''}>Đã khóa</option><option value=off ${wf=='off'?'selected':''}>Ngừng hoạt động</option></select>
   </div>
   <div class=staff-frow3>
    <input class="qlin staff-fm" type=month value="${month}" onchange="attSet('month',this.value)">
    <button class="p qlbtn staff-fclr" onclick="qlClear()" ${qlHasFilter()?'':'disabled'}>Xóa lọc</button>
   </div>
  </div>
 </details>`;
 const trs=page.map(([u,i])=>{const k=qlKey(u);const sl=k=='off'?'Ngừng hoạt động':k=='locked'?'Đã khóa':WSM[k];
  return `<tr style="${u.st!='active'?'opacity:.7':''}"><td><b>${esc(u.name)}</b></td><td><span class=qlpill style="--c:${qlRC[u.role]||'var(--mut)'}">${R[u.role]}</span></td><td class=col-ph>${esc(u.ph||'—')}</td><td class=col-em>${esc(u.em||'—')}</td><td><span class=qlpill style="--c:${qlSC[k]||'var(--mut)'}">${sl}</span></td><td class=col-st>${dmy(ymd(u.t))}</td><td class=qlact><button class=ib title="Xem chi tiết" aria-label="Xem chi tiết" onclick="qlViewOpen(${i})"><i class="fa-solid fa-eye"></i></button>${view?`<button class=ib title="Xuất công ra Excel" aria-label="Xuất công ra Excel" onclick="attExportOne(${i})"><i class="fa-solid fa-file-excel"></i></button>`:''}${admin?qlLockBtn(u,i):''}${admin?qlDelBtn(u,i):''}</td></tr>`}).join('');
 return stats+bar+`<section class=v2w-panel style="padding:0;overflow:hidden"><div class=sc><table><tr><th>Họ và tên</th><th>Chức vụ</th><th class=col-ph>Số điện thoại</th><th class=col-em>Email</th><th>Trạng thái</th><th class=col-st>Ngày vào làm</th><th style="text-align:center">Thao tác</th></tr>${trs||'<tr><td colspan=7 class=mut>Không có nhân viên phù hợp.</td></tr>'}</table></div>${pgBar(rows.length,10,PG.qlstaff,'nhân viên','PG.qlstaff')}</section>`}
PAGES.attendance=()=>{
 const tabs=qlTabs();const tab=tabs.includes(qlF.tab)?qlF.tab:tabs[0];qlF.tab=tab;
 const tb=(k,l,ic)=>`<button class="qltab ${tab==k?'on':''}" onclick="qlSetTab('${k}')"><i class="fa-solid ${ic}"></i> ${l}</button>`;
 const head=`<div><h3 style="margin:0 0 2px">Quản lý nhân viên</h3><div class=v2-sub>Theo dõi nhân sự, chấm công và thống kê công</div></div>`;
 const addBtn=(attAdmin()&&tab=='staff')?`<button class="p qlbtn" onclick="qlAddOpen()"><i class="fa-solid fa-plus"></i> Thêm nhân viên</button>`:'';
 const xBtn=attCanView()?`<button class="p qlbtn" onclick="attExportAll()"><i class="fa-solid fa-file-excel"></i> Xuất Excel</button>`:'';
 const tabsHtml=`<div class=qltabbar><div class=qltabs>${tabs.includes('staff')?tb('staff','Nhân viên','fa-users'):''}${tb('att','Chấm công','fa-calendar-check')}${tabs.includes('stat')?tb('stat','Thống kê','fa-chart-column'):''}</div><div style="display:flex;gap:8px;flex-wrap:wrap">${xBtn}${addBtn}</div></div>`;
 const body=tab=='staff'?qlStaffTab():tab=='stat'?qlStatTab():qlAttBody();
 return head+tabsHtml+body};
/* ===== Bổ sung v102: xác nhận tiếng Việt trước khi xuất Excel; nút Xóa lọc ở danh sách nhân viên ===== */
let attPending=null;
function qlClear(){qlF.q='';qlF.role='';qlF.ws='';PG.qlstaff=0;render()}
function attExportUsers(users){if(!attCanView())return;const month=attF.month||ymd(Date.now()).slice(0,7);
 if(!users.length)return alert('Không có nhân viên để xuất.');
 const fname=users.length==1?`bang-cong-${users[0].u.replace(/[^A-Za-z0-9_-]/g,'_')}-${month}.xlsx`:`tong-hop-cong-${month}.xlsx`;
 attPending={users,month,fname};
 dlg(`<div class=eu-wrap>
  <div class=eu-hd><h4>Xác nhận xuất công</h4><div class=v2-sub>Kiểm tra thông tin trước khi xuất file Excel.</div></div>
  <div class=eu-body>
   <div class=eu-sec><div class=eu-st>Thông tin xuất</div><div class=eu-grid>
    <div class=vw-f><div class=vw-l>Kỳ công</div><div class=vw-v>Tháng ${month.slice(5)}/${month.slice(0,4)}</div></div>
    <div class=vw-f><div class=vw-l>Đối tượng</div><div class=vw-v>${users.length==1?esc(users[0].name):`Tất cả nhân viên (${users.length} người)`}</div></div>
    <div class="vw-f vw-full"><div class=vw-l>Tên tệp</div><div class=vw-v>${esc(fname)}</div></div>
    <div class="vw-f vw-full"><div class=vw-l>Nội dung</div><div class=vw-v>${users.length==1?'Sheet tổng hợp và bảng công chi tiết theo ngày của nhân viên':'Sheet tổng hợp và một sheet bảng công cho từng nhân viên'}</div></div>
   </div></div>
  </div>
  <div class=eu-ft><button onclick="attPending=null;dx()">Hủy</button><button class=p onclick="attConfirmExport()">Xuất file Excel</button></div>
 </div>`);
 const bx=$('#dlg>.box');if(bx){bx.style.width='min(560px,96vw)';bx.style.maxHeight='94vh';bx.style.overflow='hidden'}}
function attConfirmExport(){if(!attPending)return;const {users,month,fname}=attPending;attPending=null;dx();
 const sheets=[attSummarySheet(users,month)].concat(users.map(u=>attEmpSheet(u,month)));
 attDownload(fname,xlBuild(sheets))}
/* ===== Bổ sung v103: nút Xóa lọc không có màu nền ===== */
document.head.insertAdjacentHTML('beforeend',`<style>
button[onclick="qlClear()"]{background:transparent!important;color:var(--fg)!important;border:1px solid var(--bd)!important;box-shadow:none!important}
</style>`);
/* ===== Bổ sung v104: trên máy tính, nút Hủy nằm cạnh nút Lưu ở bên phải của form ===== */
document.head.insertAdjacentHTML('beforeend',`<style>
html:not([data-dev=phone]) #dlg .row,html:not([data-dev=phone]) #modal .row:has(> button.p){justify-content:flex-end!important}
</style>`);
/* ===== Bổ sung v105: nút X của hộp thoại được đưa lên, chữ không bị che ===== */
document.head.insertAdjacentHTML('beforeend',`<style>
#dlg .mx{top:2px!important;right:2px!important}
#dlg>.box>p,#dlg>.box>h4,#dlg .eu-hd{padding-right:44px!important}
</style>`);
/* ===== Bổ sung v106: Quản lý nhân viên — bỏ nút sửa ở thao tác; nút Xóa lọc chỉ bật khi có điều kiện lọc, còn lại xám ===== */
function qlHasFilter(){return !!((qlF.q||'').trim()||qlF.role||qlF.ws)}
document.head.insertAdjacentHTML('beforeend',`<style>
button[onclick="qlClear()"]{color:var(--fg)!important}
button[onclick="qlClear()"]:disabled{color:var(--mut)!important;border-color:var(--bd)!important;opacity:.55;cursor:not-allowed}
</style>`);
/* ===== Bổ sung v107: nút Xóa lọc khi xám thì không nhận rê chuột và không bấm được ===== */
document.head.insertAdjacentHTML('beforeend',`<style>
button[onclick="qlClear()"]:disabled{pointer-events:none!important}
button[onclick="qlClear()"]:disabled:hover,button[onclick="qlClear()"]:disabled:focus,button[onclick="qlClear()"]:disabled:active{background:transparent!important;color:var(--mut)!important;border-color:var(--bd)!important;box-shadow:none!important;transform:none!important;filter:none!important;opacity:.55!important}
</style>`);
/* ===== Bổ sung v108: hộp chọn bàn khi Chuyển bàn / Gộp bàn: thẻ bàn theo kiểu mới trong lưới nhiều cột ===== */
function v2oPick(mode){const L=mode=='move'?S.tables.filter(x=>x.st=='free'&&!x.off&&x.id!=cur):S.tables.filter(x=>x.st=='busy'&&x.id!=cur&&tOrders(x.id).length);
 if(!L.length)return toast(mode=='move'?'Không có bàn trống để chuyển.':'Không có bàn có khách để gộp.','warn');
 const title=mode=='move'?'Chuyển bàn':'Gộp bàn';
 const sub=mode=='move'?'Chọn bàn trống để chuyển toàn bộ đơn sang bàn đó':'Chọn bàn có khách để gộp đơn vào bàn '+tn(cur);
 dlg(`<div class=eu-wrap>
  <div class=eu-hd><h4>${title}</h4><div class=v2-sub>${esc(sub)}</div></div>
  <div class=eu-body><div class=v2-pickgrid>${L.map(x=>{const n=tOrders(x.id).length,busy=x.st=='busy',c=V2TS[x.st]||'var(--mut)';
   return `<button class=v2c style="--c:${c}" onclick="v2oDo('${mode}',${x.id})"><span class=v2c-top><span class=v2c-name>${esc(x.name)}</span><span class=v2c-st><span class=v2c-dot></span>${TS[x.st]}</span></span><span class=v2c-n><i class="fa-solid fa-users"></i><span>${n} đơn</span></span><span class=v2c-foot><span class=v2c-amt>${busy?money(tTotal(x.id)):'—'}</span><i class="fa-solid fa-chevron-right v2c-go"></i></span></button>`}).join('')}</div></div>
  <div class=eu-ft><button onclick="dx()">Hủy</button></div>
 </div>`);
 const bx=$('#dlg>.box');if(bx){bx.style.width='min(720px,96vw)';bx.style.maxHeight='94vh';bx.style.overflow='hidden'}}
/* ===== Đồng bộ dữ liệu giữa các thiết bị (máy chủ Node.js): gộp ba chiều theo mã ===== */
let ver=0,tok=null,busy=false,again=false,needInit=false,syncBase=null,pushFail=0;
try{const _st=localStorage.getItem('nh_token'),_sm=localStorage.getItem('nh_user');if(_st&&_sm){tok=_st;me=JSON.parse(_sm)}}catch(_){}
const jf=async(u,o={})=>{o=Object.assign({},o);o.headers=Object.assign({},tok?{'x-token':tok}:{},o.headers||{});const r=await fetch(u,o);let j=null;try{j=await r.json()}catch(e){}return{ok:r.ok,s:r.status,j}};
const eqj=(a,b)=>JSON.stringify(a)===JSON.stringify(b),cloneJ=x=>JSON.parse(JSON.stringify(x));
const ckey=x=>x&&typeof x=='object'?(x.id!==undefined?x.id:x.u!==undefined?x.u:x.acc!==undefined?x.acc:undefined):undefined;
function m3(b,l,r){if(eqj(l,r))return r;if(eqj(l,b))return r;if(eqj(r,b))return l;
 if(Array.isArray(l)&&Array.isArray(r)){
  if([...l,...r].every(x=>ckey(x)!==undefined)){const bm=new Map((Array.isArray(b)?b:[]).filter(x=>ckey(x)!==undefined).map(x=>[ckey(x),x])),lm=new Map(l.map(x=>[ckey(x),x])),rm=new Map(r.map(x=>[ckey(x),x])),out=[],seen=new Set();
   for(const k of [...r.map(ckey),...l.map(ckey)]){if(seen.has(k))continue;seen.add(k);const inL=lm.has(k),inR=rm.has(k),inB=bm.has(k);
    if(inL&&inR)out.push(m3(bm.get(k),lm.get(k),rm.get(k)));
    else if(inL){if(!inB||!eqj(lm.get(k),bm.get(k)))out.push(lm.get(k))}
    else if(!inB||!eqj(rm.get(k),bm.get(k)))out.push(rm.get(k))}
   return out}
  const seen=new Set(),out=[];for(const x of [...r,...l]){const j=JSON.stringify(x);if(!seen.has(j)){seen.add(j);out.push(x)}}return out}
 if(l&&r&&typeof l=='object'&&typeof r=='object'&&!Array.isArray(l)&&!Array.isArray(r)){const bb=b&&typeof b=='object'?b:{},o={};for(const k of new Set([...Object.keys(l),...Object.keys(r)]))o[k]=m3(bb[k],l[k],r[k]);return o}
 return l}
function setSync(st){const e=document.getElementById('sbadge');if(!e)return;const L={ok:'Đã đồng bộ',busy:'Đang đồng bộ...',off:'Chưa kết nối'};e.className='sbadge '+st;e.innerHTML='<i></i>'+L[st]}
async function pull(){let x;try{x=!me?await jf('/api/public?table='+(QR||0)):await jf('/api/state',{headers:{'x-token':tok||''}})}catch(e){setSync('off');return false}
 if(!x.ok||!x.j){if(x.s==401&&me){toast('Phiên đăng nhập đã hết hạn','err');tok=null;me=null;try{localStorage.removeItem('nh_token');localStorage.removeItem('nh_user')}catch(_){}render()}setSync('off');return false}
 ver=x.j.v;const rem=x.j.state||{};needInit=!rem.menu&&!(QR&&!me);
 S=Object.assign(seed(),syncBase?m3(syncBase,S,rem):rem);syncBase=cloneJ(rem);setSync('ok');return true}
function save(){prevS=cloneJ(S);if(!tok)return;if(busy){again=true;return}push()}
async function push(){busy=true;setSync('busy');let ok=false,lost=false;
 try{for(let n=0;n<4&&!ok&&!lost;n++){const snap=cloneJ(S);const x=await jf('/api/state',{method:'PUT',headers:{'Content-Type':'application/json','x-token':tok||''},body:JSON.stringify({v:ver,state:snap})});
  if(x.ok){ver=x.j.v;syncBase=snap;ok=true}
  else if(x.s==409&&x.j&&x.j.state){const rem=x.j.state;S=Object.assign(seed(),syncBase?m3(syncBase,S,rem):rem);syncBase=cloneJ(rem);ver=x.j.v;render()}
  else if(x.s==401){toast('Phiên đăng nhập đã hết hạn','err');tok=null;me=null;try{localStorage.removeItem('nh_token');localStorage.removeItem('nh_user')}catch(_){}lost=true;render()}
  else lost=true}
 }catch(e){lost=true}
 busy=false;const ag=again;again=false;
 if(ok){pushFail=0;setSync('ok');if(ag)push()}
 else if(tok){setSync('off');if(++pushFail<=10)setTimeout(()=>{if(!busy&&tok)push()},5000)}
 else setSync('off')}
async function sync(){const before=JSON.stringify(S);if(!await pull())return;if(JSON.stringify(S)===before)return;if(me)diffNotify();render();if(me&&cur&&$('#modal').classList.contains('on'))drawT()}
async function login(){const u=$('#u').value.trim(),p=$('#p').value,e=m=>$('#er').textContent=m;let x;try{x=await jf('/api/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({u,p})})}catch(_){return e('Không kết nối được máy chủ.')}
 if(!x.ok)return e((x.j&&x.j.error)||'Đăng nhập thất bại.');getSndCtx();tok=x.j.token;me=x.j.user;try{localStorage.setItem('nh_token',tok);localStorage.setItem('nh_user',JSON.stringify(me))}catch(_){}if(!await pull()){tok=null;me=null;return e('Không tải được dữ liệu.')}
 if(needInit){needInit=false;save()}page=Object.keys(NAV).find(k=>k!='home'&&NAV[k][1].includes(me.role))||'pos';last=Date.now();loginModalOpen=false;render();logA('Đăng nhập',R[me.role])}
{const o=logout;window.logout=()=>{o();tok=null;syncBase=null;try{localStorage.removeItem('nh_token');localStorage.removeItem('nh_user')}catch(_){}loginModalOpen=false;page='pos'}}
async function qSend(){if(Date.now()-(window.lastQ||0)<8000)return alert('Vui lòng đợi vài giây trước khi gửi lại.');window.lastQ=Date.now();
 const r=await jf('/api/order',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({table:+QR,by:$('#qt').value.trim()||'Khách',note:$('#qn').value.trim(),items:cart.map(c=>({id:c.id,qty:c.qty}))})}).catch(()=>null);
 if(!r||!r.ok){window.lastQ=0;return alert((r&&r.j&&r.j.error)||'Không gửi được order, vui lòng thử lại hoặc gọi nhân viên.')}
 cart=[];await pull();render();toast('Đã gửi order '+r.j.id+'. Nhân viên sẽ xác nhận trong giây lát.','ok',6000)}
async function boot(){document.head.insertAdjacentHTML('beforeend','<style>.sbadge,#sbadge{display:none!important}</style>');
 if(Array.isArray(S&&S.tables)){S.tables.forEach(t=>{if(!t.type){if(t.id<=8)t.type='standard';else if(t.id<=12)t.type='outdoor';else if(t.id<=16)t.type='vip';else t.type='event'}if(t.id>=9&&t.id<=12&&t.name==='B'+t.id)t.name='B'+(t.id-8);else if(t.id>=13&&t.id<=16&&t.name==='B'+t.id)t.name='B'+(t.id-12);else if(t.id>=17&&t.id<=20&&t.name==='B'+t.id)t.name='B'+(t.id-16)});}
 if(QR){$('#app').innerHTML='<div class="box login">Đang tải thực đơn...</div>';if(await pull())render();else $('#app').innerHTML='<div class="box login">Không kết nối được máy chủ. Vui lòng thử lại.</div>'}else{pull().then(()=>{if(!me)render()});render()}
 const es=new EventSource('/api/events');es.onopen=()=>{setSync(busy?'busy':'ok');if(me||QR)sync()};es.onerror=()=>setSync('off');es.onmessage=ev=>{if(+ev.data!==ver&&(me||QR))sync()};
 setInterval(()=>{if(!busy&&(me||QR))sync()},15000);
 document.addEventListener('visibilitychange',()=>{if(!document.hidden&&(me||QR))sync()})}





/* ===== Bổ sung v109: Giao diện đăng nhập hiện đại, căn giữa hoàn hảo, tương thích cả máy tính và điện thoại ===== */
document.head.insertAdjacentHTML('beforeend',`<style>
body:not(.in):not(.qrm){min-height:100vh;overflow-y:auto}
body:not(.in):not(.qrm) #app,html[data-dev=phone] body:not(.in):not(.qrm) #app{display:flex!important;flex-direction:column!important;align-items:center!important;justify-content:center!important;min-height:100vh!important;min-height:100dvh!important;width:100%!important;padding:32px 16px!important;background:var(--bg)!important;box-sizing:border-box!important;margin:0!important}
.login-card{width:100%!important;max-width:420px!important;margin:0 auto!important;padding:32px 28px!important;background:var(--card)!important;border:1px solid var(--bd)!important;border-radius:22px!important;box-shadow:0 14px 40px rgba(27,38,59,.08),0 2px 6px rgba(0,0,0,.03)!important;display:flex!important;flex-direction:column!important;align-items:stretch!important;height:auto!important;align-self:center!important;box-sizing:border-box!important}
.login-hd{text-align:center;margin-bottom:22px}
.login-brand-icon{width:56px;height:56px;border-radius:16px;background:color-mix(in srgb,var(--pri) 12%,var(--card));color:var(--pri);font-size:24px;display:inline-flex;align-items:center;justify-content:center;margin-bottom:12px;box-shadow:0 4px 12px rgba(27,38,59,.08)}
.login-title{margin:0 0 4px!important;font-size:22px!important;font-weight:800!important;color:var(--fg)}
.login-sub{margin:0!important;color:var(--mut)!important;font-size:14px!important}
.login-form{display:flex;flex-direction:column;gap:12px}
.login-field{position:relative;width:100%}
.login-field .lf-ic{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--mut);font-size:15px;pointer-events:none;z-index:2}
.login-field input{width:100%!important;margin:0!important;padding:12px 14px 12px 42px!important;border:1px solid var(--bd)!important;border-radius:12px!important;background:var(--bg)!important;font-size:15px!important;color:var(--fg);box-sizing:border-box!important;transition:border-color .15s,box-shadow .15s}
.login-field input:focus{border-color:var(--pri)!important;outline:none;box-shadow:0 0 0 3px color-mix(in srgb,var(--pri) 18%,transparent)!important}
.login-field.lpw input{padding-right:44px!important}
.login-field .lpw-eye{position:absolute;right:6px;top:50%;transform:translateY(-50%);width:36px;height:36px;border:0;background:transparent;color:var(--mut);cursor:pointer;display:flex;align-items:center;justify-content:center;z-index:2;font-size:15px}
#er.err{margin:0!important;font-size:13px!important;color:var(--bad)!important;font-weight:500!important;text-align:left!important}
#er.err:not(:empty){padding:9px 12px!important;background:color-mix(in srgb,var(--bad) 10%,var(--card))!important;border:1px solid color-mix(in srgb,var(--bad) 25%,transparent)!important;border-radius:10px!important;margin:4px 0!important}
.login-btn{width:100%!important;min-height:48px!important;margin-top:6px!important;border-radius:12px!important;font-size:16px!important;font-weight:700!important;background:var(--pri)!important;color:#fff!important;border:0!important;cursor:pointer;box-shadow:0 4px 14px rgba(27,38,59,.2)!important;display:flex!important;align-items:center!important;justify-content:center!important;gap:8px!important;transition:transform .1s,opacity .15s,filter .15s}
.login-btn:hover{filter:brightness(1.1)!important}
.login-btn:active{transform:scale(.99)!important}
.login-extra{text-align:center;margin-top:4px}
.login-forgot{color:var(--mut)!important;font-size:13px!important;text-decoration:none!important;display:inline-block;padding:4px 8px}
.login-forgot:hover{color:var(--pri)!important;text-decoration:underline!important}
.login-demo{margin-top:20px;padding-top:18px;border-top:1px dashed var(--bd)}
.login-demo-lbl{font-size:12px!important;font-weight:600!important;color:var(--mut)!important;text-transform:uppercase!important;letter-spacing:.5px!important;margin-bottom:10px!important;text-align:center!important;display:flex!important;align-items:center!important;justify-content:center!important;gap:6px!important}
.login-demo-chips{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}
.ld-chip{display:flex;flex-direction:column;align-items:flex-start;gap:2px;padding:8px 12px!important;border-radius:12px!important;border:1px solid var(--bd)!important;background:var(--bg)!important;color:var(--fg)!important;cursor:pointer;text-align:left;transition:all .15s ease;font-family:inherit}
.ld-chip:hover{border-color:var(--pri)!important;background:color-mix(in srgb,var(--pri) 8%,var(--card))!important;transform:translateY(-1px)}
.ld-chip b{font-size:13px!important;color:var(--fg)!important;font-weight:700!important;line-height:1.2!important}
.ld-chip span{font-size:11px!important;color:var(--mut)!important;line-height:1.2!important}
/* Modal Quên mật khẩu */
.fp-overlay{position:fixed;inset:0;background:rgba(15,23,42,0.72);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);display:none;align-items:center;justify-content:center;z-index:99999;padding:16px;box-sizing:border-box}
.fp-overlay.on{display:flex}
.fp-box{background:var(--card,#fff);color:var(--fg,#1e293b);width:min(460px,96vw);border-radius:20px;padding:28px 24px;box-shadow:0 24px 50px rgba(0,0,0,0.32);border:1px solid var(--bd,#e2e8f0);position:relative;animation:fpIn .2s cubic-bezier(.16,1,.3,1);box-sizing:border-box}
@keyframes fpIn{from{opacity:0;transform:scale(.95) translateY(10px)}to{opacity:1;transform:scale(1) translateY(0)}}
.fp-close{position:absolute;top:16px;right:16px;background:none;border:none;font-size:18px;color:var(--mut,#64748b);cursor:pointer;width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;transition:all .15s}
.fp-close:hover{background:rgba(0,0,0,0.06);color:var(--fg,#0f172a)}
.fp-icon{width:56px;height:56px;border-radius:16px;background:color-mix(in srgb,var(--pri,#1b263b) 12%,transparent);color:var(--pri,#1b263b);display:flex;align-items:center;justify-content:center;font-size:24px;margin:0 auto 14px}
.fp-title{text-align:center;font-size:20px;font-weight:700;margin:0 0 6px;color:var(--fg,#0f172a)}
.fp-sub{text-align:center;font-size:13px;color:var(--mut,#64748b);margin:0 0 18px;line-height:1.5}
.fp-alert{padding:12px 14px;border-radius:12px;font-size:13px;line-height:1.5;margin-bottom:14px;display:flex;align-items:flex-start;gap:10px;box-sizing:border-box}
.fp-alert-info{background:#eff6ff;color:#1e40af;border:1px solid #bfdbfe}
.fp-alert-demo{background:#fef9c3;color:#854d0e;border:1px solid #fef08a}
.fp-resend{display:flex;justify-content:space-between;align-items:center;margin-top:14px;padding-top:12px;border-top:1px dashed var(--bd,#e2e8f0);font-size:13px;color:var(--mut,#64748b)}
.fp-resend a{color:var(--pri,#1b263b);text-decoration:none;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;gap:4px}
.fp-resend a:hover{text-decoration:underline}
@media (max-width:480px),(max-device-width:480px){
 body:not(.in):not(.qrm) #app,html[data-dev=phone] body:not(.in):not(.qrm) #app{padding:16px 12px!important}
