function rpKi(i,l,v){return`<span class=rp-ki title="${esc(l)}: ${esc(String(v))}"><span class=rp-kic><i class="fa-solid ${i}"></i></span><span class=rp-kt><small>${l}</small><b>${v}</b></span></span>`}
