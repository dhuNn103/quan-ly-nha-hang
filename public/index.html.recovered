function getHpServices(forEditor = false) {
  const saved = (Array.isArray(S.cfg.hpServices) && S.cfg.hpServices.length === 4) ? S.cfg.hpServices : null;
  if (!forEditor && hpLang === 'en') {
    return HP_DEFAULT_SERVICES_EN.map((enItem, i) => {
      if (!saved) return { ...enItem };
      const viDef = HP_DEFAULT_SERVICES_VI[i];
      const cur = saved[i] || {};
      const t = (cur.title || '').trim();
      const d = (cur.desc || '').trim();
      const lt = (cur.linkText || '').trim();
      return {
        ...enItem,
        img: cur.img || enItem.img,
        icon: cur.icon || enItem.icon,
        link: cur.link || enItem.link,
        title: (!t || t === viDef.title || t === enItem.title) ? enItem.title : t,
        desc: (!d || d === viDef.desc || d === enItem.desc) ? enItem.desc : d,
        linkText: (!lt || lt === viDef.linkText || lt === enItem.linkText) ? enItem.linkText : lt
      };
    });
  }
  if (!saved) return HP_DEFAULT_SERVICES_VI.map(s => ({ ...s }));
  return saved.map((cur, i) => {
    const viDef = HP_DEFAULT_SERVICES_VI[i];
    const enDef = HP_DEFAULT_SERVICES_EN[i];
    const t = (cur && cur.title ? cur.title : '').trim();
    const d = (cur && cur.desc ? cur.desc : '').trim();
    const lt = (cur && cur.linkText ? cur.linkText : '').trim();
    return {
      ...viDef,
      ...cur,
      title: (!t || t === enDef.title) ? viDef.title : t,
      desc: (!d || d === enDef.desc) ? viDef.desc : d,
      linkText: (!lt || lt === enDef.linkText) ? viDef.linkText : lt
    };
  });
}

