function hpInitQuoteTypewriter() {
  const quoteSec = document.querySelector('.hp-aboutpage-chef-quote');
  const quoteEl = document.getElementById('hp-chef-quote-text') || (quoteSec ? quoteSec.querySelector('p') : null);
  if (!quoteSec || !quoteEl) return;

  const fullText = quoteEl.getAttribute('data-full-text') || quoteEl.textContent.trim();
  quoteEl.setAttribute('data-full-text', fullText);

  let animFrameId = null;
  let isTyping = false;
  let hideCursorTimer = null;

  const renderText = (currentText, showCursor) => {
    const cursorHtml = showCursor ? '<span class="hp-typewriter-cursor">|</span>' : '';
    if (!currentText) {
      quoteEl.innerHTML = cursorHtml;
      return;
    }
    const lastSpaceIdx = currentText.lastIndexOf(' ');
    if (lastSpaceIdx === -1) {
      quoteEl.innerHTML = `<span class="hp-typewriter-glue">${esc(currentText)}${cursorHtml}</span>`;
      return;
    }
    const lead = currentText.slice(0, lastSpaceIdx + 1);
    const trail = currentText.slice(lastSpaceIdx + 1);
    if (trail.length === 0) {
      // Kết thúc bằng dấu cách: gắn từ liền trước, dấu cách và con trỏ thành một khối không ngắt dòng
      const prevText = lead.slice(0, -1);
      const prevSpaceIdx = prevText.lastIndexOf(' ');
      const prevWord = prevSpaceIdx === -1 ? prevText : prevText.slice(prevSpaceIdx + 1);
      const beforePrev = prevSpaceIdx === -1 ? '' : prevText.slice(0, prevSpaceIdx + 1);
      quoteEl.innerHTML = `${esc(beforePrev)}<span class="hp-typewriter-glue">${esc(prevWord)} ${cursorHtml}</span>`;
      return;
    }
    quoteEl.innerHTML = `${esc(lead)}<span class="hp-typewriter-glue">${esc(trail)}${cursorHtml}</span>`;
  };

  const startTyping = () => {
    if (isTyping) return;
    isTyping = true;
    if (animFrameId) cancelAnimationFrame(animFrameId);
    if (hideCursorTimer) clearTimeout(hideCursorTimer);

    quoteSec.classList.add('hp-typing');
    quoteSec.classList.remove('hp-typed');

    renderText('', true);

    let charIdx = 0;
    let lastTime = performance.now();
    const charInterval = 22; // 22ms mỗi ký tự: nhịp gõ êm ái, sắc nét, con trỏ bám sát từng chữ

    const typeStep = (now) => {
      const delta = now - lastTime;
      if (delta >= charInterval) {
        const steps = Math.floor(delta / charInterval);
        charIdx = Math.min(charIdx + steps, fullText.length);
        lastTime = now;

        const currentText = fullText.slice(0, charIdx);
        const isDone = charIdx >= fullText.length;

        if (!isDone) {
          renderText(currentText, true);
        } else {
          isTyping = false;
          quoteSec.classList.remove('hp-typing');
          quoteSec.classList.add('hp-typed');
          // Giữ cursor nhấp nháy ở cuối câu trọn vẹn 1.5s rồi nhẹ nhàng ẩn đi
          renderText(fullText, true);
          hideCursorTimer = setTimeout(() => {
            if (quoteEl) quoteEl.textContent = fullText;
          }, 1800);
          return;
        }
      }
      animFrameId = requestAnimationFrame(typeStep);
    };

    animFrameId = requestAnimationFrame(typeStep);
  };

  const resetTyping = () => {
    if (animFrameId) cancelAnimationFrame(animFrameId);
    if (hideCursorTimer) clearTimeout(hideCursorTimer);
    isTyping = false;
    quoteSec.classList.remove('hp-typing', 'hp-typed');
    renderText('', true);
  };

  if ('IntersectionObserver' in window) {
    if (window._hpQuoteObserver) {
      try { window._hpQuoteObserver.disconnect(); } catch (_) {}
    }
    window._hpQuoteObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          startTyping();
        } else {
          // Khi cuộn ra khỏi vùng nhìn thấy thì reset để khi cuộn lại sẽ gõ lại từ đầu
          resetTyping();
        }
      });
    }, { threshold: 0.2 });
    window._hpQuoteObserver.observe(quoteSec);
  } else {
    const onScroll = () => {
      const rect = quoteSec.getBoundingClientRect();
      const inView = rect.top < window.innerHeight * 0.85 && rect.bottom > 50;
      if (inView) {
        startTyping();
      } else {
        resetTyping();
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
}

function hpInitStatsCounters() {
  const container = document.querySelector('.hp-aboutpage-stats-sec');
  if (!container) return;

  const items = container.querySelectorAll('.hp-stat-counter');
  if (!items.length) return;

  const runAnimation = () => {
    items.forEach(el => {
      if (el.dataset.animating === 'true') return;
      el.dataset.animating = 'true';

      const target = parseFloat(el.getAttribute('data-target')) || 0;
      const decimals = parseInt(el.getAttribute('data-decimals') || '0', 10);
      const suffix = el.getAttribute('data-suffix') || '';
      const prefix = el.getAttribute('data-prefix') || '';
      const useDots = el.getAttribute('data-dots') === 'true';
      const duration = 1800; // 1.8s mượt mà
      const startTime = performance.now();

      const formatVal = (num) => {
        if (decimals > 0) return num.toFixed(decimals);
        const rounded = Math.round(num);
        if (useDots) {
          return rounded.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ".");
        }
        return rounded.toString();
      };

      const step = (now) => {
        const elapsed = now - startTime;
        const progress = Math.min(elapsed / duration, 1);
        // Ease-out cubic: chuyển động chạy nhanh lúc đầu và hãm phanh êm ái khi về đích
        const ease = 1 - Math.pow(1 - progress, 3);
        const current = ease * target;

        el.textContent = prefix + formatVal(current) + suffix;

        if (progress < 1) {
          requestAnimationFrame(step);
        } else {
          el.textContent = prefix + formatVal(target) + suffix;
          el.dataset.animating = 'done';
        }
      };

      requestAnimationFrame(step);
    });
  };

  const resetAnimation = () => {
    items.forEach(el => {
      el.dataset.animating = 'false';
      const decimals = parseInt(el.getAttribute('data-decimals') || '0', 10);
      const suffix = el.getAttribute('data-suffix') || '';
      const prefix = el.getAttribute('data-prefix') || '';
      const initial = decimals > 0 ? (0).toFixed(decimals) : '0';
      el.textContent = prefix + initial + suffix;
    });
  };

  // Khởi tạo ban đầu hiển thị số 0
  items.forEach(el => {
    if (!el.dataset.animating || el.dataset.animating === 'false') {
      const decimals = parseInt(el.getAttribute('data-decimals') || '0', 10);
      const suffix = el.getAttribute('data-suffix') || '';
      const prefix = el.getAttribute('data-prefix') || '';
      const initial = decimals > 0 ? (0).toFixed(decimals) : '0';
      el.textContent = prefix + initial + suffix;
    }
  });

  if ('IntersectionObserver' in window) {
    if (window._hpStatsObserver) {
      try { window._hpStatsObserver.disconnect(); } catch(_) {}
    }
    window._hpStatsObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          runAnimation();
        } else {
          // Khi cuộn ra khỏi vùng nhìn thấy thì reset về 0 để khi cuộn lại sẽ chạy lại từ 0
          resetAnimation();
        }
      });
    }, { threshold: 0.15 });
    window._hpStatsObserver.observe(container);
  } else {
    // Fallback khi không hỗ trợ IntersectionObserver
    const onScroll = () => {
      const rect = container.getBoundingClientRect();
      const inView = rect.top < window.innerHeight * 0.85 && rect.bottom > 50;
      if (inView) {
        runAnimation();
      } else if (rect.top > window.innerHeight || rect.bottom < 0) {
        resetAnimation();
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
}

function hpInitAboutAnimation() {
  const sec = document.getElementById('about');
  if (!sec) return;

  sec.classList.add('hp-about-scroll-ready');

  if (window._hpAboutObserver) {
    try { window._hpAboutObserver.disconnect(); } catch (_) {}
  }

  const handleIntersect = (entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        sec.classList.add('hp-in-view');
      } else {
        // Reset khi cuộn ra khỏi vùng nhìn thấy để khi cuộn lại sẽ chạy lại lần lượt từ ngoài vào
        sec.classList.remove('hp-in-view');
      }
    });
  };

  if ('IntersectionObserver' in window) {
    window._hpAboutObserver = new IntersectionObserver(handleIntersect, {
      threshold: 0.15
    });
    window._hpAboutObserver.observe(sec);
  } else {
    const onScroll = () => {
      const rect = sec.getBoundingClientRect();
      const inView = rect.top < window.innerHeight * 0.85 && rect.bottom > 60;
      if (inView) {
        sec.classList.add('hp-in-view');
      } else {
        sec.classList.remove('hp-in-view');
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
}

function hpInitServicesAnimation() {
  const sec = document.getElementById('space') || document.querySelector('.hp-services-sec');
  if (!sec) return;

  sec.classList.add('hp-services-scroll-ready');

  if (window._hpServicesObserver) {
    try { window._hpServicesObserver.disconnect(); } catch (_) {}
  }

  const handleIntersect = (entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        sec.classList.add('hp-in-view');
      } else {
        // Reset khi cuộn ra khỏi vùng nhìn thấy để khi cuộn lại sẽ chạy lại lần lượt
        sec.classList.remove('hp-in-view');
      }
    });
  };

  if ('IntersectionObserver' in window) {
    window._hpServicesObserver = new IntersectionObserver(handleIntersect, {
      threshold: 0.15
    });
    window._hpServicesObserver.observe(sec);
  } else {
    const onScroll = () => {
      const rect = sec.getBoundingClientRect();
      const inView = rect.top < window.innerHeight * 0.85 && rect.bottom > 60;
      if (inView) {
        sec.classList.add('hp-in-view');
      } else {
        sec.classList.remove('hp-in-view');
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
}

function hpInitFeaturedAnimation() {
  const sec = document.getElementById('menu') || document.querySelector('.hp-featured-sec');
  if (!sec) return;

  sec.classList.add('hp-featured-scroll-ready');

  if (window._hpFeaturedObserver) {
    try { window._hpFeaturedObserver.disconnect(); } catch (_) {}
  }

  const handleIntersect = (entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        sec.classList.add('hp-in-view');
      } else {
        // Reset khi cuộn ra khỏi vùng nhìn thấy để khi cuộn lại sẽ chạy lại lần lượt
        sec.classList.remove('hp-in-view');
      }
    });
  };

  if ('IntersectionObserver' in window) {
    window._hpFeaturedObserver = new IntersectionObserver(handleIntersect, {
      threshold: 0.15
    });
    window._hpFeaturedObserver.observe(sec);
  } else {
    const onScroll = () => {
      const rect = sec.getBoundingClientRect();
      const inView = rect.top < window.innerHeight * 0.85 && rect.bottom > 60;
      if (inView) {
        sec.classList.add('hp-in-view');
      } else {
        sec.classList.remove('hp-in-view');
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
}

function hpInitFooterSocialAnimation() {
  const socWrappers = document.querySelectorAll('.hp-footer-socials');
  if (!socWrappers.length) return;

  socWrappers.forEach(wrap => {
    wrap.classList.add('hp-social-ready');
  });

  if (window._hpFooterSocialObserver) {
    try { window._hpFooterSocialObserver.disconnect(); } catch (_) {}
  }

  const handleIntersect = (entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('hp-in-view');
      } else {
        // Reset khi cuộn ra khỏi vùng nhìn thấy để khi cuộn lại sẽ chạy từ bên trái vào
        entry.target.classList.remove('hp-in-view');
      }
    });
  };

  if ('IntersectionObserver' in window) {
    window._hpFooterSocialObserver = new IntersectionObserver(handleIntersect, {
      threshold: 0.1,
      rootMargin: '0px 0px 50px 0px'
    });
    socWrappers.forEach(wrap => window._hpFooterSocialObserver.observe(wrap));
  } else {
    const onScroll = () => {
      socWrappers.forEach(wrap => {
        const rect = wrap.getBoundingClientRect();
        const inView = rect.top < window.innerHeight && rect.bottom > 0;
        if (inView) {
          wrap.classList.add('hp-in-view');
        } else {
          wrap.classList.remove('hp-in-view');
        }
      });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
}

function homeView(isStaffPreview = false){
  const lg = logo();
  const restName = (S.cfg.name && S.cfg.name !== 'Nhà hàng Demo') ? S.cfg.name : 'Hương Vị Việt';
  const slogan = (S.cfg.slogan && S.cfg.slogan !== 'Hương Vị Ẩm Thực Tinh Hoa') ? S.cfg.slogan : 'Tinh Hoa Ẩm Thực Việt';
  const phone = S.cfg.phone || '0123 456 789';
  const addr = S.cfg.addr || 'Số 123 Nguyễn Văn Cừ, Long Biên, Hà Nội';
  const email = S.cfg.email || 'info@huongviviet.vn';
  const openTime = S.cfg.open || '8:00';
  const closeTime = S.cfg.close || '22:00';
  const desc = S.cfg.desc || S.cfg.heroDesc || S.cfg.storyDesc || 'Chúng tôi mang đến những món ăn truyền thống Việt Nam được chế biến từ nguyên liệu tươi ngon, cùng không gian tinh tế và dịch vụ chuyên nghiệp, nhằm mang lại trải nghiệm ẩm thực tuyệt vời nhất cho bạn.';
  const todayYmd = ymd(Date.now());
  const bannerSlides = getHpBanners();
  
  const restNameDisplay = (hpLang === 'en') ? (S.cfg.name && S.cfg.name !== 'Nhà hàng Demo' && S.cfg.name !== 'Hương Vị Việt' ? S.cfg.name : hpT('restName', 'Huong Vi Viet')) : restName;
  const sloganDisplay = (hpLang === 'en') ? (S.cfg.slogan && S.cfg.slogan !== 'Tinh Hoa Ẩm Thực Việt' && S.cfg.slogan !== 'Hương Vị Ẩm Thực Tinh Hoa' ? S.cfg.slogan : hpT('slogan', 'Vietnamese Culinary Essence')) : slogan;
  const descDisplay = (hpLang === 'en') ? hpT('aboutDesc', 'We bring authentic traditional Vietnamese cuisine crafted from the freshest ingredients, paired with an elegant ambiance and dedicated service to deliver the ultimate culinary experience for you.') : desc;

  const hpLogoHtml = S.cfg.logo ? `<img src="${esc(S.cfg.logo)}" alt="${esc(restNameDisplay)}" class="hp-brand-logo-img">` : lotusSvg;
  const hpFooterLogoHtml = S.cfg.logo ? `<img src="${esc(S.cfg.logo)}" alt="${esc(restNameDisplay)}" class="hp-footer-logo-img">` : lotusSvg;
  const hpFb = S.cfg.socialFb || '#';
  const hpZalo = S.cfg.socialZalo || '#';
  const hpYt = S.cfg.socialYoutube || '#';
  const hpTt = S.cfg.socialTiktok || '#';
  const hpMenuHeroBg = S.cfg.hpMenuHeroBg || 'https://images.unsplash.com/photo-1555396273-367ea4eb4db5?w=1600&auto=format&fit=crop&q=80';

  // Dynamic sections
  const hpFeaturesList = getHpFeatures();
  const hpServicesList = getHpServices();
  const hpDishesList = getHpDishes();

  const hpAboutBadge = hpLang === 'en' ? hpT('aboutBadge', 'ABOUT US') : (S.cfg.hpAboutBadge || 'VỀ CHÚNG TÔI');
  const hpAboutTitle = (hpLang === 'en' ? hpT('aboutTitle', 'Huong Vi Viet – Where Vietnamese\nCulinary Essence Gathers') : (S.cfg.hpAboutTitle || (restName + ' – Nơi hội tụ\ntinh hoa ẩm thực Việt'))).replace(/\n/g, '<br>');
  const hpAboutImg = S.cfg.hpAboutImg || 'https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=1000&auto=format&fit=crop&q=80';
  const hpAboutHeroBg = S.cfg.hpAboutHeroBg || 'https://images.unsplash.com/photo-1550966871-3ed3cdb5ed0c?w=1600&auto=format&fit=crop&q=80';
  const hpAboutBtnText = hpLang === 'en' ? hpT('learnMore', 'Learn More') : (S.cfg.hpAboutBtnText || 'Tìm hiểu thêm');

  const hpServicesSub = hpLang === 'en' ? hpT('servicesBadge', '— OUR SERVICES —') : (S.cfg.hpServicesSub || '— DỊCH VỤ CỦA CHÚNG TÔI —');
  const hpServicesTitle = hpLang === 'en' ? hpT('servicesTitle', 'A Complete Culinary Experience') : (S.cfg.hpServicesTitle || 'Trải nghiệm ẩm thực trọn vẹn');

  const hpDishesBadge = hpLang === 'en' ? hpT('featuredBadge', 'FEATURED MENU') : (S.cfg.hpDishesBadge || 'THỰC ĐƠN NỔI BẬT');
  const hpDishesTitle = hpLang === 'en' ? hpT('featuredTitle', 'Our Signature Dishes') : (S.cfg.hpDishesTitle || 'Những món ăn được yêu thích');
  const hpDishesBtnText = hpLang === 'en' ? hpT('viewFullMenu', 'View Full Menu') : (S.cfg.hpDishesBtnText || 'Xem tất cả menu');

  const hpBookingBadge = hpLang === 'en' ? hpT('bookingBadge', 'RESERVATION') : (S.cfg.hpBookingBadge || 'ĐẶT BÀN NGAY');
  const hpBookingTitle = (hpLang === 'en' ? hpT('bookingTitle', 'Easy Reservation,\nMemorable Dining') : (S.cfg.hpBookingTitle || 'Đặt bàn dễ dàng,\nthưởng thức trọn vẹn')).replace(/\n/g, '<br>');
  const hpBookingDesc = hpLang === 'en' ? hpT('bookingDesc', 'Select your preferred time and party size, and let us prepare an unforgettable dining experience for you.') : (S.cfg.hpBookingDesc || 'Chọn thời gian, số lượng khách và để chúng tôi chuẩn bị một trải nghiệm tuyệt vời nhất cho bạn.');
  const hpBookingImg = S.cfg.hpBookingImg || 'https://images.unsplash.com/photo-1578474846511-04ba529f0b88?w=800&auto=format&fit=crop&q=80';
  const hpBookingBtnText = hpLang === 'en' ? hpT('bookTableBtn', 'Book a Table') : (S.cfg.hpBookingBtnText || 'Đặt bàn');

  const hpBio = hpLang === 'en' ? hpT('footerBio', 'Delivering exquisite Vietnamese flavors and memorable dining experiences.') : (S.cfg.hpFooterBio || 'Mang đến những món ăn ngon và trải nghiệm tuyệt vời nhất cho bạn.');
  const hpCopy = S.cfg.hpCopyright || ('© 2025 ' + restName + '. All rights reserved.');

  const previewBanner = isStaffPreview ? `
    <div class="hp-preview-banner">
      <div class="hp-pb-info"><i class="fa-solid fa-eye"></i> <span><b>${hpLang === 'en' ? 'Staff Preview:' : 'Chế độ xem trước:'}</b> ${hpLang === 'en' ? 'Customer restaurant homepage view.' : 'Trang chủ giới thiệu nhà hàng dành cho thực khách.'}</span></div>
      <div class="hp-pb-acts">
        <button type="button" class="p" onclick="openHpEditor()"><i class="fa-solid fa-pen-to-square"></i> <span class="hp-pb-txt-full">${hpLang === 'en' ? 'Edit Homepage' : 'Chỉnh sửa trang chủ'}</span><span class="hp-pb-txt-short">${hpLang === 'en' ? 'Edit' : 'Sửa'}</span></button>
        <button type="button" onclick="page='set';render()" style="background:#fff;color:#1e293b;border:1px solid #cbd5e1"><i class="fa-solid fa-gear"></i> ${hpLang === 'en' ? 'Settings' : 'Cài đặt'}</button>
        <button type="button" onclick="page='pos';render()"><i class="fa-solid fa-arrow-left"></i> <span class="hp-pb-txt-full">${hpLang === 'en' ? 'Back to POS' : 'Quay lại POS'}</span><span class="hp-pb-txt-short">POS</span></button>
      </div>
    </div>` : '';

  const loginModalHtml = (!isStaffPreview) ? `
    <div id="hp-login-modal" class="login-modal-overlay ${loginModalOpen ? 'on' : ''}" onclick="if(event.target===this)closeLoginModal()">
      <div class="login-modal-box">
        <button type="button" class="login-modal-close" onclick="closeLoginModal()" title="${hpT('close', 'Đóng')}" aria-label="${hpT('close', 'Đóng')}"><i class="fa-solid fa-xmark"></i></button>
        ${loginView()}
      </div>
    </div>` : '';

  const editorModalHtml = '';

  const featSvgs = [
    `<i class="fa-solid fa-utensils hp-feat-svg"></i>`,
    `<i class="fa-solid fa-leaf hp-feat-svg"></i>`,
    `<i class="fa-solid fa-house-chimney hp-feat-svg"></i>`,
    `<i class="fa-solid fa-heart hp-feat-svg"></i>`
  ];

  const catStats = hpGetCategoryStats();
  const totalDishes = (S && S.menu ? S.menu : []).filter(m => m.st !== 'hide').length;

  return `<div class="hp-wrapper">
    ${previewBanner}

    <!-- Header / Navbar -->
    <header class="hp-header">
      <div class="hp-nav-container">
        <a href="#home" class="hp-brand" onclick="hpNavTo('home', event)">
          ${hpLogoHtml}
          <div class="hp-brand-text">
            <span class="hp-brand-title">${esc(restNameDisplay)}</span>
            <span class="hp-brand-sub">${esc(sloganDisplay)}</span>
          </div>
        </a>

        <nav class="hp-nav-links ${hpNavOpen ? 'open' : ''}">
          <!-- Header layout bên trong menu khi mở trên mobile / iPad -->
          <div class="hp-nav-drawer-header">
            <a href="#home" class="hp-brand" onclick="hpNavTo('home', event)">
              ${hpLogoHtml}
              <div class="hp-brand-text">
                <span class="hp-brand-title">${esc(restNameDisplay)}</span>
                <span class="hp-brand-sub">${esc(sloganDisplay)}</span>
              </div>
            </a>
            <div style="display:flex;align-items:center;gap:8px">
              <button type="button" class="hp-nav-drawer-close" onclick="hpCloseMobileNav()" aria-label="${hpT('close', 'Đóng menu')}" title="${hpT('close', 'Đóng menu')}">
                <i class="fa-solid fa-xmark"></i>
              </button>
            </div>
          </div>

          <div class="hp-nav-drawer-content">
            <a href="#home" data-nav="home" class="${hpActiveNav==='home'?'active':''}" onclick="hpNavTo('home', event)">${hpT('home', 'Trang chủ')}</a>
            <a href="#about" data-nav="about" class="${hpActiveNav==='about'?'active':''}" onclick="hpNavTo('about', event)">${hpT('about', 'Giới thiệu')}</a>
            
            <div class="hp-nav-item-dropdown ${hpSubMenuOpen ? 'open' : ''}" id="hp-menu-nav-wrap">
              <div class="hp-nav-dropdown-trigger">
                <a href="#menu" data-nav="menu" class="hp-nav-link-menu ${hpActiveNav==='menu'?'active':''}" onclick="hpNavTo('menu', event)">
                  <span>${hpT('menu', 'Thực đơn')}</span>
                  <i class="fa-solid fa-chevron-down hp-nav-caret"></i>
                </a>
                <button type="button" class="hp-mobile-submenu-toggle" onclick="hpToggleSubMenu(event)" aria-label="${hpSubMenuOpen ? 'Thu gọn danh mục thực đơn' : 'Mở danh mục thực đơn'}" title="${hpSubMenuOpen ? 'Thu gọn danh mục' : 'Mở danh mục'}" aria-expanded="${hpSubMenuOpen ? 'true' : 'false'}">
                  <i class="fa-solid fa-chevron-down"></i>
                </button>
              </div>
              <div class="hp-nav-submenu ${hpSubMenuOpen ? 'show' : ''}">
                <a href="#full-menu" class="hp-submenu-item" data-menu-cat="all" onclick="hpNavToMenuCat('all', event)">
                  <span>${hpT('allMenu', 'Tất cả thực đơn')}</span>
