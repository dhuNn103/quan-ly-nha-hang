function getHpDishes(forEditor = false) {
  const saved = (Array.isArray(S.cfg.hpDishes) && S.cfg.hpDishes.length === 4) ? S.cfg.hpDishes : null;
  if (!forEditor && hpLang === 'en') {
    return HP_DEFAULT_DISHES_EN.map((enItem, i) => {
      if (!saved) return { ...enItem };
      const viDef = HP_DEFAULT_DISHES_VI[i];
      const cur = saved[i] || {};
      const n = (cur.name || '').trim();
      const rev = (cur.reviews || enItem.reviews).replace(/đánh giá/gi, 'reviews');
      return {
        ...enItem,
        price: cur.price || enItem.price,
        rating: cur.rating || enItem.rating,
        img: cur.img || enItem.img,
        name: (!n || n === viDef.name || n === enItem.name) ? enItem.name : hpTranslateDish(n),
        reviews: rev
      };
    });
  }
  if (!saved) return HP_DEFAULT_DISHES_VI.map(d => ({ ...d }));
  return saved.map((cur, i) => {
    const viDef = HP_DEFAULT_DISHES_VI[i];
    const enDef = HP_DEFAULT_DISHES_EN[i];
    const n = (cur && cur.name ? cur.name : '').trim();
    const rev = ((cur && cur.reviews) ? cur.reviews : viDef.reviews).replace(/\breviews?\b/gi, 'đánh giá');
    return {
      ...viDef,
      ...cur,
      name: (!n || n === enDef.name) ? viDef.name : (HP_DISH_NAMES_EN_TO_VI[n.toLowerCase()] || n),
      reviews: rev
    };
  });
}

function getHpEditorModalHtml() {
  return `
    <div id="hp-editor-modal" class="hp-modal-overlay" onclick="if(event.target===this)closeHpEditor()" style="z-index:999999!important">
      <div class="hp-editor-box">
        <div class="hp-editor-head">
          <div>
            <h3><i class="fa-solid fa-pen-to-square" style="color:#b8863b"></i> Chỉnh Sửa Thông Tin Trang Chủ</h3>
            <p>Cập nhật nội dung, tiêu đề, hình ảnh và liên kết hiển thị trên trang chủ</p>
          </div>
          <button type="button" class="ib x" onclick="closeHpEditor()" title="Đóng" aria-label="Đóng"><i class="fa-solid fa-xmark"></i></button>
        </div>

        <div class="hp-editor-tabs-bar">
          <button type="button" class="hp-ed-tab-btn ${hpEditorTab==='general'?'active':''}" data-tab="general" onclick="switchHpEditorTab('general')"><i class="fa-solid fa-store"></i> Thông tin chung</button>
          <button type="button" class="hp-ed-tab-btn ${hpEditorTab==='features'?'active':''}" data-tab="features" onclick="switchHpEditorTab('features')"><i class="fa-solid fa-wand-magic-sparkles"></i> 4 Tiêu chí</button>
          <button type="button" class="hp-ed-tab-btn ${hpEditorTab==='about'?'active':''}" data-tab="about" onclick="switchHpEditorTab('about')"><i class="fa-solid fa-book-open"></i> Về chúng tôi</button>
          <button type="button" class="hp-ed-tab-btn ${hpEditorTab==='services'?'active':''}" data-tab="services" onclick="switchHpEditorTab('services')"><i class="fa-solid fa-concierge-bell"></i> 4 Dịch vụ</button>
          <button type="button" class="hp-ed-tab-btn ${hpEditorTab==='dishes'?'active':''}" data-tab="dishes" onclick="switchHpEditorTab('dishes')"><i class="fa-solid fa-utensils"></i> 4 Món nổi bật</button>
          <button type="button" class="hp-ed-tab-btn ${hpEditorTab==='booking'?'active':''}" data-tab="booking" onclick="switchHpEditorTab('booking')"><i class="fa-solid fa-calendar-check"></i> Đặt bàn</button>
          <button type="button" class="hp-ed-tab-btn ${hpEditorTab==='social'?'active':''}" data-tab="social" onclick="switchHpEditorTab('social')"><i class="fa-solid fa-share-nodes"></i> Mạng xã hội & Chân trang</button>
        </div>

        <div class="hp-editor-body" id="hp-ed-tab-content">
          ${renderHpEditorTabPanes()}
        </div>

        <div class="hp-editor-foot">
          <button type="button" onclick="resetHpCfg()" style="color:#b91c1c;background:#fef2f2;border:1px solid #fecaca;border-radius:8px;padding:8px 14px;cursor:pointer;font-weight:600;font-size:13px"><i class="fa-solid fa-rotate-left"></i> Khôi phục mặc định</button>
          <div style="display:flex;gap:8px">
            <button type="button" onclick="closeHpEditor()" style="background:#f5efe6;border:1px solid #dcd3c7;border-radius:8px;padding:8px 16px;cursor:pointer;font-size:13.5px">Hủy bỏ</button>
            <button type="button" class="p" onclick="saveHpEditor()" style="background:#b8863b;border-color:#b8863b;border-radius:8px;padding:8px 20px;font-weight:700;font-size:14px"><i class="fa-solid fa-floppy-disk"></i> Lưu thay đổi</button>
          </div>
        </div>
      </div>
    </div>`;
}

function renderHpEditorTabPanes() {
  const tabs = ['general', 'features', 'about', 'services', 'dishes', 'booking', 'social'];
  return tabs.map(t => `
    <div class="hp-ed-tab-pane" id="hp-ed-tab-${t}" style="display:${hpEditorTab === t ? 'block' : 'none'}">
      ${renderHpEditorTabContent(t)}
    </div>
  `).join('');
}

function ensureHpEditorModal(refresh = false) {
  let modal = document.getElementById('hp-editor-modal');
  if (!modal) {
    document.body.insertAdjacentHTML('beforeend', getHpEditorModalHtml());
    modal = document.getElementById('hp-editor-modal');
  } else if (refresh) {
    const cont = document.getElementById('hp-ed-tab-content');
    if (cont) cont.innerHTML = renderHpEditorTabPanes();
    document.querySelectorAll('.hp-ed-tab-btn').forEach(b => {
      b.classList.toggle('active', b.dataset.tab === hpEditorTab);
    });
  }
  return modal;
}

function openHpEditor(tab = 'general') {
  if (!me || !can('admin', 'manager')) {
    fillLogin('admin', 'Admin@123');
    openLoginModal();
    toast('Vui lòng đăng nhập quyền Quản trị / Admin để chỉnh sửa nội dung trang chủ (Tài khoản mẫu: admin / Admin@123)', 'warn', 6000);
    return;
  }
  hpEditorTab = tab;
  hpEditorOpen = true;
  const modal = ensureHpEditorModal(true);
  if (modal) {
    modal.classList.add('on');
    switchHpEditorTab(tab);
  }
}

function closeHpEditor() {
  hpEditorOpen = false;
  const modal = document.getElementById('hp-editor-modal');
  if (modal) {
    modal.classList.remove('on');
  }
}

function viewHomePage(e) {
  closeHpEditor();
  if (e && (e.ctrlKey || e.metaKey || e.button === 1)) {
    return true;
  }
  if (e && e.preventDefault) e.preventDefault();
  page = 'home';
  render();
  window.scrollTo({ top: 0, behavior: 'smooth' });
  if (typeof hpInitStatsCounters === 'function') setTimeout(hpInitStatsCounters, 60);
  if (typeof hpInitQuoteTypewriter === 'function') setTimeout(hpInitQuoteTypewriter, 70);
  return false;
}

function resetHpEditorLogo() {
  S.cfg.logo = '';
  save();
  render();
  const cont = document.getElementById('hp-ed-tab-content');
  if (cont && typeof renderHpEditorTabPanes === 'function') cont.innerHTML = renderHpEditorTabPanes();
  toast('Đã khôi phục biểu tượng hoa sen mặc định.', 'ok');
}

function editRestaurantInfoFromModal() {
  closeHpEditor();
  page = 'set';
  render();
  setTimeout(() => {
    const box = document.getElementById('sec-restaurant-info');
    if (box) {
      box.scrollIntoView({ behavior: 'smooth', block: 'start' });
      const nameInp = document.getElementById('cn');
      if (nameInp) {
        nameInp.focus();
        nameInp.style.transition = 'all .3s';
        nameInp.style.boxShadow = '0 0 0 4px rgba(2, 132, 199, 0.4)';
        nameInp.style.borderColor = '#0284c7';
        setTimeout(() => {
          nameInp.style.boxShadow = '';
          nameInp.style.borderColor = '';
        }, 2000);
      }
    }
  }, 100);
}

function switchHpEditorTab(tab) {
  hpEditorTab = tab;
  const panes = document.querySelectorAll('.hp-ed-tab-pane');
  if (panes && panes.length) {
    panes.forEach(p => {
      p.style.display = p.id === 'hp-ed-tab-' + tab ? 'block' : 'none';
    });
  } else {
    const cont = document.getElementById('hp-ed-tab-content');
    if (cont) cont.innerHTML = renderHpEditorTabPanes();
  }
  document.querySelectorAll('.hp-ed-tab-btn').forEach(b => {
    b.classList.toggle('active', b.dataset.tab === tab);
  });
}

function hpPickLocalImg(fileInput, targetInputId, previewImgId) {
  if (!fileInput.files || !fileInput.files[0]) return;
  rz(fileInput.files[0], 'image/jpeg', 1000, dataUrl => {
    const inp = document.getElementById(targetInputId);
    if (inp) {
      inp.value = dataUrl;
      inp.dispatchEvent(new Event('input'));
    }
    const prv = document.getElementById(previewImgId);
    if (prv) prv.src = dataUrl;
  });
}

function hpPickMenuDish(dishId, index) {
  if (!dishId) return;
  const m = (S.menu || []).find(x => x.id === dishId);
  if (!m) return;
  const nameEl = document.getElementById('hp_ed_d_name_' + index);
  const priceEl = document.getElementById('hp_ed_d_price_' + index);
  const imgEl = document.getElementById('hp_ed_d_img_' + index);
  const prvEl = document.getElementById('hp_ed_d_prv_' + index);

  if (nameEl) nameEl.value = m.name;
  if (priceEl) priceEl.value = money(m.price);
  if (imgEl && m.img) {
    imgEl.value = m.img;
    if (prvEl) prvEl.src = m.img;
  }
}

function renderHpEditorTabContent(tab = hpEditorTab) {
  const c = S.cfg;
  const feats = getHpFeatures(true);
  const servs = getHpServices(true);
  const dishes = getHpDishes(true);

  if (tab === 'general') {
    return `
      <!-- Thẻ Thông tin nhận diện & liên hệ dùng chung (Đồng bộ tự động từ Thông tin nhà hàng) -->
      <div class="hp-ed-card" style="background:#f8fafc;border-color:#cbd5e1">
        <div class="hp-ed-card-head" style="color:#0f172a">
          <i class="fa-solid fa-arrows-rotate" style="color:#0284c7"></i> 
          <span>Thông tin cơ bản nhà hàng (Đồng bộ tự động từ "Thông tin nhà hàng")</span>
        </div>
        <p style="font-size:12.5px;color:#64748b;margin:0 0 14px;line-height:1.5">
          Tên nhà hàng, Logo, Hotline, Email, Giờ mở cửa và Địa chỉ được <b>dùng chung thống nhất</b> cho toàn bộ hệ thống (Hóa đơn, POS, Order QR và Trang chủ). Để tránh nhập trùng lặp, bạn có thể chỉnh sửa tập trung tại mục <b>Thông tin nhà hàng</b> trong Cài đặt.
        </p>
        <div style="display:grid;grid-template-columns:auto 1fr;gap:16px;align-items:center;background:#fff;border:1px solid #e2e8f0;border-radius:10px;padding:14px;margin-bottom:12px">
          <div style="width:64px;height:64px;border-radius:10px;border:1px dashed #cbd5e1;background:#f8fafc;display:flex;align-items:center;justify-content:center;overflow:hidden;flex-shrink:0">
            ${c.logo ? `<img src="${c.logo}" style="width:100%;height:100%;object-fit:contain">` : `<span style="width:34px;height:34px;color:#b8863b;display:flex">${lotusSvg}</span>`}
          </div>
          <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(200px, 1fr));gap:8px 16px;font-size:13px">
            <div><span style="color:#64748b">Tên nhà hàng:</span> <b style="color:#0f172a">${esc(c.name || 'Hương Vị Việt')}</b></div>
            <div><span style="color:#64748b">Hotline:</span> <b style="color:#0f172a">${esc(c.phone || 'Chưa cập nhật')}</b></div>
            <div><span style="color:#64748b">Email:</span> <b style="color:#0f172a">${esc(c.email || 'Chưa cập nhật')}</b></div>
            <div><span style="color:#64748b">Giờ hoạt động:</span> <b style="color:#0f172a">${esc(c.open || '08:00')} – ${esc(c.close || '22:00')}</b></div>
            <div style="grid-column: 1 / -1"><span style="color:#64748b">Địa chỉ:</span> <b style="color:#0f172a">${esc(c.addr || 'Chưa cập nhật')}</b></div>
          </div>
        </div>
        <div style="display:flex;justify-content:flex-end">
          <button type="button" onclick="editRestaurantInfoFromModal()" style="display:inline-flex;align-items:center;gap:6px;padding:7px 14px;border:1px solid #cbd5e1;background:#fff;color:#1e293b;border-radius:8px;font-size:12.5px;font-weight:600;cursor:pointer;transition:all .15s">
            <i class="fa-solid fa-pen-to-square"></i> Chỉnh sửa tại "Thông tin nhà hàng"
          </button>
        </div>
      </div>

      <!-- Thẻ Khẩu hiệu thương hiệu -->
      <div class="hp-ed-card">
        <div class="hp-ed-card-head">
          <i class="fa-solid fa-bullhorn" style="color:#b8863b"></i> 
          <span>Khẩu hiệu thương hiệu (Slogan)</span>
        </div>
        <p style="font-size:12.5px;color:#766a5c;margin:0 0 14px">
          Câu khẩu hiệu nổi bật hiển thị dưới tên nhà hàng ở Header, Banner và chân trang website.
        </p>
        <div class="hp-ed-field">
          <label>Slogan / Khẩu hiệu thương hiệu (Hiển thị nổi bật đầu trang)</label>
          <input id="hp_ed_slogan" value="${esc(c.slogan || 'Tinh Hoa Ẩm Thực Việt')}" placeholder="VD: Tinh Hoa Ẩm Thực Việt">
        </div>
      </div>
    `;
  }

  if (tab === 'features') {
    return `
      <div class="hp-ed-card">
        <div class="hp-ed-card-head"><i class="fa-solid fa-wand-magic-sparkles" style="color:#b8863b"></i> 4 Tiêu chí nổi bật (Thanh trắng đầu trang)</div>
        <p style="font-size:12.5px;color:#766a5c;margin:0 0 16px">Tùy biến 4 tiêu chí chất lượng cam kết với khách hàng dưới banner chính.</p>
        <div class="hp-ed-grid-2">
          ${feats.map((f, i) => `
            <div style="background:#fff;border:1px solid #ebd9c2;border-radius:10px;padding:12px">
              <b style="font-size:13px;color:#b8863b;display:block;margin-bottom:8px">Tiêu chí ${i + 1}</b>
              <div class="hp-ed-field" style="margin-bottom:8px">
                <label>Tiêu đề</label>
                <input id="hp_ed_feat_t_${i}" value="${esc(f.title)}" placeholder="Tiêu đề tiêu chí">
              </div>
              <div class="hp-ed-field">
                <label>Mô tả phụ</label>
                <input id="hp_ed_feat_d_${i}" value="${esc(f.desc)}" placeholder="Mô tả ngắn">
              </div>
            </div>
          `).join('')}
        </div>
      </div>
    `;
  }

  if (tab === 'about') {
    return `
      <div class="hp-ed-card">
        <div class="hp-ed-card-head"><i class="fa-solid fa-book-open" style="color:#b8863b"></i> Khu vực "Về chúng tôi" (About Us)</div>
        <div class="hp-ed-grid-2">
          <div class="hp-ed-field">
            <label>Huy hiệu (Tag)</label>
            <input id="hp_ed_about_badge" value="${esc(c.hpAboutBadge || 'VỀ CHÚNG TÔI')}">
          </div>
          <div class="hp-ed-field">
            <label>Chữ trên nút bấm</label>
            <input id="hp_ed_about_btn" value="${esc(c.hpAboutBtnText || 'Tìm hiểu thêm')}">
          </div>
        </div>
        <div class="hp-ed-field" style="margin-bottom:12px">
          <label>Tiêu đề lớn</label>
          <input id="hp_ed_about_title" value="${esc(c.hpAboutTitle || (c.name || 'Hương Vị Việt') + ' – Nơi hội tụ tinh hoa ẩm thực Việt')}">
        </div>
        <div class="hp-ed-field" style="margin-bottom:12px">
          <label>Đoạn văn giới thiệu nhà hàng</label>
          <textarea id="hp_ed_about_desc" rows="4">${esc(c.desc || c.heroDesc || c.storyDesc || 'Chúng tôi mang đến những món ăn truyền thống Việt Nam được chế biến từ nguyên liệu tươi ngon, cùng không gian tinh tế và dịch vụ chuyên nghiệp, nhằm mang lại trải nghiệm ẩm thực tuyệt vời nhất cho bạn.')}</textarea>
        </div>
        <div class="hp-ed-field">
          <label>Hình ảnh Về chúng tôi (Story)</label>
          <div class="hp-img-upload-row">
            <img id="hp_ed_about_prv" src="${esc(c.hpAboutImg || 'https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=1000&auto=format&fit=crop&q=80')}" class="hp-img-thumb-preview" alt="Xem trước">
            <input id="hp_ed_about_img" value="${esc(c.hpAboutImg || 'https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=1000&auto=format&fit=crop&q=80')}" oninput="$('#hp_ed_about_prv').src=this.value" placeholder="Nhập URL ảnh hoặc chọn từ máy">
            <button type="button" class="p" onclick="$('#hp_ed_about_f').click()" style="white-space:nowrap"><i class="fa-solid fa-upload"></i> Chọn ảnh</button>
            <input id="hp_ed_about_f" type="file" accept="image/*" style="display:none" onchange="hpPickLocalImg(this, 'hp_ed_about_img', 'hp_ed_about_prv')">
          </div>
        </div>
        <div class="hp-ed-field" style="margin-top:14px">
          <label>Ảnh nền banner Về chúng tôi (Hero Background)</label>
          <div class="hp-img-upload-row">
            <img id="hp_ed_about_hero_bg_prv" src="${esc(c.hpAboutHeroBg || 'https://images.unsplash.com/photo-1550966871-3ed3cdb5ed0c?w=1600&auto=format&fit=crop&q=80')}" class="hp-img-thumb-preview" alt="Xem trước">
            <input id="hp_ed_about_hero_bg" value="${esc(c.hpAboutHeroBg || 'https://images.unsplash.com/photo-1550966871-3ed3cdb5ed0c?w=1600&auto=format&fit=crop&q=80')}" oninput="$('#hp_ed_about_hero_bg_prv').src=this.value" placeholder="Nhập URL ảnh nền hoặc chọn từ máy">
            <button type="button" class="p" onclick="$('#hp_ed_about_hero_bg_f').click()" style="white-space:nowrap"><i class="fa-solid fa-upload"></i> Chọn ảnh</button>
            <input id="hp_ed_about_hero_bg_f" type="file" accept="image/*" style="display:none" onchange="hpPickLocalImg(this, 'hp_ed_about_hero_bg', 'hp_ed_about_hero_bg_prv')">
          </div>
        </div>
      </div>
    `;
  }

  if (tab === 'services') {
    return `
      <div class="hp-ed-card">
        <div class="hp-ed-card-head"><i class="fa-solid fa-concierge-bell" style="color:#b8863b"></i> 4 Thẻ Dịch vụ của chúng tôi</div>
        <div class="hp-ed-grid-2" style="margin-bottom:14px">
          <div class="hp-ed-field">
            <label>Tiêu đề phụ</label>
            <input id="hp_ed_serv_sub" value="${esc(c.hpServicesSub || '— DỊCH VỤ CỦA CHÚNG TÔI —')}">
          </div>
          <div class="hp-ed-field">
            <label>Tiêu đề chính</label>
            <input id="hp_ed_serv_title" value="${esc(c.hpServicesTitle || 'Trải nghiệm ẩm thực trọn vẹn')}">
