];
const HP_DEFAULT_FEATURES_EN = [
  { title: 'Master Chefs', desc: 'Essence of culinary craft' },
  { title: 'Fresh & Clean Ingredients', desc: 'Safe, premium quality daily' },
  { title: 'Cozy & Elegant Ambiance', desc: 'Warm and modern dining hall' },
