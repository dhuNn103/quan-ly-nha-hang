              </div>
            </div>

            <a href="#space" data-nav="space" class="${hpActiveNav==='space'?'active':''}" onclick="hpNavTo('space', event)">${hpT('space', 'Không gian')}</a>
            <a href="#contact" data-nav="contact" class="${hpActiveNav==='contact'?'active':''}" onclick="hpNavTo('contact', event)">${hpT('contact', 'Liên hệ')}</a>

            <div class="hp-nav-mobile-acts">
              <a href="#booking" class="hp-btn-nav-book" onclick="hpNavTo('booking', event)"><i class="fa-solid fa-calendar-check"></i> ${hpT('bookTableBtn', 'Đặt bàn')}</a>
              <div style="display:flex;align-items:center;gap:10px;margin-top:12px;padding-top:12px;border-top:1px solid #f0eae1">
                ${hpRenderLangBtn()}
                <span onclick="hpToggleLang()" style="font-size:13.5px;color:#4a4034;font-weight:500;cursor:pointer">${hpLang === 'en' ? 'Switch language' : 'Chuyển ngôn ngữ'}</span>
              </div>
            </div>

            <div class="hp-nav-mobile-info">
              <div class="hp-nav-mobile-info-item"><i class="fa-solid fa-phone"></i> <span>${hpT('hotline', 'Hotline:')} <b>${esc(phone)}</b></span></div>
              <div class="hp-nav-mobile-info-item"><i class="fa-solid fa-clock"></i> <span>${hpT('openingHours', 'Mở cửa: ' + esc(openTime) + ' - ' + esc(closeTime) + ' hàng ngày')}</span></div>
            </div>
          </div>
        </nav>

        <div class="hp-nav-actions">
          <button type="button" class="hp-search-btn" onclick="hpOpenSearchModal()" title="${hpT('searchTitle', 'Tìm kiếm món ăn')}" aria-label="${hpT('searchTitle', 'Tìm kiếm món ăn')}"><i class="fa-solid fa-magnifying-glass"></i></button>
          ${hpRenderLangBtn()}
          <a href="#booking" class="hp-btn-nav-book" onclick="hpNavTo('booking', event)"><i class="fa-solid fa-calendar-check"></i> ${hpT('bookTableBtn', 'Đặt bàn')}</a>
          <button type="button" class="hp-menu-toggle" onclick="hpNavOpen=!hpNavOpen;render()" aria-label="Menu" title="Menu"><i class="fa-solid fa-bars"></i></button>
        </div>
      </div>
    </header>

    <!-- Banner Section -->
    <section id="home" class="hp-banner-sec">
      <div class="hp-slider-wrap" id="hp-slider-wrap">
        <div class="hp-slider-track" id="hp-slider-track" style="${bannerSlides.length > 1 ? `transform:translateX(-${hpVisualIdx * 100}%);` : ''}">
          ${bannerSlides.length > 1 ? (
            hpSlideItemHtml(bannerSlides[bannerSlides.length - 1], bannerSlides.length - 1, true) +
            bannerSlides.map((b, i) => hpSlideItemHtml(b, i, false)).join('') +
            hpSlideItemHtml(bannerSlides[0], 0, true)
          ) : bannerSlides.map((b, i) => hpSlideItemHtml(b, i, false)).join('')}
        </div>

        ${bannerSlides.length > 1 ? `
          <div class="hp-slider-dots-bottomleft">
            ${bannerSlides.map((_, i) => `<button type="button" class="hp-slider-dot ${i === hpSliderIdx ? 'active' : ''}" onclick="event.stopPropagation();hpSliderGoTo(${i})" title="Slide ${i + 1}" aria-label="Chuyển đến Slide ${i + 1}"></button>`).join('')}
          </div>
          <div class="hp-slider-arrows-bottomright">
            <button type="button" class="hp-slider-arrow-btn" onclick="event.stopPropagation();hpSliderPrev()" title="${hpT('pagePrev', 'Slide trước')}" aria-label="${hpT('pagePrev', 'Slide trước')}"><i class="fa-solid fa-chevron-left"></i></button>
            <button type="button" class="hp-slider-arrow-btn" onclick="event.stopPropagation();hpSliderNext()" title="${hpT('pageNext', 'Slide kế tiếp')}" aria-label="${hpT('pageNext', 'Slide kế tiếp')}"><i class="fa-solid fa-chevron-right"></i></button>
          </div>
        ` : ''}
      </div>
    </section>

    <!-- Features Section -->
    <div class="hp-features-strip">
      ${hpFeaturesList.map((f, i) => `
        <div class="hp-feature-item">
          <div class="hp-feature-icon">
            ${featSvgs[i % featSvgs.length]}
          </div>
          <div class="hp-feature-text">
            <div class="hp-feature-title">${esc(f.title)}</div>
            <div class="hp-feature-desc">${esc(f.desc)}</div>
          </div>
        </div>
      `).join('')}
    </div>

    <!-- About Section -->
    <section id="about" class="hp-about-sec">
      <div class="hp-about-container">
        <div class="hp-about-img-wrap">
          <img src="${esc(hpAboutImg)}" alt="Không gian nhà hàng" class="hp-about-img">
        </div>
        <div class="hp-about-content">
          <div class="hp-badge-gold"><i class="fa-solid fa-tag"></i> ${esc(hpAboutBadge)}</div>
          <h2 class="hp-about-heading">${hpAboutTitle}</h2>
          <p class="hp-about-text">${descDisplay}</p>
          <a href="#about-us" onclick="hpNavToAboutUs(event);return false;" class="hp-btn-gold-pill">${esc(hpAboutBtnText)} <i class="fa-solid fa-arrow-right"></i></a>
          <div class="hp-about-watermark">${lotusWatermarkSvg}</div>
        </div>
      </div>
    </section>

    <!-- Services Section -->
    <section id="space" class="hp-services-sec">
      <div class="hp-sec-center-head">
        <span class="hp-sec-subtitle-gold">${esc(hpServicesSub)}</span>
        <h2 class="hp-sec-title-serif">${esc(hpServicesTitle)}</h2>
      </div>

      <div class="hp-services-grid">
        ${hpServicesList.map((s, i) => `
          <div class="hp-service-card" onclick="hpNavTo('${esc((s.link || '#menu').replace(/^#/, ''))}', event)" style="cursor:pointer">
            <img src="${esc(s.img)}" alt="${esc(s.title)}" class="hp-service-img">
            <div class="hp-service-icon-circle"><i class="fa-solid ${esc(s.icon || 'fa-utensils')}"></i></div>
            <div class="hp-service-body">
              <h3 class="hp-service-title">${esc(s.title)}</h3>
              <p class="hp-service-desc">${esc(s.desc)}</p>
              <a href="${esc(s.link || '#menu')}" class="hp-service-link" onclick="hpNavTo('${esc((s.link || '#menu').replace(/^#/, ''))}', event)">${esc(s.linkText || (hpLang === 'en' ? 'Explore Menu' : 'Xem thực đơn'))} <i class="fa-solid fa-arrow-right"></i></a>
            </div>
          </div>
        `).join('')}
      </div>
    </section>

    <!-- Featured Menu Section -->
    <section id="menu" class="hp-featured-sec">
      <div class="hp-featured-head">
        <div>
          <div class="hp-badge-gold"><i class="fa-solid fa-tag"></i> ${esc(hpDishesBadge)}</div>
          <h2 class="hp-sec-title-serif">${esc(hpDishesTitle)}</h2>
        </div>
        <a href="#full-menu" onclick="hpNavToFullMenu('all', event);return false;" class="hp-btn-view-all">${esc(hpDishesBtnText)} <i class="fa-solid fa-arrow-right"></i></a>
      </div>

      <div class="hp-dishes-row">
        ${hpDishesList.map(d => `
          <div class="hp-dish-box">
            <div class="hp-dish-img-wrap">
              <img src="${esc(d.img)}" alt="${esc(hpTranslateDish(d.name))}">
            </div>
            <div class="hp-dish-info">
              <div class="hp-dish-row-top">
                <div class="hp-dish-title">${esc(hpTranslateDish(d.name))}</div>
                <div class="hp-dish-price-badge">${esc(d.price)}</div>
              </div>
              <div class="hp-dish-rating"><i class="fa-solid fa-star"></i> <b>${esc(d.rating || '4.8')}</b> <span class="hp-rev-count">(${esc(hpLang === 'en' ? (d.reviews || '1k reviews').replace(/đánh giá/gi, 'reviews') : (d.reviews || '1k đánh giá').replace(/\breviews?\b/gi, 'đánh giá'))})</span></div>
            </div>
          </div>
        `).join('')}
      </div>
    </section>

    <!-- Table Reservation Section -->
    <section id="booking" class="hp-res-card-wrap">
      <div class="hp-res-card">
        <div class="hp-res-watermark">${lotusWatermarkSvg}</div>

        <div class="hp-res-card-content">
          <div class="hp-badge-gold"><i class="fa-solid fa-bahai"></i> ${esc(hpBookingBadge)}</div>
          <h3 class="hp-res-heading">${hpBookingTitle}</h3>
          <p class="hp-res-desc">${esc(hpBookingDesc)}</p>
          <div class="hp-res-decor-line">
            <span class="hp-rd-l"></span>
            <span class="hp-rd-diamond">◆</span>
            <span class="hp-rd-l"></span>
          </div>
        </div>

        <div class="hp-res-form-wrap">
          <form class="hp-res-form" onsubmit="hpBookTable(event);return false;">
            <div class="hp-res-row-3">
              <div class="hp-res-input-wrap">
                <i class="fa-regular fa-calendar-days hp-rw-left-icon"></i>
                <input id="hp-bk-date" type="text" placeholder="${hpT('bookFormDatePlaceholder', 'Ngày đặt')}" onfocus="this.type='date';try{this.showPicker()}catch(_){}" onblur="if(!this.value)this.type='text'" onchange="hpUpdateDepositNotice()" required title="${hpT('bookFormDatePlaceholder', 'Ngày đặt')}">
                <i class="fa-solid fa-chevron-down hp-rw-right-icon"></i>
              </div>
              <div class="hp-res-input-wrap">
                <i class="fa-regular fa-clock hp-rw-left-icon"></i>
                <select id="hp-bk-time" title="${hpT('bookFormTimePlaceholder', 'Giờ đến')}" required>
                  <option value="" selected>${hpT('bookFormTimePlaceholder', 'Giờ đến')}</option>
                  <option value="11:00">11:00</option>
                  <option value="11:30">11:30</option>
                  <option value="12:00">12:00</option>
                  <option value="12:30">12:30</option>
                  <option value="18:00">18:00</option>
                  <option value="18:30">18:30</option>
                  <option value="19:00">19:00</option>
                  <option value="19:30">19:30</option>
                  <option value="20:00">20:00</option>
                </select>
                <i class="fa-solid fa-chevron-down hp-rw-right-icon"></i>
              </div>
              <div class="hp-res-input-wrap">
                <i class="fa-solid fa-users hp-rw-left-icon"></i>
                <select id="hp-bk-guests" title="${hpT('bookFormGuestsTitle', 'Số khách')}" onchange="hpUpdateDepositNotice()" required>
                  ${hpLang === 'en' ? `
                    <option value="2" selected>2 guests</option>
                    <option value="1">1 guest</option>
                    <option value="3">3 guests</option>
                    <option value="4">4 guests</option>
                    <option value="5">5 guests</option>
                    <option value="6">6 guests</option>
                    <option value="7">7 guests</option>
                    <option value="8">8 guests</option>
                    <option value="10">10 guests</option>
                    <option value="12">12 guests</option>
                    <option value="15">15 guests</option>
                    <option value="18">18 guests</option>
                    <option value="20">20 guests</option>
                    <option value="30">30 guests</option>
                    <option value="50">50+ guests</option>
                  ` : `
                    <option value="2" selected>2 người</option>
                    <option value="1">1 người</option>
                    <option value="3">3 người</option>
                    <option value="4">4 người</option>
                    <option value="5">5 người</option>
                    <option value="6">6 người</option>
                    <option value="7">7 người</option>
                    <option value="8">8 người</option>
                    <option value="10">10 người</option>
                    <option value="12">12 người</option>
                    <option value="15">15 người</option>
                    <option value="18">18 người</option>
                    <option value="20">20 người</option>
                    <option value="30">30 người</option>
                    <option value="50">50+ người</option>
                  `}
                </select>
                <i class="fa-solid fa-chevron-down hp-rw-right-icon"></i>
              </div>
            </div>

            <div class="hp-res-row-3">
              <div class="hp-res-input-wrap">
                <i class="fa-regular fa-user hp-rw-left-icon"></i>
                <input id="hp-bk-name" type="text" placeholder="${hpT('bookFormNamePlaceholder', 'Họ và tên')}" required>
              </div>
              <div class="hp-res-input-wrap">
                <i class="fa-solid fa-phone hp-rw-left-icon"></i>
                <input id="hp-bk-phone" type="tel" placeholder="${hpT('bookFormPhonePlaceholder', 'Số điện thoại')}" required>
              </div>
              <div class="hp-res-input-wrap">
                <i class="fa-solid fa-chair hp-rw-left-icon"></i>
                <select id="hp-bk-space" title="${hpT('bookFormAreaTitle', 'Khu vực / Loại đặt bàn')}" onchange="hpUpdateDepositNotice()">
                  <option value="Bàn tiêu chuẩn" selected>${hpT('bookFormAreaStandard', 'Bàn tiêu chuẩn')}</option>
                  <option value="Phòng VIP riêng">${hpT('bookFormAreaVip', 'Phòng VIP riêng')}</option>
                  <option value="Khu vực ngoài trời">${hpT('bookFormAreaOutdoor', 'Khu vực ngoài trời')}</option>
                  <option value="Đặt tiệc, sự kiện">${hpT('bookFormAreaParty', 'Đặt tiệc, sự kiện')}</option>
                </select>
                <i class="fa-solid fa-chevron-down hp-rw-right-icon"></i>
              </div>
            </div>

            <div class="hp-res-holiday-row">
              <label class="hp-res-holiday-lbl">
                <input type="checkbox" id="hp-bk-holiday" onchange="hpUpdateDepositNotice()">
                <span><i class="fa-solid fa-gift"></i> ${hpT('bookFormHolidayNote', 'Đặt bàn dịp Lễ, Tết / Sự kiện đặc biệt (Nên đặt cọc giữ chỗ)')}</span>
              </label>
            </div>

            <button type="submit" class="hp-btn-res-submit"><i class="fa-solid fa-paper-plane"></i> ${esc(hpBookingBtnText)}</button>
          </form>
        </div>

        <div class="hp-res-img-wrap">
          <img src="${esc(hpBookingImg)}" alt="Bàn tiệc sang trọng" class="hp-res-img">
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="hp-footer" id="contact">
      <div class="hp-footer-container">
        <div class="hp-footer-grid">
          <div class="hp-footer-col">
            <div class="hp-footer-brand">
              ${hpFooterLogoHtml}
              <div>
                <div class="hp-footer-brand-title">${esc(restNameDisplay)}</div>
                <div class="hp-footer-brand-sub">${esc(sloganDisplay)}</div>
              </div>
            </div>
            <p class="hp-footer-bio">${esc(hpBio)}</p>
            <div class="hp-footer-socials">
              <a href="${esc(hpFb)}" target="_blank" class="hp-footer-soc-link" title="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
              <a href="${esc(hpZalo)}" target="_blank" class="hp-footer-soc-link" title="Zalo"><svg viewBox="0 0 24 24" style="width:14px;height:14px;fill:currentColor;display:inline-block;vertical-align:middle" xmlns="http://www.w3.org/2000/svg"><path d="M12.49 10.272v-.45h1.347v6.322h-.77a.576.576 0 0 1-.577-.573v.001a3.27 3.27 0 0 1-1.938.632a3.284 3.284 0 0 1-3.284-3.282a3.284 3.284 0 0 1 3.284-3.282a3.27 3.27 0 0 1 1.937.632zM6.919 7.79v.205c0 .382-.051.694-.3 1.06l-.03.034a8 8 0 0 0-.242.285L2.024 14.8h4.895v.768a.576.576 0 0 1-.577.576H0v-.362c0-.443.11-.641.25-.847L4.858 9.23H.192V7.79zm8.551 8.354a.48.48 0 0 1-.48-.48V7.79h1.441v8.354zM20.693 9.6a3.306 3.306 0 1 1 .002 6.612a3.306 3.306 0 0 1-.002-6.612m-10.14 5.253a1.932 1.932 0 1 0 0-3.863a1.932 1.932 0 0 0 0 3.863m10.14-.003a1.945 1.945 0 1 0 0-3.89a1.945 1.945 0 0 0 0 3.89"/></svg></a>
              <a href="${esc(hpYt)}" target="_blank" class="hp-footer-soc-link" title="YouTube"><i class="fa-brands fa-youtube"></i></a>
              <a href="${esc(hpTt)}" target="_blank" class="hp-footer-soc-link" title="TikTok"><i class="fa-brands fa-tiktok"></i></a>
            </div>
          </div>

          <div class="hp-footer-col">
            <div class="hp-footer-title">${hpT('footerQuickLinks', 'Liên kết nhanh')}</div>
            <ul class="hp-footer-links">
              <li><a href="#home" onclick="hpNavTo('home', event)">${hpT('home', 'Trang chủ')}</a></li>
              <li><a href="#about-us" onclick="hpNavToAboutUs(event)">${hpT('about', 'Giới thiệu')}</a></li>
              <li><a href="#full-menu" onclick="hpNavToFullMenu('all', event)">${hpT('viewFullMenu', 'Thực đơn')}</a></li>
              <li><a href="#space" onclick="hpNavTo('space', event)">${hpT('space', 'Không gian')}</a></li>
              <li><a href="#booking" onclick="hpNavTo('booking', event)">${hpT('bookTableBtn', 'Đặt bàn')}</a></li>
              <li><a href="#contact" onclick="hpNavTo('contact', event)">${hpT('contact', 'Liên hệ')}</a></li>
            </ul>
          </div>

          <div class="hp-footer-col">
            <div class="hp-footer-title">${hpT('footerContact', 'Thông tin liên hệ')}</div>
            <ul class="hp-footer-contact-list">
              <li><i class="fa-solid fa-location-dot"></i> <span>${esc(addr)}</span></li>
              <li><i class="fa-solid fa-phone"></i> <span>${esc(phone)}</span></li>
              <li><i class="fa-solid fa-envelope"></i> <span>${esc(email)}</span></li>
              <li><i class="fa-solid fa-clock"></i> <span>${esc(openTime)} – ${esc(closeTime)} (${hpT('footerAllDays', 'Tất cả các ngày')})</span></li>
            </ul>
          </div>

          <div class="hp-footer-col">
            <div class="hp-footer-title">${hpT('footerNewsletter', 'Đăng ký nhận ưu đãi')}</div>
            <p style="font-size:13.5px;color:#8fa096;margin:0 0 12px">${hpT('footerNewsletterSub', 'Nhận thông tin khuyến mãi mới nhất')}</p>
            <form class="hp-footer-sub-form" onsubmit="hpSubscribe(event);return false;">
              <div style="position:relative;flex:1 1 auto;min-width:0">
                <i class="fa-regular fa-envelope" style="position:absolute;left:13px;top:50%;transform:translateY(-50%);color:#88988e;font-size:14px;pointer-events:none"></i>
                <input id="hp-sub-email" type="email" placeholder="${hpT('footerEmailPlaceholder', 'Nhập email của bạn')}" style="padding-left:36px;width:100%" required>
              </div>
              <button id="hp-sub-btn" type="submit" class="hp-footer-sub-btn">${hpT('footerSubscribeBtn', 'Đăng ký')}</button>
            </form>
            <div class="hp-footer-admin-wrap">
              <a href="#login" onclick="hpOpenAdminLogin(event);return false;" class="hp-footer-admin-link" title="${hpT('footerStaffLogin', 'Đăng nhập')}">
                <i class="fa-solid fa-user-shield"></i> <span>${hpT('footerStaffLogin', 'Đăng nhập')}</span>
              </a>
            </div>
          </div>
        </div>

        <div class="hp-footer-bottom">
          <div onclick="if(event.detail===2||event.ctrlKey)openLoginModal()" style="cursor:default" title="">${esc(hpCopy)}</div>
          <div class="hp-footer-bottom-links">
            <a href="#" onclick="alert(hpT('privacyAlert', 'Chính sách bảo mật thông tin khách hàng tuyệt đối.'));return false;">${hpT('footerPrivacy', 'Chính sách bảo mật')}</a>
            <span>|</span>
            <a href="#" onclick="alert(hpT('termsAlert', 'Điều khoản sử dụng dịch vụ.'));return false;">${hpT('footerTerms', 'Điều khoản sử dụng')}</a>
            <span>|</span>
            <a href="#" onclick="alert(hpT('sitemapAlert', 'Sitemap hệ thống website Hương Vị Việt.'));return false;">${hpT('footerSitemap', 'Sitemap')}</a>
          </div>
        </div>
      </div>
    </footer>

    ${loginModalHtml}
    ${editorModalHtml}
  </div>`;
}

PAGES.home = () => homeView(true);

/* ===== Quản lý Đặt bàn trực tuyến & Nội bộ (Staff / Manager / Admin) ===== */
let bookFilterStatus = 'all';
let bookFilterDate = 'all';
let bookSearch = '';

async function refreshBookings(btn) {
  const b = btn || document.getElementById('btn-refresh-book');
  const origHtml = b ? b.innerHTML : '<i class="fa-solid fa-arrows-rotate"></i> Làm mới';
  if (b) {
    b.disabled = true;
    b.style.pointerEvents = 'none';
    b.style.opacity = '0.7';
    b.innerHTML = '<i class="fa-solid fa-arrows-rotate fa-spin"></i> Đang tải...';
  }
  try {
    const t0 = Date.now();
    await pull();
    try {
      const res = await jf('/api/reservations?limit=200', {
        headers: { 'x-token': tok || '' }
      });
      if (res && res.ok && res.j && Array.isArray(res.j.reservations)) {
        if (!S) S = {};
        S.reservations = res.j.reservations;
        if (syncBase) syncBase.reservations = cloneJ(res.j.reservations);
      }
    } catch (_) {}

    const elapsed = Date.now() - t0;
    if (elapsed < 350) {
      await new Promise(r => setTimeout(r, 350 - elapsed));
    }

    render();
    toast('Đã làm mới danh sách đặt bàn thành công!', 'ok');
  } catch (err) {
    console.error('Lỗi khi làm mới đặt bàn:', err);
    toast('Lỗi khi làm mới: ' + (err.message || 'Không kết nối được máy chủ'), 'err');
    if (b) {
      b.disabled = false;
      b.style.pointerEvents = '';
      b.style.opacity = '';
      b.innerHTML = origHtml;
    }
  }
}
window.refreshBookings = refreshBookings;

PAGES.book = () => {
  try {
    const allList = Array.isArray(S.reservations) ? S.reservations : [];
    const todayStr = (() => {
      const d = new Date();
      return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    })();
    const tomStr = (() => {
      const d = new Date();
      d.setDate(d.getDate() + 1);
      return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    })();

  const pendingCount = allList.filter(r => r.status === 'pending').length;
  const confirmedCount = allList.filter(r => r.status === 'confirmed').length;
  const seatedCount = allList.filter(r => r.status === 'seated').length;
  const completedCount = allList.filter(r => r.status === 'completed').length;
  const cancelledCount = allList.filter(r => r.status === 'cancelled').length;
  const todayGuests = allList
    .filter(r => r.date === todayStr && r.status !== 'cancelled')
    .reduce((sum, r) => sum + (Number(r.guests) || 0), 0);

  // Apply filters
  let filtered = [...allList];
  if (bookFilterStatus !== 'all') {
    filtered = filtered.filter(r => r.status === bookFilterStatus);
  }
  if (bookFilterDate === 'today') {
    filtered = filtered.filter(r => r.date === todayStr);
  } else if (bookFilterDate === 'tomorrow') {
    filtered = filtered.filter(r => r.date === tomStr);
  } else if (bookFilterDate === 'upcoming') {
    filtered = filtered.filter(r => r.date >= todayStr && r.status !== 'cancelled');
  }

  if (bookSearch.trim()) {
    const q = bookSearch.trim().toLowerCase();
    filtered = filtered.filter(r =>
      (r.name && r.name.toLowerCase().includes(q)) ||
      (r.phone && r.phone.includes(q)) ||
      (r.id && r.id.toLowerCase().includes(q)) ||
      (r.tableName && r.tableName.toLowerCase().includes(q)) ||
      (r.note && r.note.toLowerCase().includes(q)) ||
      (r.staffNote && r.staffNote.toLowerCase().includes(q))
    );
  }

  const bookPageSize = 5;
  const st = pg('book', filtered.length, bookPageSize);
  const rows = filtered.slice(st, st + bookPageSize);

  return `
    <div class="v2-head">
      <div>
        <h3>Quản lý đặt bàn nhà hàng</h3>
        <div class="v2-sub">Theo dõi, tiếp nhận, xếp bàn và quản lý đặt chỗ trực tuyến & nội bộ</div>
      </div>
      <div style="display:flex;gap:8px;flex-wrap:wrap">
        <button type="button" class="p" onclick="openAddReservationModal()"><i class="fa-solid fa-plus"></i> Thêm đặt bàn</button>
        <button type="button" onclick="exportReservationsCsv()"><i class="fa-solid fa-file-excel"></i> Xuất Excel</button>
        <button type="button" onclick="openSubscribersModal()" title="Xem danh sách email khách đăng ký nhận ưu đãi"><i class="fa-solid fa-envelope-open-text"></i> Khách nhận ưu đãi (${(S.subscribers||[]).length})</button>
        <button type="button" id="btn-refresh-book" onclick="refreshBookings(this)"><i class="fa-solid fa-arrows-rotate"></i> Làm mới</button>
      </div>
    </div>

    <!-- Stats Counters Strip -->
    <div class="row" style="gap:10px;margin-bottom:16px;flex-wrap:wrap">
      <div class="chip2" style="cursor:pointer" onclick="bookFilterStatus='all';PG.book=0;render()">Tất cả: <b>${allList.length}</b></div>
      <div class="chip" style="background:#fff3e0;color:#e65100;font-weight:600;cursor:pointer" onclick="bookFilterStatus='pending';PG.book=0;render()">Chờ xác nhận: <b>${pendingCount}</b></div>
      <div class="chip" style="background:#e8f5e9;color:#2e7d32;font-weight:600;cursor:pointer" onclick="bookFilterStatus='confirmed';PG.book=0;render()">Đã xác nhận: <b>${confirmedCount}</b></div>
      <div class="chip" style="background:#e3f2fd;color:#1565c0;font-weight:600;cursor:pointer" onclick="bookFilterStatus='seated';PG.book=0;render()">Đang phục vụ: <b>${seatedCount}</b></div>
      <div class="chip" style="background:#f3e5f5;color:#6a1b9a;font-weight:600;cursor:pointer" onclick="bookFilterStatus='completed';PG.book=0;render()">Đã hoàn tất: <b>${completedCount}</b></div>
      <div class="chip" style="background:#fbe9e7;color:#c62828;font-weight:600;cursor:pointer" onclick="bookFilterStatus='cancelled';PG.book=0;render()">Đã hủy: <b>${cancelledCount}</b></div>
      <div class="chip" style="background:#e0f2f1;color:#00695c;font-weight:600">Khách dự kiến hôm nay: <b>${todayGuests} khách</b></div>
    </div>

    <!-- Filter & Search Toolbar -->
    <div class="box" style="display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-bottom:14px;padding:12px 14px">
      <!-- Status selector -->
      <div style="display:flex;align-items:center;gap:6px">
        <span class="mut" style="font-size:13px;font-weight:600">Trạng thái:</span>
        <select onchange="bookFilterStatus=this.value;PG.book=0;render()" style="font-size:13.5px;padding:5px 8px">
          <option value="all" ${bookFilterStatus==='all'?'selected':''}>Tất cả trạng thái</option>
          <option value="pending" ${bookFilterStatus==='pending'?'selected':''}>Chờ xác nhận</option>
          <option value="confirmed" ${bookFilterStatus==='confirmed'?'selected':''}>Đã xác nhận</option>
          <option value="seated" ${bookFilterStatus==='seated'?'selected':''}>Đang phục vụ (vào bàn)</option>
          <option value="completed" ${bookFilterStatus==='completed'?'selected':''}>Đã hoàn tất</option>
          <option value="cancelled" ${bookFilterStatus==='cancelled'?'selected':''}>Đã hủy</option>
        </select>
      </div>

      <!-- Date selector -->
      <div style="display:flex;align-items:center;gap:6px">
        <span class="mut" style="font-size:13px;font-weight:600">Ngày đến:</span>
        <select onchange="bookFilterDate=this.value;PG.book=0;render()" style="font-size:13.5px;padding:5px 8px">
          <option value="all" ${bookFilterDate==='all'?'selected':''}>Tất cả ngày</option>
          <option value="today" ${bookFilterDate==='today'?'selected':''}>Hôm nay</option>
          <option value="tomorrow" ${bookFilterDate==='tomorrow'?'selected':''}>Ngày mai</option>
          <option value="upcoming" ${bookFilterDate==='upcoming'?'selected':''}>Sắp tới (chưa phục vụ)</option>
        </select>
      </div>

      <!-- Keyword search -->
      <div style="display:flex;align-items:center;gap:6px;flex:1 1 200px">
        <div style="position:relative;width:100%">
          <i class="fa-solid fa-magnifying-glass" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);color:var(--mut);font-size:12px"></i>
          <input type="text" placeholder="Tìm theo tên, SĐT, mã đặt bàn, bàn..." value="${esc(bookSearch)}" oninput="bookSearch=this.value;PG.book=0;render()" style="width:100%;padding-left:28px;font-size:13.5px">
        </div>
      </div>
      ${(bookFilterStatus !== 'all' || bookFilterDate !== 'all' || bookSearch) ? `
        <button type="button" onclick="bookFilterStatus='all';bookFilterDate='all';bookSearch='';PG.book=0;render()" style="font-size:12.5px;padding:5px 10px"><i class="fa-solid fa-filter-circle-xmark"></i> Xóa lọc</button>
      ` : ''}
    </div>

    <!-- Data Table -->
    <div class="rc" style="padding:0;overflow:hidden">
      <div class="sc">
        <table class="cs-t">
          <thead>
            <tr>
              <th>Khách hàng</th>
              <th>SĐT</th>
              <th>Số khách</th>
              <th>Ngày giờ</th>
              <th>Tiền cọc</th>
              <th>Khu vực / Ghi chú</th>
              <th>Bàn phục vụ</th>
              <th>Trạng thái</th>
              <th>Thời gian tạo</th>
              <th style="text-align:center">Thao tác</th>
            </tr>
          </thead>
          <tbody>
            ${rows.map(r => `
              <tr>
                <td>
                  <b>${esc(r.name)}</b>
                  ${r.source === 'admin' ? '<br><small class="tag" style="font-size:10.5px;color:var(--pri)"><i class="fa-solid fa-user-tie"></i> Nội bộ</small>' : '<br><small class="tag" style="font-size:10.5px"><i class="fa-solid fa-globe"></i> Website</small>'}
                </td>
                <td><a href="tel:${esc(r.phone)}" style="font-weight:700;color:var(--pri);text-decoration:none">${esc(r.phone)}</a></td>
                <td><span class="pill" style="font-size:12px;font-weight:700;display:inline-block;min-width:32px;text-align:center">${r.guests}</span></td>
                <td>
                  <b>${esc(r.time)}</b>
                  <br><small class="${r.date === todayStr ? 'pill' : 'mut'}" style="font-size:11px;padding:1px 6px">${r.date === todayStr ? 'Hôm nay' : dmy(r.date)}</small>
                </td>
                <td>
                  ${r.deposit ? `
                    <b style="color:#2e7d32;font-size:13px">${money(r.deposit)}</b>
                    <br><small class="tag" style="background:#e8f5e9;color:#2e7d32;font-size:10px;padding:1px 5px"><i class="fa-solid fa-check"></i> Đã cọc</small>
                  ` : (() => {
                    const pol = r.depositPolicy || hpGetDepositPolicy(r.guests, r.space, r.date, r.isHoliday);
                    const tagStyle = pol.level === 'none' ? 'background:#f0fdf4;color:#166534' :
                      pol.level === 'flexible' ? 'background:#fefce8;color:#854d0e' :
                      pol.level === 'recommended' ? 'background:#fff7ed;color:#9a3412' :
                      'background:#fef2f2;color:#991b1b';
                    const badgeTxt = pol.badge || pol.label || pol.title || (pol.level === 'none' ? 'Không cần cọc' : 'Có thể yêu cầu cọc');
                    return `<span class="tag" style="${tagStyle};font-size:10.5px;padding:2px 6px" title="${esc(pol.desc || '')}">${esc(badgeTxt)}</span>`;
                  })()}
                </td>
                <td>
                  ${(() => {
                    const spInfo = getTableTypeInfo({ type: r.space });
                    return `<span style="display:inline-flex;align-items:center;gap:4px;font-size:12px;font-weight:600;padding:2px 7px;border-radius:6px;background:${spInfo.bg};color:${spInfo.color};border:1px solid ${spInfo.border};white-space:nowrap"><i class="fa-solid ${spInfo.icon}"></i> ${spInfo.name}</span>`;
                  })()}
                  ${r.note ? `<br><small class="mut" title="${esc(r.note)}"><i class="fa-solid fa-note-sticky"></i> ${esc(r.note.length > 30 ? r.note.slice(0, 30) + '...' : r.note)}</small>` : ''}
                  ${r.staffNote ? `<br><small style="color:#b8863b" title="${esc(r.staffNote)}"><i class="fa-solid fa-comment-dots"></i> ${esc(r.staffNote.length > 30 ? r.staffNote.slice(0, 30) + '...' : r.staffNote)}</small>` : ''}
                </td>
                <td>${r.tableName ? `<span class="pillw" style="font-weight:700">Bàn ${esc(r.tableName)}</span>` : '<span class="mut">Chưa xếp</span>'}</td>
                <td>
                  ${r.status === 'pending' ? '<span class="pillw" style="background:#fff3e0;color:#e65100;font-weight:700">Chờ xác nhận</span>' :
                    r.status === 'confirmed' ? '<span class="pill" style="background:#e8f5e9;color:#2e7d32;font-weight:700">Đã xác nhận</span>' :
                    r.status === 'seated' ? '<span class="pill" style="background:#e3f2fd;color:#1565c0;font-weight:700">Đang phục vụ</span>' :
                    r.status === 'completed' ? '<span class="pill" style="background:#f3e5f5;color:#6a1b9a;font-weight:700">Đã hoàn tất</span>' :
                    '<span class="pillb" style="background:#ffebee;color:#c62828;font-weight:700">Đã hủy</span>'}
                </td>
                <td><small class="mut">${new Date(r.createdAt || r.t || Date.now()).toLocaleTimeString('vi-VN', {hour:'2-digit',minute:'2-digit'})} ${new Date(r.createdAt || r.t || Date.now()).toLocaleDateString('vi-VN')}</small></td>
                <td style="white-space:nowrap;text-align:center">
                  <div style="display:inline-flex;gap:4px">
                    ${r.status === 'pending' ? `
                      <button class="p" onclick="confirmReservation('${r.id}')" title="Xác nhận đặt bàn" style="padding:4px 8px;font-size:12px"><i class="fa-solid fa-check"></i> Xác nhận</button>
                      <button onclick="assignTableModal('${r.id}')" title="Xếp bàn cho khách" style="padding:4px 8px;font-size:12px"><i class="fa-solid fa-chair"></i> Xếp bàn</button>
                    ` : r.status === 'confirmed' ? `
                      <button class="p" onclick="seatReservation('${r.id}')" title="Khách đã đến & vào bàn" style="padding:4px 8px;font-size:12px;background:#1565c0;border-color:#1565c0"><i class="fa-solid fa-person-walking-arrow-right"></i> Vào bàn</button>
                      <button onclick="assignTableModal('${r.id}')" title="Đổi / Xếp bàn" style="padding:4px 8px;font-size:12px"><i class="fa-solid fa-chair"></i> Bàn</button>
                    ` : r.status === 'seated' ? `
                      <button class="p" onclick="completeReservation('${r.id}')" title="Hoàn tất bữa ăn" style="padding:4px 8px;font-size:12px;background:#6a1b9a;border-color:#6a1b9a"><i class="fa-solid fa-check-double"></i> Hoàn tất</button>
                      <button onclick="assignTableModal('${r.id}')" title="Đổi bàn" style="padding:4px 8px;font-size:12px"><i class="fa-solid fa-chair"></i> Đổi bàn</button>
                    ` : ''}

                    <button class="ib" onclick="openEditReservationModal('${r.id}')" title="Chỉnh sửa chi tiết" style="padding:4px 7px"><i class="fa-solid fa-pen-to-square"></i></button>

                    ${r.status !== 'cancelled' && r.status !== 'completed' ? `
                      <button class="ib x" onclick="cancelReservation('${r.id}')" title="Hủy đặt bàn" style="padding:4px 7px"><i class="fa-solid fa-ban"></i></button>
                    ` : ''}

                    ${can('admin', 'manager') ? `
                      <button class="ib x" onclick="deleteReservationAdmin('${r.id}')" title="Xóa đặt bàn" style="padding:4px 7px"><i class="fa-solid fa-trash"></i></button>
                    ` : ''}
                  </div>
                </td>
              </tr>
            `).join('') || `<tr><td colspan="10" class="mut" style="text-align:center;padding:36px">Không tìm thấy đơn đặt bàn nào phù hợp với bộ lọc.</td></tr>`}
          </tbody>
        </table>
      </div>
      ${pgBarF(filtered.length, bookPageSize, PG.book, 'đặt bàn', 'PG.book', 'render()')}
    </div>
  `;
  } catch (err) {
    console.error('Lỗi giao diện Quản lý đặt bàn:', err);
    return `
      <div class="v2-head">
        <div>
          <h3>Quản lý đặt bàn</h3>
          <div class="v2-sub">Đã xảy ra sự cố khi tải trang</div>
        </div>
      </div>
      <div class="box" style="padding:24px;text-align:center">
        <i class="fa-solid fa-triangle-exclamation" style="font-size:36px;color:var(--bad);margin-bottom:12px"></i>
        <h4>Không thể hiển thị danh sách đặt bàn</h4>
        <p class="mut">${esc(err && err.message)}</p>
        <button class="p" onclick="refreshBookings(this)"><i class="fa-solid fa-arrows-rotate"></i> Tải lại trang</button>
      </div>
    `;
  }
};

async function confirmReservation(id) {
  const r = await jf('/api/reservations', {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json', 'x-token': tok || '' },
    body: JSON.stringify({ id, status: 'confirmed' })
  }).catch(() => null);
  if (!r || !r.ok) return alert((r && r.j && r.j.error) || 'Không thể cập nhật đặt bàn.');
  toast('Đã xác nhận đặt bàn ' + id, 'ok');
  await pull();
  render();
}

async function seatReservation(id) {
  const r = (S.reservations || []).find(x => x.id === id);
  if (!r) return;
  if (!r.tableId) {
    if (confirm('Đặt bàn này chưa được xếp bàn. Bạn có muốn xếp bàn ngay trước khi vào bàn?')) {
      assignTableModal(id);
      return;
    }
  }
  const res = await jf('/api/reservations', {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json', 'x-token': tok || '' },
    body: JSON.stringify({ id, status: 'seated' })
  }).catch(() => null);
  if (!res || !res.ok) return alert((res && res.j && res.j.error) || 'Không thể xếp khách vào bàn.');
  toast('Khách đặt bàn ' + id + ' đã vào bàn phục vụ!', 'ok');
  await pull();
  render();
}

async function completeReservation(id) {
  const res = await jf('/api/reservations', {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json', 'x-token': tok || '' },
    body: JSON.stringify({ id, status: 'completed' })
  }).catch(() => null);
  if (!res || !res.ok) return alert((res && res.j && res.j.error) || 'Không thể hoàn tất đặt bàn.');
  toast('Đã hoàn tất đặt bàn ' + id, 'ok');
  await pull();
  render();
}

async function cancelReservation(id) {
  const reason = prompt('Nhập lý do hủy đặt bàn ' + id + ' (hoặc để trống):', 'Khách báo hủy');
  if (reason === null) return;
  const r = await jf('/api/reservations', {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json', 'x-token': tok || '' },
    body: JSON.stringify({ id, status: 'cancelled', cancelReason: reason })
  }).catch(() => null);
  if (!r || !r.ok) return alert((r && r.j && r.j.error) || 'Không thể hủy đặt bàn.');
  toast('Đã hủy đặt bàn ' + id);
  await pull();
  render();
}

async function deleteReservationAdmin(id) {
  if (!confirm('Bạn có chắc chắn muốn xóa vĩnh viễn đặt bàn mã ' + id + '? Thao tác này không thể hoàn tác!')) return;
  const r = await jf('/api/reservations?id=' + id, {
    method: 'DELETE',
    headers: { 'x-token': tok || '' }
  }).catch(() => null);
  if (!r || !r.ok) return alert((r && r.j && r.j.error) || 'Không thể xóa đặt bàn.');
  toast('Đã xóa thành công đặt bàn ' + id, 'ok');
  await pull();
  render();
}

// Modal Thêm đặt bàn thủ công cho Admin / Nhân viên
function updateAdbDepositHint() {
  const g = +$('#adb-guests')?.value || 4;
  const sp = $('#adb-space')?.value || 'Bàn chung';
  const dt = $('#adb-date')?.value || '';
  const hol = !!$('#adb-holiday')?.checked;
  const p = hpGetDepositPolicy(g, sp, dt, hol);
  const t = document.getElementById('adb-hint-title');
  const b = document.getElementById('adb-hint-badge');
  const d = document.getElementById('adb-hint-desc');
  if (t) t.textContent = `${p.title} — ${p.amountFixed}`;
  if (b) {
    b.textContent = p.badge || p.label || (p.level === 'none' ? 'Không cần cọc' : 'Nên yêu cầu cọc');
    b.className = 'tag ' + (p.level === 'none' ? 'ok' : p.level === 'flexible' ? 'warn' : 'err');
  }
  if (d) d.textContent = `${p.desc} (${p.note})`;
}

function openAddReservationModal() {
  const todayStr = (() => {
    const d = new Date();
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  })();
  const tables = (S.tables || []).filter(t => !t.off);

  dlg(`
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;border-bottom:1px solid #ede6dc;padding-bottom:10px">
      <h3 style="margin:0;font-size:18px"><i class="fa-solid fa-calendar-plus" style="color:var(--hp-gold,#b8863b)"></i> Thêm Đặt Bàn Mới (Admin / Gọi điện)</h3>
      <button class="ib x" onclick="dx()"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <form onsubmit="submitAddReservation(event);return false;" style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
      <div>
        <label style="display:block;font-size:13px;font-weight:600;margin-bottom:5px;white-space:nowrap">Họ và tên khách hàng *</label>
        <input id="adb-name" type="text" placeholder="Ví dụ: Anh Nguyễn Văn An" style="width:100%" required>
      </div>
      <div>
        <label style="display:block;font-size:13px;font-weight:600;margin-bottom:5px;white-space:nowrap">Số điện thoại *</label>
        <input id="adb-phone" type="tel" placeholder="Ví dụ: 0912 345 678" style="width:100%" required>
      </div>
      <div>
        <label style="display:block;font-size:13px;font-weight:600;margin-bottom:5px;white-space:nowrap">Ngày đến *</label>
        <input id="adb-date" type="date" value="${todayStr}" onchange="updateAdbDepositHint()" style="width:100%" required>
      </div>
      <div>
        <label style="display:block;font-size:13px;font-weight:600;margin-bottom:5px;white-space:nowrap">Giờ đến *</label>
        <input id="adb-time" type="time" value="18:30" style="width:100%" required>
      </div>
      <div>
        <label style="display:block;font-size:13px;font-weight:600;margin-bottom:5px;white-space:nowrap">Số lượng khách *</label>
        <input id="adb-guests" type="number" min="1" max="200" value="4" oninput="updateAdbDepositHint()" onchange="updateAdbDepositHint()" style="width:100%" required>
      </div>
      <div>
        <label style="display:block;font-size:13px;font-weight:600;margin-bottom:5px;white-space:nowrap">Khu vực ưu tiên</label>
        <select id="adb-space" onchange="updateAdbDepositHint()" style="width:100%">
          <option value="Bàn tiêu chuẩn">Bàn tiêu chuẩn</option>
          <option value="Phòng VIP riêng">Phòng VIP riêng</option>
          <option value="Khu vực ngoài trời">Khu vực ngoài trời</option>
          <option value="Đặt tiệc, sự kiện">Đặt tiệc, sự kiện</option>
        </select>
      </div>
      <div>
        <label style="display:block;font-size:13px;font-weight:600;margin-bottom:5px;white-space:nowrap">Xếp bàn ngay (tùy chọn)</label>
        <select id="adb-table" style="width:100%">
          <option value="">-- Chưa xếp bàn --</option>
          ${tables.map(t => {
            const tInfo = getTableTypeInfo(t);
            return `<option value="${t.id}">Bàn ${esc(t.name)} · [${tInfo.short}] (${t.st === 'busy' ? 'Có khách' : 'Trống'})</option>`;
          }).join('')}
        </select>
      </div>
      <div>
        <label style="display:block;font-size:13px;font-weight:600;margin-bottom:5px;white-space:nowrap">Tiền đặt cọc (VNĐ)</label>
        <input id="adb-deposit" type="number" min="0" step="50000" placeholder="0đ" style="width:100%">
      </div>

      <div style="grid-column:1/-1">
        <label style="display:inline-flex;align-items:center;gap:6px;font-size:13px;cursor:pointer">
          <input type="checkbox" id="adb-holiday" onchange="updateAdbDepositHint()">
          <span><i class="fa-solid fa-gift" style="color:#d97706"></i> Đặt bàn vào dịp Lễ, Tết / Sự kiện đặc biệt (Nên yêu cầu cọc)</span>
        </label>
      </div>

      <!-- Live Deposit Policy Hint -->
      <div id="adb-deposit-hint-box" style="grid-column:1/-1;background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:10px 14px;font-size:12.5px">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
          <span><b>Gợi ý chính sách cọc:</b> <span id="adb-hint-title" style="color:var(--pri)">Nhóm 1 – 4 khách (4 người) — 0đ (Miễn phí cọc)</span></span>
          <span id="adb-hint-badge" class="tag ok" style="white-space:nowrap;flex-shrink:0">Không cần cọc</span>
        </div>
        <div id="adb-hint-desc" style="font-size:11.5px;color:var(--mut);margin-bottom:6px">1-4 khách hoàn toàn miễn phí đặt cọc 100%.</div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
          <small class="mut" style="white-space:nowrap">Điền nhanh mức cọc:</small>
          <button type="button" onclick="$('#adb-deposit').value=0" style="padding:3px 10px;font-size:12px;border-radius:6px">0đ</button>
          <button type="button" onclick="$('#adb-deposit').value=300000" style="padding:3px 10px;font-size:12px;border-radius:6px">300.000đ</button>
          <button type="button" onclick="$('#adb-deposit').value=500000" style="padding:3px 10px;font-size:12px;border-radius:6px">500.000đ</button>
          <button type="button" onclick="$('#adb-deposit').value=1000000" style="padding:3px 10px;font-size:12px;border-radius:6px">1.000.000đ</button>
          <button type="button" onclick="$('#adb-deposit').value=2000000" style="padding:3px 10px;font-size:12px;border-radius:6px">2.000.000đ</button>
        </div>
      </div>

      <div style="grid-column:1/-1">
        <label style="display:block;font-size:13px;font-weight:600;margin-bottom:5px">Trạng thái đặt</label>
        <select id="adb-status" style="width:100%">
          <option value="confirmed" selected>Đã xác nhận</option>
          <option value="pending">Chờ xác nhận</option>
          <option value="seated">Đã vào bàn phục vụ</option>
        </select>
      </div>
      <div style="grid-column:1/-1">
        <label style="display:block;font-size:13px;font-weight:600;margin-bottom:5px">Yêu cầu của khách (Ghi chú)</label>
        <input id="adb-note" type="text" placeholder="Ví dụ: Trang trí hoa sinh nhật, chuẩn bị ghế trẻ em..." style="width:100%">
      </div>
      <div style="grid-column:1/-1">
        <label style="display:block;font-size:13px;font-weight:600;margin-bottom:5px">Ghi chú nội bộ cho nhân viên</label>
        <input id="adb-staffnote" type="text" placeholder="Ví dụ: Khách VIP thân thiết, đã nhận cọc CK 500k qua Vietcombank..." style="width:100%">
      </div>
      <div style="grid-column:1/-1;display:flex;justify-content:flex-end;gap:8px;margin-top:8px">
        <button type="button" onclick="dx()">Hủy</button>
        <button type="submit" class="p"><i class="fa-solid fa-check"></i> Lưu đặt bàn</button>
      </div>
    </form>
  `, 'min(850px, 96vw)');

  const bx = $('#dlg>.box');
  if (bx) {
    bx.style.width = 'min(850px, 96vw)';
    bx.style.maxHeight = '90vh';
    bx.style.overflowY = 'auto';
  }
}

async function submitAddReservation(e) {
  e.preventDefault();
  const name = $('#adb-name').value.trim();
  const phone = $('#adb-phone').value.trim();
  const date = $('#adb-date').value;
  const time = $('#adb-time').value;
  const guests = +$('#adb-guests').value;
  const space = $('#adb-space').value;
  const tableId = $('#adb-table').value ? +$('#adb-table').value : null;
  const deposit = +$('#adb-deposit').value || 0;
  const isHoliday = !!$('#adb-holiday')?.checked;
  const status = $('#adb-status').value;
  const note = $('#adb-note').value.trim();
  const staffNote = $('#adb-staffnote').value.trim();

  const res = await jf('/api/reservations', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'x-token': tok || '' },
    body: JSON.stringify({ name, phone, date, time, guests, space, tableId, deposit, isHoliday, status, note, staffNote, source: 'admin' })
  }).catch(() => null);

  if (!res || !res.ok) return alert((res && res.j && res.j.error) || 'Không thể tạo đặt bàn.');
  dx();
  toast('Đã tạo đặt bàn mới thành công (' + res.j.id + ')!', 'ok');
  await pull();
  render();
}

function updateEdbDepositHint() {
  const g = +$('#edb-guests')?.value || 2;
  const sp = $('#edb-space')?.value || 'Bàn chung';
  const dt = $('#edb-date')?.value || '';
  const hol = !!$('#edb-holiday')?.checked;
  const p = hpGetDepositPolicy(g, sp, dt, hol);
  const t = document.getElementById('edb-hint-title');
  const b = document.getElementById('edb-hint-badge');
  if (t) t.textContent = `${p.title} — ${p.amountFixed} (${p.amountPercent})`;
  if (b) {
    b.textContent = p.badge || p.label || (p.level === 'none' ? 'Không cần cọc' : 'Nên yêu cầu cọc');
    b.className = 'tag ' + (p.level === 'none' ? 'ok' : p.level === 'flexible' ? 'warn' : 'err');
  }
}

// Modal Xem chi tiết & Chỉnh sửa đặt bàn
function openEditReservationModal(id) {
  const r = (S.reservations || []).find(x => x.id === id);
  if (!r) return;
  const tables = (S.tables || []).filter(t => !t.off);
  const pol = r.depositPolicy || hpGetDepositPolicy(r.guests, r.space, r.date, r.isHoliday);
  const badgeText = pol.badge || pol.label || (pol.level === 'none' ? 'Không cần cọc' : pol.level === 'flexible' ? 'Linh hoạt' : 'Nên yêu cầu cọc');
  const amountText = pol.amountFixed || (pol.suggestedAmount ? money(pol.suggestedAmount) : '');

  dlg(`
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;border-bottom:1px solid #ede6dc;padding-bottom:10px">
      <h3 style="margin:0;font-size:18px"><i class="fa-solid fa-pen-to-square" style="color:var(--hp-gold,#b8863b)"></i> Cập Nhật Đặt Bàn Mã ${r.id}</h3>
      <button class="ib x" onclick="dx()"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <form onsubmit="submitEditReservation('${r.id}', event);return false;" style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
      <div>
        <label style="display:block;font-size:13px;font-weight:600;margin-bottom:5px;white-space:nowrap">Họ và tên khách hàng</label>
        <input id="edb-name" type="text" value="${esc(r.name)}" style="width:100%" required>
      </div>
      <div>
        <label style="display:block;font-size:13px;font-weight:600;margin-bottom:5px;white-space:nowrap">Số điện thoại</label>
        <input id="edb-phone" type="tel" value="${esc(r.phone)}" style="width:100%" required>
      </div>
      <div>
        <label style="display:block;font-size:13px;font-weight:600;margin-bottom:5px;white-space:nowrap">Ngày đến</label>
        <input id="edb-date" type="date" value="${esc(r.date)}" onchange="updateEdbDepositHint()" style="width:100%" required>
      </div>
      <div>
        <label style="display:block;font-size:13px;font-weight:600;margin-bottom:5px;white-space:nowrap">Giờ đến</label>
        <input id="edb-time" type="time" value="${esc(r.time)}" style="width:100%" required>
      </div>
      <div>
        <label style="display:block;font-size:13px;font-weight:600;margin-bottom:5px;white-space:nowrap">Số lượng khách</label>
        <input id="edb-guests" type="number" min="1" max="200" value="${r.guests}" oninput="updateEdbDepositHint()" onchange="updateEdbDepositHint()" style="width:100%" required>
      </div>
      <div>
        <label style="display:block;font-size:13px;font-weight:600;margin-bottom:5px;white-space:nowrap">Khu vực</label>
        <select id="edb-space" onchange="updateEdbDepositHint()" style="width:100%">
          <option value="Bàn tiêu chuẩn" ${getTableType({type:r.space})==='standard'?'selected':''}>Bàn tiêu chuẩn</option>
          <option value="Phòng VIP riêng" ${getTableType({type:r.space})==='vip'?'selected':''}>Phòng VIP riêng</option>
          <option value="Khu vực ngoài trời" ${getTableType({type:r.space})==='outdoor'?'selected':''}>Khu vực ngoài trời</option>
          <option value="Đặt tiệc, sự kiện" ${getTableType({type:r.space})==='event'?'selected':''}>Đặt tiệc, sự kiện</option>
        </select>
      </div>
      <div>
        <label style="display:block;font-size:13px;font-weight:600;margin-bottom:5px;white-space:nowrap">Bàn phục vụ</label>
        <select id="edb-table" style="width:100%">
          <option value="">-- Chưa xếp bàn --</option>
          ${tables.map(t => {
            const tInfo = getTableTypeInfo(t);
            return `<option value="${t.id}" ${r.tableId===t.id?'selected':''}>Bàn ${esc(t.name)} · [${tInfo.short}] (${t.st === 'busy' ? 'Có khách' : 'Trống'})</option>`;
          }).join('')}
        </select>
      </div>
      <div>
        <label style="display:block;font-size:13px;font-weight:600;margin-bottom:5px;white-space:nowrap">Tiền đặt cọc (VNĐ)</label>
        <input id="edb-deposit" type="number" min="0" step="50000" value="${r.deposit||0}" style="width:100%">
      </div>

      <div style="grid-column:1/-1">
        <label style="display:inline-flex;align-items:center;gap:6px;font-size:13px;cursor:pointer">
          <input type="checkbox" id="edb-holiday" ${r.isHoliday?'checked':''} onchange="updateEdbDepositHint()">
          <span><i class="fa-solid fa-gift" style="color:#d97706"></i> Đặt bàn dịp Lễ, Tết cao điểm (Nên yêu cầu cọc)</span>
        </label>
      </div>

      <!-- Live Deposit Policy Hint -->
      <div style="grid-column:1/-1;background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:10px 14px;font-size:12.5px">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
          <span><b>Gợi ý chính sách:</b> <span id="edb-hint-title" style="color:var(--pri)">${esc(pol.title || 'Tiêu chuẩn')} — ${esc(amountText)}</span></span>
          <span id="edb-hint-badge" class="tag ${pol.level==='none'?'ok':pol.level==='flexible'?'warn':'err'}">${esc(badgeText)}</span>
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-top:6px">
          <small class="mut">Điền nhanh cọc:</small>
          <button type="button" onclick="$('#edb-deposit').value=0" style="padding:3px 10px;font-size:12px;border-radius:6px">0đ</button>
          <button type="button" onclick="$('#edb-deposit').value=300000" style="padding:3px 10px;font-size:12px;border-radius:6px">300.000đ</button>
          <button type="button" onclick="$('#edb-deposit').value=500000" style="padding:3px 10px;font-size:12px;border-radius:6px">500.000đ</button>
          <button type="button" onclick="$('#edb-deposit').value=1000000" style="padding:3px 10px;font-size:12px;border-radius:6px">1.000.000đ</button>
          <button type="button" onclick="$('#edb-deposit').value=2000000" style="padding:3px 10px;font-size:12px;border-radius:6px">2.000.000đ</button>
        </div>
      </div>

      <div style="grid-column:1/-1">
        <label style="display:block;font-size:13px;font-weight:600;margin-bottom:5px">Trạng thái đặt bàn</label>
        <select id="edb-status" style="width:100%">
          <option value="pending" ${r.status==='pending'?'selected':''}>Chờ xác nhận</option>
          <option value="confirmed" ${r.status==='confirmed'?'selected':''}>Đã xác nhận</option>
          <option value="seated" ${r.status==='seated'?'selected':''}>Đang phục vụ (vào bàn)</option>
          <option value="completed" ${r.status==='completed'?'selected':''}>Đã hoàn tất</option>
          <option value="cancelled" ${r.status==='cancelled'?'selected':''}>Đã hủy</option>
        </select>
      </div>
      <div style="grid-column:1/-1">
        <label style="display:block;font-size:13px;font-weight:600;margin-bottom:5px">Ghi chú của khách</label>
        <input id="edb-note" type="text" value="${esc(r.note||'')}" style="width:100%">
      </div>
      <div style="grid-column:1/-1">
        <label style="display:block;font-size:13px;font-weight:600;margin-bottom:5px">Ghi chú nội bộ</label>
        <input id="edb-staffnote" type="text" value="${esc(r.staffNote||'')}" style="width:100%">
      </div>
      <div style="grid-column:1/-1;display:flex;justify-content:flex-end;gap:8px;margin-top:8px">
        <button type="button" onclick="dx()">Hủy</button>
        <button type="submit" class="p"><i class="fa-solid fa-check"></i> Lưu thay đổi</button>
      </div>
    </form>
  `, 'min(850px, 96vw)');

  const bx = $('#dlg>.box');
  if (bx) {
    bx.style.width = 'min(850px, 96vw)';
    bx.style.maxHeight = '90vh';
    bx.style.overflowY = 'auto';
  }
}

async function submitEditReservation(id, e) {
  e.preventDefault();
  const name = $('#edb-name').value.trim();
  const phone = $('#edb-phone').value.trim();
  const date = $('#edb-date').value;
  const time = $('#edb-time').value;
  const guests = +$('#edb-guests').value;
  const space = $('#edb-space').value;
  const tableId = $('#edb-table').value ? +$('#edb-table').value : null;
  const deposit = +$('#edb-deposit').value || 0;
  const isHoliday = !!$('#edb-holiday')?.checked;
  const status = $('#edb-status').value;
  const note = $('#edb-note').value.trim();
  const staffNote = $('#edb-staffnote').value.trim();

  const res = await jf('/api/reservations', {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json', 'x-token': tok || '' },
    body: JSON.stringify({ id, name, phone, date, time, guests, space, tableId, deposit, isHoliday, status, note, staffNote })
  }).catch(() => null);

  if (!res || !res.ok) return alert((res && res.j && res.j.error) || 'Không thể cập nhật đặt bàn.');
  dx();
  toast('Đã cập nhật đặt bàn ' + id, 'ok');
  await pull();
  render();
}

async function exportReservationsCsv() {
  try {
    const res = await fetch('/api/reservations/export', {
      headers: { 'x-token': tok || '' }
    });
    if (!res.ok) throw new Error('Không thể tải tệp xuất dữ liệu');
    const blob = await res.blob();
    const url = window.URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `Danh_sach_dat_ban_${new Date().toISOString().slice(0, 10)}.csv`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    window.URL.revokeObjectURL(url);
    toast('Đã xuất tệp Excel (CSV) thành công!', 'ok');
  } catch (err) {
    alert(err.message || 'Lỗi xuất tệp');
  }
}

window.assignTabState = window.assignTabState || {};
function setAssignModalTab(id, tab) {
  window.assignTabState[id] = tab;
  assignTableModal(id);
}

function assignTableModal(id) {
  const r = (S.reservations || []).find(x => x.id === id);
  if (!r) return;
  const availTables = (S.tables || []).filter(t => !t.off);
  const reqType = mapSpaceToTableType(r.space);
  const reqInfo = TABLE_TYPES[reqType] || TABLE_TYPES.standard;
  const curTab = window.assignTabState[id] || (reqType || 'all');

  const cntStd = availTables.filter(t => getTableType(t) === 'standard').length;
  const cntVip = availTables.filter(t => getTableType(t) === 'vip').length;
  const cntOut = availTables.filter(t => getTableType(t) === 'outdoor').length;
  const cntEvt = availTables.filter(t => getTableType(t) === 'event').length;
  const cntMatch = availTables.filter(t => getTableType(t) === reqType).length;
  const availMatch = availTables.filter(t => getTableType(t) === reqType && t.st === 'free').length;

  let displayTables = availTables;
  if (curTab === 'match') {
    displayTables = availTables.filter(t => getTableType(t) === reqType);
  } else if (curTab !== 'all') {
    displayTables = availTables.filter(t => getTableType(t) === curTab);
  }

  dlg(`
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;border-bottom:1px solid #ede6dc;padding-bottom:10px">
      <h3 style="margin:0;font-size:18px"><i class="fa-solid fa-chair" style="color:var(--hp-gold,#b8863b)"></i> Xếp bàn cho: ${esc(r.name)} (${r.guests} người)</h3>
      <button class="ib x" onclick="dx()"><i class="fa-solid fa-xmark"></i></button>
    </div>

    <!-- Mapping Logic: Thông báo khu vực khách đặt -->
    <div style="background:${reqInfo.bg};border:1px solid ${reqInfo.border};color:${reqInfo.color};padding:10px 14px;border-radius:10px;margin-bottom:12px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px">
      <div style="display:flex;align-items:center;gap:8px">
        <i class="fa-solid ${reqInfo.icon}" style="font-size:18px"></i>
        <span>Khu vực khách yêu cầu: <b style="font-size:15px">${reqInfo.name}</b> (Ngày ${dmy(r.date)} lúc ${esc(r.time)})</span>
      </div>
      <span style="font-size:12.5px;padding:3px 10px;border-radius:20px;background:#ffffffcc;border:1px solid ${reqInfo.border};font-weight:600">
        ${availMatch > 0 ? `<i class="fa-solid fa-circle-check" style="color:#16a34a"></i> Có ${availMatch} bàn trống phù hợp` : '<i class="fa-solid fa-triangle-exclamation" style="color:#d97706"></i> Hết bàn trống loại này (vui lòng chọn bàn khác)'}
      </span>
    </div>

    <!-- Bộ lọc theo 4 loại bàn -->
    <div style="display:flex;gap:6px;margin-bottom:14px;overflow-x:auto;padding-bottom:2px;flex-wrap:wrap">
      <button type="button" class="tag" style="cursor:pointer;padding:6px 12px;border-radius:8px;font-weight:600;font-size:13px;transition:all .15s;${curTab==='match'?`background:${reqInfo.color};color:#fff;border:1px solid ${reqInfo.color}`:'background:#fff;border:1px solid #cbd5e1;color:#334155'}" onclick="setAssignModalTab('${r.id}','match')">
        <i class="fa-solid fa-star"></i> Phù hợp nhất: ${reqInfo.short} (${cntMatch})
      </button>
      <button type="button" class="tag" style="cursor:pointer;padding:6px 12px;border-radius:8px;font-weight:600;font-size:13px;transition:all .15s;${curTab==='all'?'background:#1e293b;color:#fff;border:1px solid #1e293b':'background:#fff;border:1px solid #cbd5e1;color:#334155'}" onclick="setAssignModalTab('${r.id}','all')">
        <i class="fa-solid fa-border-all"></i> Tất cả (${availTables.length})
      </button>
      <button type="button" class="tag" style="cursor:pointer;padding:6px 12px;border-radius:8px;font-weight:600;font-size:13px;transition:all .15s;${curTab==='standard'?'background:#2563eb;color:#fff;border:1px solid #2563eb':'background:#fff;border:1px solid #cbd5e1;color:#1e40af'}" onclick="setAssignModalTab('${r.id}','standard')">
        <i class="fa-solid fa-chair"></i> Bàn tiêu chuẩn (${cntStd})
      </button>
      <button type="button" class="tag" style="cursor:pointer;padding:6px 12px;border-radius:8px;font-weight:600;font-size:13px;transition:all .15s;${curTab==='vip'?'background:#b45309;color:#fff;border:1px solid #b45309':'background:#fff;border:1px solid #cbd5e1;color:#b45309'}" onclick="setAssignModalTab('${r.id}','vip')">
        <i class="fa-solid fa-crown"></i> Phòng VIP riêng (${cntVip})
      </button>
      <button type="button" class="tag" style="cursor:pointer;padding:6px 12px;border-radius:8px;font-weight:600;font-size:13px;transition:all .15s;${curTab==='outdoor'?'background:#15803d;color:#fff;border:1px solid #15803d':'background:#fff;border:1px solid #cbd5e1;color:#15803d'}" onclick="setAssignModalTab('${r.id}','outdoor')">
        <i class="fa-solid fa-tree"></i> Ngoài trời (${cntOut})
      </button>
      <button type="button" class="tag" style="cursor:pointer;padding:6px 12px;border-radius:8px;font-weight:600;font-size:13px;transition:all .15s;${curTab==='event'?'background:#7e22ce;color:#fff;border:1px solid #7e22ce':'background:#fff;border:1px solid #cbd5e1;color:#7e22ce'}" onclick="setAssignModalTab('${r.id}','event')">
        <i class="fa-solid fa-champagne-glasses"></i> Đặt tiệc, sự kiện (${cntEvt})
      </button>
    </div>

    <!-- Lưới danh sách bàn -->
    <div style="display:grid;grid-template-columns:repeat(auto-fill, minmax(140px, 1fr));gap:12px;margin-bottom:16px">
      ${displayTables.map(t => {
        const tInfo = getTableTypeInfo(t);
        const isMatch = getTableType(t) === reqType;
        const isFree = t.st === 'free';
        const borderStyle = isMatch && isFree ? `2px solid ${reqInfo.color}` : (t.st === 'busy' ? '1px solid #f59e0b' : '1px solid #e2e8f0');
        const bgStyle = isMatch && isFree ? '#fdf8ee' : (t.st === 'busy' ? '#fffbeb' : '#ffffff');
        return `
          <button type="button" class="box" style="text-align:center;padding:12px 8px;cursor:pointer;border-radius:12px;border:${borderStyle};background:${bgStyle};transition:all .15s;position:relative;display:flex;flex-direction:column;align-items:center;gap:4px" onclick="assignTableToRes('${r.id}', ${t.id})">
            ${isMatch ? `<span style="position:absolute;top:-6px;right:6px;font-size:10px;background:${reqInfo.color};color:#fff;padding:1px 6px;border-radius:4px;font-weight:700;display:inline-flex;align-items:center;gap:3px"><i class="fa-solid fa-check"></i> Đúng yêu cầu</span>` : ''}
            <b style="font-size:16px;color:#1e293b;margin-top:2px">Bàn ${esc(t.name)}</b>
            <span title="${esc(tInfo.name)}" style="font-size:12px;padding:3px 8px;border-radius:6px;background:${tInfo.bg};color:${tInfo.color};border:1px solid ${tInfo.border};display:inline-flex;align-items:center;justify-content:center">
              <i class="fa-solid ${tInfo.icon}"></i>
            </span>
            <small class="${t.st === 'busy' ? 'warn' : 'tag ok'}" style="${t.st === 'busy' ? 'color:#b45309;font-weight:600;font-size:12px;display:inline-flex;align-items:center;gap:4px' : 'color:#15803d;font-weight:600;font-size:12px;display:inline-flex;align-items:center;gap:4px'}">
              <i class="fa-solid fa-circle" style="font-size:7px"></i> ${t.st === 'busy' ? 'Đang có khách' : 'Bàn trống'}
            </small>
          </button>
        `;
      }).join('') || '<p class="mut" style="grid-column:1/-1;text-align:center;padding:24px">Không tìm thấy bàn nào phù hợp trong khu vực này.</p>'}
    </div>
  `, 'min(850px, 96vw)');

  const bx = $('#dlg>.box');
  if (bx) {
    bx.style.width = 'min(850px, 96vw)';
    bx.style.maxHeight = '90vh';
    bx.style.overflowY = 'auto';
  }
}

async function assignTableToRes(resId, tableId) {
  dx();
  const res = await jf('/api/reservations', {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json', 'x-token': tok || '' },
    body: JSON.stringify({ id: resId, status: 'seated', tableId })
  }).catch(() => null);
  if (!res || !res.ok) return alert((res && res.j && res.j.error) || 'Không thể xếp bàn.');
  toast('Đã xếp bàn thành công cho đặt bàn ' + resId, 'ok');
  await pull();
  render();
}

// Lắng nghe thông báo khi có khách đặt bàn hoặc đăng ký ưu đãi mới từ trang chủ
{
  const oldDiffNotify = diffNotify;
  window.diffNotify = () => {
    if (me && Array.isArray(S.reservations) && prevS && Array.isArray(prevS.reservations)) {
      const prevIds = new Set(prevS.reservations.map(r => r.id));
      S.reservations.forEach(r => {
        if (!prevIds.has(r.id) && can('admin', 'manager', 'waiter')) {
          toast(`Khách vừa đặt bàn: ${r.name} (${r.guests} người lúc ${r.time} ${dmy(r.date)})`, 'warn', 10000);
          if (typeof playSoundOrder === 'function') playSoundOrder();
        }
      });
    }

    if (me && Array.isArray(S.subscribers) && prevS && Array.isArray(prevS.subscribers)) {
      const prevSubs = new Set(prevS.subscribers.map(s => s.id || s.email));
      S.subscribers.forEach(sub => {
        if (!prevSubs.has(sub.id || sub.email) && can('admin', 'manager')) {
          toast(`Khách vừa đăng ký nhận ưu đãi: ${sub.email}`, 'ok', 10000);
          if (typeof playSoundOrder === 'function') playSoundOrder();
        }
      });
    }

    oldDiffNotify();
  };
}

/* ===== Quên mật khẩu: Khôi phục qua Email hoặc Số điện thoại ===== */
let fpState = { step: 1, identifier: '', username: '', name: '', maskedTarget: '', method: '', otp: '' };

function ensureFpModal() {
  if (document.getElementById('fp-overlay')) return;
  const html = `
    <div id="fp-overlay" class="fp-overlay" onclick="if(event.target===this)closeForgotPasswordModal()">
      <div id="fp-container" class="fp-box"></div>
    </div>
  `;
  document.body.insertAdjacentHTML('beforeend', html);
}

function openForgotPasswordModal() {
  ensureFpModal();
  const curU = ($('#u') && $('#u').value.trim()) || '';
  fpState = { step: 1, identifier: curU, username: '', name: '', maskedTarget: '', method: '', otp: '' };
  renderFpModal();
  const el = $('#fp-overlay');
  if (el) el.classList.add('on');
  setTimeout(() => {
    const inp = $('#fp-identifier');
    if (inp) {
      if (curU) inp.value = curU;
      inp.focus();
    }
  }, 100);
}

function closeForgotPasswordModal() {
  const el = $('#fp-overlay');
  if (el) el.classList.remove('on');
}

function fillFpIdentifier(val) {
  const inp = $('#fp-identifier');
  if (inp) {
    inp.value = val;
    inp.focus();
    const err = $('#fp-err');
    if (err) err.textContent = '';
  }
}

function fillFpOtp(val) {
  const inp = $('#fp-otp');
  if (inp) {
    inp.value = val;
    const np = $('#fp-new-pwd');
    if (np) np.focus();
    const err = $('#fp-err2');
    if (err) err.textContent = '';
  }
}

function toggleFpPwd(id) {
  const inp = document.getElementById(id);
  if (!inp) return;
  const isPwd = inp.type === 'password';
  inp.type = isPwd ? 'text' : 'password';
  const btn = inp.nextElementSibling;
  if (btn) {
    btn.innerHTML = isPwd ? '<i class="fa-solid fa-eye"></i>' : '<i class="fa-solid fa-eye-slash"></i>';
  }
}

function renderFpModal() {
  const cont = $('#fp-container');
  if (!cont) return;
  if (fpState.step === 1) {
    cont.innerHTML = `
      <button type="button" class="fp-close" onclick="closeForgotPasswordModal()" title="Đóng"><i class="fa-solid fa-xmark"></i></button>
      <div class="fp-icon"><i class="fa-solid fa-key"></i></div>
      <h3 class="fp-title">Quên Mật Khẩu</h3>
      <p class="fp-sub">Nhập <b>Email</b>, <b>Số điện thoại</b> hoặc <b>Tên đăng nhập</b> để nhận mã xác thực OTP khôi phục mật khẩu.</p>
      <div class="login-form">
        <div class="login-field">
          <i class="fa-solid fa-address-card lf-ic"></i>
          <input id="fp-identifier" placeholder="Email / Số điện thoại / Tên đăng nhập" value="${esc(fpState.identifier)}" onkeydown="if(event.key==='Enter')submitFpStep1()">
        </div>
        <div id="fp-err" class="err" style="margin-bottom:8px"></div>
        <button type="button" id="fp-btn-submit1" class="p login-btn" onclick="submitFpStep1()">
          <i class="fa-solid fa-paper-plane"></i> Gửi mã xác thực OTP
        </button>
        <div class="login-demo" style="margin-top:16px;padding-top:14px">
          <div class="login-demo-lbl"><i class="fa-solid fa-circle-info"></i> Tài khoản mẫu dùng thử</div>
          <div class="login-demo-chips">
            <button type="button" class="ld-chip" onclick="fillFpIdentifier('admin@gmail.com')"><b>Admin (Email)</b><span>admin@gmail.com</span></button>
            <button type="button" class="ld-chip" onclick="fillFpIdentifier('0327584228')"><b>Admin (SĐT)</b><span>0327584228</span></button>
            <button type="button" class="ld-chip" onclick="fillFpIdentifier('quanly')"><b>Quản lý</b><span>quanly (0912345678)</span></button>
            <button type="button" class="ld-chip" onclick="fillFpIdentifier('phucvu')"><b>Phục vụ</b><span>phucvu (0923456789)</span></button>
          </div>
        </div>
        <div style="text-align:center;margin-top:14px">
          <a href="javascript:void(0)" class="login-forgot" onclick="closeForgotPasswordModal()"><i class="fa-solid fa-arrow-left"></i> Quay lại đăng nhập</a>
        </div>
      </div>
    `;
  } else {
    // Step 2: OTP & New Password
    cont.innerHTML = `
      <button type="button" class="fp-close" onclick="closeForgotPasswordModal()" title="Đóng"><i class="fa-solid fa-xmark"></i></button>
      <div class="fp-icon" style="background:#f0fdf4;color:#16a34a"><i class="fa-solid fa-lock-open"></i></div>
      <h3 class="fp-title">Đặt Lại Mật Khẩu</h3>
      <div class="fp-alert fp-alert-info">
        <i class="fa-solid fa-envelope-circle-check" style="font-size:18px;margin-top:2px"></i>
        <div>
          Mã xác thực đã được gửi tới <b>${esc(fpState.maskedTarget)}</b> cho tài khoản <b>${esc(fpState.username)}</b>. Vui lòng kiểm tra hộp thư hoặc tin nhắn.
        </div>
      </div>
      ${fpState.otp ? `
        <div class="fp-alert fp-alert-demo">
          <i class="fa-solid fa-wand-magic-sparkles" style="font-size:18px;margin-top:2px"></i>
          <div style="flex:1">
            Mã OTP mẫu thử nghiệm: <b style="font-size:16px;letter-spacing:2px">${fpState.otp}</b>
          </div>
          <button type="button" onclick="fillFpOtp('${fpState.otp}')" style="background:#ca8a04;color:#fff;border:0;padding:4px 10px;border-radius:6px;font-size:12px;font-weight:600;cursor:pointer">Điền nhanh</button>
        </div>
      ` : ''}
      <div class="login-form">
        <div class="login-field">
          <i class="fa-solid fa-key lf-ic"></i>
          <input id="fp-otp" placeholder="Nhập mã OTP (6 chữ số)" maxlength="6" value="${esc(fpState.otp)}" style="letter-spacing:4px;font-weight:700;font-size:16px" onkeydown="if(event.key==='Enter')$('#fp-new-pwd').focus()">
        </div>
        <div class="login-field lpw">
          <i class="fa-solid fa-lock lf-ic"></i>
          <input id="fp-new-pwd" type="password" placeholder="Mật khẩu mới (tối thiểu 6 ký tự)" autocomplete="new-password" onkeydown="if(event.key==='Enter')$('#fp-confirm-pwd').focus()">
          <button type="button" class="lpw-eye" onclick="toggleFpPwd('fp-new-pwd')"><i class="fa-solid fa-eye-slash"></i></button>
        </div>
        <div class="login-field lpw">
          <i class="fa-solid fa-circle-check lf-ic"></i>
          <input id="fp-confirm-pwd" type="password" placeholder="Nhập lại mật khẩu mới" autocomplete="new-password" onkeydown="if(event.key==='Enter')submitFpStep2()">
          <button type="button" class="lpw-eye" onclick="toggleFpPwd('fp-confirm-pwd')"><i class="fa-solid fa-eye-slash"></i></button>
        </div>
        <div id="fp-err2" class="err" style="margin-bottom:8px"></div>
        <button type="button" id="fp-btn-submit2" class="p login-btn" onclick="submitFpStep2()">
          <i class="fa-solid fa-check-double"></i> Xác nhận & Đổi mật khẩu
        </button>
        <div class="fp-resend">
          <a href="javascript:void(0)" onclick="resendFpOtp()"><i class="fa-solid fa-rotate-right"></i> Gửi lại mã OTP</a>
          <a href="javascript:void(0)" onclick="fpState.step=1;renderFpModal()"><i class="fa-solid fa-arrow-left"></i> Đổi tài khoản</a>
        </div>
      </div>
    `;
  }
}

async function submitFpStep1() {
  const inp = $('#fp-identifier');
  const err = $('#fp-err');
  const btn = $('#fp-btn-submit1');
  if (!inp || !err) return;
  const val = inp.value.trim();
  if (!val) {
    err.textContent = 'Vui lòng nhập email, số điện thoại hoặc tên đăng nhập.';
    inp.focus();
    return;
  }
  err.textContent = '';
  if (btn) {
    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Đang gửi mã xác thực...';
  }

  try {
    const res = await fetch('/api/auth/forgot-password', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ identifier: val })
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok || !data.success) {
      err.textContent = data.error || 'Không tìm thấy tài khoản. Vui lòng kiểm tra lại.';
      if (btn) {
        btn.disabled = false;
        btn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> Gửi mã xác thực OTP';
      }
      return;
    }

    fpState.step = 2;
    fpState.identifier = val;
    fpState.username = data.username || val;
    fpState.name = data.name || '';
    fpState.maskedTarget = data.maskedTarget || '';
    fpState.method = data.method || '';
    fpState.otp = data.otp || '';

    renderFpModal();
    toast(data.message || 'Đã gửi mã xác thực OTP thành công!', 'ok');
    setTimeout(() => {
      const otpInp = $('#fp-otp');
      if (otpInp) otpInp.focus();
    }, 100);
  } catch (e) {
    err.textContent = 'Lỗi kết nối máy chủ. Vui lòng thử lại sau.';
    if (btn) {
      btn.disabled = false;
      btn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> Gửi mã xác thực OTP';
    }
  }
}

async function resendFpOtp() {
  if (!fpState.identifier && !fpState.username) return;
  toast('Đang gửi lại mã OTP...', 'warn', 2000);
  try {
    const res = await fetch('/api/auth/forgot-password', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ identifier: fpState.username || fpState.identifier })
    });
    const data = await res.json().catch(() => ({}));
    if (res.ok && data.success) {
      fpState.otp = data.otp || '';
      renderFpModal();
      toast('Đã gửi lại mã OTP mới thành công!', 'ok');
    } else {
      toast(data.error || 'Gửi lại mã thất bại.', 'err');
    }
  } catch (_) {
    toast('Lỗi kết nối khi gửi lại mã.', 'err');
  }
}

async function submitFpStep2() {
  const otpInp = $('#fp-otp');
  const pInp = $('#fp-new-pwd');
  const cpInp = $('#fp-confirm-pwd');
  const err = $('#fp-err2');
  const btn = $('#fp-btn-submit2');
  if (!otpInp || !pInp || !cpInp || !err) return;

  const otp = otpInp.value.trim();
  const p = pInp.value;
  const cp = cpInp.value;

  if (!otp || otp.length < 4) {
    err.textContent = 'Vui lòng nhập đầy đủ mã xác thực OTP.';
    otpInp.focus();
    return;
  }
  if (!p || p.length < 6) {
    err.textContent = 'Mật khẩu mới phải có tối thiểu 6 ký tự.';
    pInp.focus();
    return;
  }
  if (p !== cp) {
    err.textContent = 'Mật khẩu xác nhận không khớp.';
    cpInp.focus();
    return;
  }

  err.textContent = '';
  if (btn) {
    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Đang xử lý đổi mật khẩu...';
  }

  try {
    const res = await fetch('/api/auth/reset-password', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        username: fpState.username,
        otp,
        newPassword: p
      })
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok || !data.success) {
      err.textContent = data.error || 'Đặt lại mật khẩu thất bại.';
      if (btn) {
        btn.disabled = false;
        btn.innerHTML = '<i class="fa-solid fa-check-double"></i> Xác nhận & Đổi mật khẩu';
      }
      return;
    }

    closeForgotPasswordModal();
    toast('🎉 Đặt lại mật khẩu thành công! Bạn có thể đăng nhập với mật khẩu mới.', 'ok', 6000);

    // Auto-fill login fields if available
    const uEl = $('#u');
    const pEl = $('#p');
    if (uEl) uEl.value = fpState.username;
    if (pEl) {
      pEl.value = p;
      pEl.focus();
    }
  } catch (e) {
    err.textContent = 'Lỗi kết nối máy chủ. Vui lòng thử lại sau.';
    if (btn) {
      btn.disabled = false;
      btn.innerHTML = '<i class="fa-solid fa-check-double"></i> Xác nhận & Đổi mật khẩu';
    }
  }
}

window.addEventListener('hashchange', () => {
  if (location.hash === '#login' && !me) {
    openLoginModal();
  }
});

window.addEventListener('keydown', e => {
  if (e.key === 'Escape') {
    if (document.getElementById('hp-editor-modal') && document.getElementById('hp-editor-modal').classList.contains('on')) {
      closeHpEditor();
      return;
    }
    if (document.getElementById('fp-overlay') && document.getElementById('fp-overlay').classList.contains('on')) {
      closeForgotPasswordModal();
      return;
    }
    if (loginModalOpen) {
      closeLoginModal();
    }
  }
});
boot();
</script></body></html>
