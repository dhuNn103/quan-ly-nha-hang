function lpwTog(){const i=$('#p'),b=$('.lpw-eye'),show=i.type=='password';i.type=show?'text':'password';b.querySelector('i').className=show?'fa-solid fa-eye':'fa-solid fa-eye-slash';const lbl=show?'Ẩn mật khẩu':'Hiện mật khẩu';b.setAttribute('aria-label',lbl);b.title=lbl}
document.head.insertAdjacentHTML('beforeend',`<style>
