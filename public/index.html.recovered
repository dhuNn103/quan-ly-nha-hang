@media (max-width: 768px) {
  .sub-hide-mobile { display: none !important; }
  .sub-meta-mobile { display: block !important; }
  .sub-col-stt { width: 38px !important; padding: 8px 4px !important; text-align: center !important; }
  .sub-col-email { min-width: 0 !important; width: auto !important; }
  .sub-col-actions { width: 76px !important; padding: 8px 4px !important; text-align: center !important; white-space: nowrap !important; }
  .sub-modal-acts { width: 100% !important; display: flex !important; gap: 8px !important; }
  .sub-modal-acts button { flex: 1 1 0 !important; font-size: 12.5px !important; padding: 8px 6px !important; white-space: nowrap !important; display: inline-flex !important; align-items: center !important; justify-content: center !important; gap: 5px !important; }
}
